@inherits OrganizationHubComponentBase
@inject INavigationMenuService NavigationMenuService
@inject NavigationManager NavigationManager

@if (mCanRenderContent)
{
    @ChildContent
}
else
{
    <div class="hub-route-guard-loading" aria-live="polite">
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
    </div>
}

@code
{
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private string mLastCheckedPath = string.Empty;
    private bool mCanRenderContent;

    protected override async Task OnParametersSetAsync()
    {
        await checkCurrentRouteAsync();
    }

    private async Task checkCurrentRouteAsync()
    {
        Uri currentUri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        string currentPath = currentUri.AbsolutePath;
        if (string.Equals(mLastCheckedPath, currentPath, StringComparison.OrdinalIgnoreCase) && mCanRenderContent)
        {
            return;
        }

        if (string.Equals(currentUri.AbsolutePath, "/access-denied", StringComparison.OrdinalIgnoreCase) || ComponentRouteMatcher.IsKnownPath(NavigationPath.CreateOptional(currentPath)) == false)
        {
            mLastCheckedPath = currentPath;
            mCanRenderContent = true;
            return;
        }

        mCanRenderContent = false;
        bool hasSession = await tryLoadUserSessionAsync();
        if (hasSession == false || CurrentUserSessionOrNull == null)
        {
            mLastCheckedPath = currentPath;
            mCanRenderContent = true;
            return;
        }

        NavigationPath navigationPath = NavigationPath.CreateOptional(currentUri.AbsolutePath);
        bool canAccessPath = await NavigationMenuService.CanAccessPathAsync(CurrentUserSessionOrNull, navigationPath, CancellationToken.None);
        if (canAccessPath)
        {
            mLastCheckedPath = currentPath;
            mCanRenderContent = true;
            return;
        }

        mLastCheckedPath = string.Empty;
        NavigationManager.NavigateTo("/access-denied");
    }
}
