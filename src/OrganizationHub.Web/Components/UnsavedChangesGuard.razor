@inject NavigationManager NavigationManager
@inject IJSRuntime JavaScriptRuntime

<NavigationLock ConfirmExternalNavigation="@HasChanges" OnBeforeInternalNavigation="beforeNavigationAsync" />
@if (mPendingLocationOrNull != null)
{
    <section @ref="mNoticeElement" tabindex="-1" role="alert" class="mb-4">
        <MudAlert Severity="Severity.Warning">
            저장하지 않은 입력이 있습니다. 계속 작성하거나 입력을 버리고 이동해 주세요.
            <div class="hub-form-actions">
                <MudButton OnClick="keepEditing">계속 작성</MudButton>
                <MudButton OnClick="discardAndNavigate" Color="Color.Warning">입력 버리고 이동</MudButton>
            </div>
        </MudAlert>
    </section>
}

@code
{
    [Parameter]
    public bool HasChanges { get; set; }

    [Parameter]
    public string ReturnFocusSelector { get; set; } = string.Empty;

    private string? mPendingLocationOrNull;
    private bool mAllowNavigation;
    private bool mShouldFocusNotice;
    private ElementReference mNoticeElement;
    private Func<Task>? mPendingActionOrNull;
    private bool mShouldRestoreFocus;

    protected override void OnParametersSet()
    {
        if (HasChanges == false)
        {
            mPendingLocationOrNull = null;
            mPendingActionOrNull = null;
            mShouldFocusNotice = false;
            mAllowNavigation = false;
        }
    }

    public async Task RequestChangeAsync(Func<Task> action)
    {
        if (HasChanges == false)
        {
            await action();
            return;
        }
        mPendingActionOrNull = action;
        mPendingLocationOrNull = NavigationManager.Uri;
        mShouldFocusNotice = true;
        await InvokeAsync(StateHasChanged);
    }

    private Task beforeNavigationAsync(LocationChangingContext context)
    {
        if (HasChanges && mAllowNavigation == false)
        {
            context.PreventNavigation();
            mPendingLocationOrNull = context.TargetLocation;
            mShouldFocusNotice = true;
            return InvokeAsync(StateHasChanged);
        }
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (mShouldFocusNotice)
        {
            mShouldFocusNotice = false;
            await mNoticeElement.FocusAsync();
        }
        if (mShouldRestoreFocus)
        {
            mShouldRestoreFocus = false;
            await using (IJSObjectReference module = await JavaScriptRuntime.InvokeAsync<IJSObjectReference>("import", "./js/organizationHubDraftFocus.js"))
            {
                await module.InvokeVoidAsync("focusEditor", ReturnFocusSelector);
            }
        }
    }

    private void keepEditing()
    {
        mPendingLocationOrNull = null;
        mPendingActionOrNull = null;
        mShouldRestoreFocus = true;
    }

    private async Task discardAndNavigate()
    {
        if (mPendingLocationOrNull == null)
        {
            return;
        }
        mAllowNavigation = true;
        if (mPendingActionOrNull != null)
        {
            Func<Task> action = mPendingActionOrNull;
            mPendingActionOrNull = null;
            mPendingLocationOrNull = null;
            await action();
            return;
        }
        NavigationManager.NavigateTo(mPendingLocationOrNull);
    }
}
