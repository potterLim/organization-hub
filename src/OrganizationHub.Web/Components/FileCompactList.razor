<div class="hub-file-compact-list">
    @foreach (DriveFileItem file in Files)
    {
        <div class="hub-file-compact-row">
            <div class="hub-file-compact-main">
                @if (canOpenFolder(file))
                {
                    <button type="button" class="hub-file-inline-name hub-file-folder-link" @onclick="@(() => openFolderAsync(file))" aria-label="@("폴더 열기: " + file.Name)">
                        <MudIcon Icon="@getFileIcon(file)" Size="Size.Small" Class="@getFileIconClass(file)" />
                        <MudText Typo="Typo.body2" Class="hub-list-title hub-file-compact-name">@file.Name</MudText>
                    </button>
                }
                else
                {
                    <div class="hub-file-inline-name">
                        <MudIcon Icon="@getFileIcon(file)" Size="Size.Small" Class="@getFileIconClass(file)" />
                        @renderCompactFileName(file)
                    </div>
                }
                <div class="hub-file-compact-meta">
                    @if (ShouldShowTeam)
                    {
                        <span>@getTeamName(file)</span>
                    }
                    <span>@formatDate(file.ModifiedTime)</span>
                    @if (shouldShowUploader(file))
                    {
                        <span>@getUploaderLabelText() @getUploaderText(file)</span>
                    }
                </div>
            </div>
            <div class="hub-table-actions hub-file-compact-actions">
                @if (file.IsFolder)
                {
                    <MudTooltip Text="폴더 열기">
                        <MudIconButton Icon="@Icons.Material.Filled.FolderOpen" Color="Color.Primary" Size="Size.Small" Disabled="@(FolderOpened.HasDelegate == false)" OnClick="@(() => openFolderAsync(file))" aria-label="폴더 열기" />
                    </MudTooltip>
                }
                else if (ShouldShowPreview && file.CanPreviewInSite)
                {
                    <MudTooltip Text="PDF 보기">
                        <MudIconButton Href="@("/files/" + file.Id + "/viewer")" Icon="@Icons.Material.Filled.Visibility" Color="Color.Primary" Size="Size.Small" aria-label="PDF 보기" />
                    </MudTooltip>
                }
                @if (file.IsFolder == false)
                {
                    <MudTooltip Text="다운로드">
                        <MudIconButton Href="@("/files/" + file.Id + "/download")" Icon="@Icons.Material.Filled.Download" Color="Color.Primary" Size="Size.Small" aria-label="다운로드" />
                    </MudTooltip>
                    @if (CanDelete)
                    {
                        <MudTooltip Text="삭제">
                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small" OnClick="@(() => requestDeleteAsync(file))" aria-label="삭제" />
                        </MudTooltip>
                    }
                }
            </div>
        </div>
    }
</div>

@code
{
    [Parameter]
    public IReadOnlyList<DriveFileItem> Files { get; set; } = new List<DriveFileItem>();

    [Parameter]
    public bool ShouldShowTeam { get; set; } = true;

    [Parameter]
    public bool ShouldShowPreview { get; set; }

    [Parameter]
    public bool ShouldShowUploaderTeamName { get; set; } = true;

    [Parameter]
    public string UploadedByLabel { get; set; } = "업로드";

    [Parameter]
    public TimeZoneInfo ClientTimeZoneInfo { get; set; } = TimeZoneInfo.Local;

    [Parameter]
    public EventCallback<DriveFileItem> FolderOpened { get; set; }

    [Parameter]
    public bool CanDelete { get; set; }

    [Parameter]
    public EventCallback<DriveFileItem> DeleteRequested { get; set; }

    private async Task openFolderAsync(DriveFileItem file)
    {
        if (file.IsFolder == false || FolderOpened.HasDelegate == false)
        {
            return;
        }

        await FolderOpened.InvokeAsync(file);
    }

    private bool canOpenFolder(DriveFileItem file)
    {
        if (file.IsFolder == false)
        {
            return false;
        }

        return FolderOpened.HasDelegate;
    }

    private RenderFragment renderCompactFileName(DriveFileItem file)
    {
        if (canPreviewFile(file))
        {
        return @<MudLink Href="@getViewerHref(file)" Class="hub-list-title hub-file-compact-name hub-file-preview-link">@file.Name</MudLink>;
    }

        return @<MudText Typo="Typo.body2" Class="hub-list-title hub-file-compact-name">@file.Name</MudText>;
    }

    private bool canPreviewFile(DriveFileItem file)
    {
        return file.IsFolder == false && ShouldShowPreview && file.CanPreviewInSite;
    }

    private bool shouldShowUploader(DriveFileItem file)
    {
        if (file.IsFolder)
        {
            return false;
        }

        return string.IsNullOrWhiteSpace(getUploaderText(file)) == false;
    }

    private string getUploaderText(DriveFileItem file)
    {
        if (ShouldShowUploaderTeamName)
        {
            return file.GetUploaderAffiliationText();
        }

        return file.GetUploaderPositionText();
    }

    private string getUploaderLabelText()
    {
        string label = UploadedByLabel.Trim();
        if (label.EndsWith(":", StringComparison.Ordinal))
        {
            return label;
        }

        return label + ":";
    }

    private string getViewerHref(DriveFileItem file)
    {
        return "/files/" + file.Id + "/viewer";
    }

    private async Task requestDeleteAsync(DriveFileItem file)
    {
        if (CanDelete == false || DeleteRequested.HasDelegate == false)
        {
            return;
        }

        await DeleteRequested.InvokeAsync(file);
    }

    private string formatDate(DateTime? dateTimeOrNull)
    {
        if (dateTimeOrNull.HasValue == false)
        {
            return "-";
        }

        return PresentationDateTimeFormatter.formatClientDateTime(dateTimeOrNull.Value, ClientTimeZoneInfo, PresentationDateTimeFormatter.FULL_DATE_TIME_FORMAT);
    }

    private string getFileIcon(DriveFileItem file)
    {
        if (file.IsFolder)
        {
            return Icons.Material.Filled.Folder;
        }

        if (file.MimeType == GoogleMimeTypes.PDF)
        {
            return Icons.Material.Filled.PictureAsPdf;
        }

        return Icons.Material.Filled.InsertDriveFile;
    }

    private string getFileIconClass(DriveFileItem file)
    {
        if (file.IsFolder)
        {
            return "hub-file-icon hub-file-folder-icon";
        }

        return "hub-file-icon";
    }

    private string getTeamName(DriveFileItem file)
    {
        if (string.IsNullOrWhiteSpace(file.TeamName))
        {
            return "분류 없음";
        }

        return file.TeamName;
    }
}
