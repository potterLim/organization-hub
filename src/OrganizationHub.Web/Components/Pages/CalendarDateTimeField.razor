@implements IAsyncDisposable

<div @ref="mRootElement" class="@getRootClass()">
    <button type="button" class="@getButtonClass()" disabled="@IsDisabled" aria-expanded="@IsOpen" @onclick="togglePickerAsync">
        <span class="hub-calendar-date-time-field-label">@Label</span>
        <span class="hub-calendar-date-time-field-value">@getValueText()</span>
        <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small" Class="hub-calendar-date-time-field-icon" />
    </button>
    @if (IsOpen && IsDisabled == false)
    {
        <div class="hub-calendar-date-time-panel" role="dialog" aria-label="@Label">
            <div class="hub-calendar-date-time-panel-header">
                <MudTooltip Text="이전 달">
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" Color="Color.Primary" OnClick="movePreviousMonthAsync" aria-label="이전 달" />
                </MudTooltip>
                <strong>@mVisibleMonth.ToString("yyyy년 M월", KOREAN_CULTURE)</strong>
                <MudTooltip Text="다음 달">
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Color="Color.Primary" OnClick="moveNextMonthAsync" aria-label="다음 달" />
                </MudTooltip>
            </div>
            <div class="hub-calendar-date-time-weekdays" aria-hidden="true">
                @foreach (string weekdayLabel in WEEKDAY_LABELS)
                {
                    <span>@weekdayLabel</span>
                }
            </div>
            <div class="hub-calendar-date-time-days">
                @foreach (CalendarDateTimeDayCell dayCell in mDayCells)
                {
                    <button type="button" class="@getDayButtonClass(dayCell)" data-picker-date="@dayCell.Date.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" aria-label="@dayCell.Date.ToString("yyyy년 M월 d일 dddd", KOREAN_CULTURE)" aria-pressed="@(dayCell.IsSelected ? "true" : "false")" tabindex="@(dayCell.IsSelected ? 0 : -1)" disabled="@dayCell.IsDisabled" @onclick="@(() => selectDateAsync(dayCell.Date))">
                        @dayCell.Date.Day.ToString(CultureInfo.InvariantCulture)
                    </button>
                }
            </div>
            @if (IsTimeSelectionEnabled)
            {
                <div class="hub-calendar-date-time-time-section">
                    <div class="hub-calendar-date-time-time-heading">
                        <span>시간</span>
                        <small>15분 단위</small>
                    </div>
                    <div class="hub-calendar-date-time-parts">
                        <div>
                            <span class="hub-calendar-date-time-part-title">시</span>
                            <div class="hub-calendar-date-time-hours" data-picker-time-group>
                                @foreach (int hour in HOUR_SLOTS)
                                {
                                    <button type="button" class="@getHourButtonClass(hour)" aria-label="@(hour.ToString(CultureInfo.InvariantCulture) + "시")" aria-pressed="@(createSelectionPolicy().getSelectedHour() == hour ? "true" : "false")" tabindex="@(createSelectionPolicy().getSelectedHour() == hour ? 0 : -1)" disabled="@isHourDisabled(hour)" @onclick="@(() => selectHourAsync(hour))">
                                        @formatTimePart(hour)
                                    </button>
                                }
                            </div>
                        </div>
                        <div>
                            <span class="hub-calendar-date-time-part-title">분</span>
                            <div class="hub-calendar-date-time-minutes" data-picker-time-group>
                                @foreach (int minute in MINUTE_SLOTS)
                                {
                                    <button type="button" class="@getMinuteButtonClass(minute)" aria-label="@(minute.ToString(CultureInfo.InvariantCulture) + "분")" aria-pressed="@(createSelectionPolicy().getSelectedMinute() == minute ? "true" : "false")" tabindex="@(createSelectionPolicy().getSelectedMinute() == minute ? 0 : -1)" disabled="@isMinuteDisabled(minute)" @onclick="@(() => selectMinuteAsync(minute))">
                                        @formatTimePart(minute)
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="hub-calendar-date-time-date-only-note">종일 일정은 날짜만 선택합니다.</div>
            }
            <div class="@getPanelActionsClass()">
                @if (CanClearValue)
                {
                    <button type="button" class="hub-calendar-date-time-clear-button" @onclick="clearValueAsync">@ClearValueText</button>
                }
                <button type="button" class="hub-calendar-date-time-close-button" @onclick="closePickerAsync">완료</button>
            </div>
        </div>
    }
</div>
