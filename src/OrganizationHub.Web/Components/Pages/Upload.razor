@page "/upload"
@attribute [Authorize]
@inherits TimeZoneAwareOrganizationHubComponentBase
@inject IPermissionService PermissionService
@inject IDriveBrowserService DriveBrowserService
@inject IDriveService DriveService
@inject IDriveFileNameConflictService DriveFileNameConflictService
@inject IFilePolicyService FilePolicyService
@inject IUploadAuditLogService UploadAuditLogService
@inject Microsoft.Extensions.Logging.ILogger<Upload> Logger

<PageTitle>@OrganizationHubProduct.FormatPageTitle("파일 올리기")</PageTitle>

<h1 class="hub-sr-only">파일 올리기</h1>

<MudGrid Spacing="5" Class="hub-upload-grid">
    <MudItem xs="12" md="7">
        <MudPaper Class="hub-card hub-upload-primary-card pa-4">
            <MudText Typo="Typo.h6">올릴 위치</MudText>
            @if (mIsLoadingFolders)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
            }
            else if (mUploadRootFolders.Count == 0)
            {
                <ResourceStateMessage Icon="@Icons.Material.Filled.FolderOff" Title="파일을 올릴 수 있는 위치가 없습니다." />
            }
            else
            {
                <div class="hub-browser-toolbar hub-browser-toolbar-upload">
                    <MudSelect T="string" Label="자료 위치" Value="mSelectedRootFolderId" ValueChanged="handleRootFolderChangedAsync" Variant="Variant.Outlined" Margin="Margin.Dense" Class="hub-browser-root-select">
                        @foreach (DriveFolderReference folder in mUploadRootFolders)
                        {
                            <MudSelectItem T="string" Value="@folder.FolderId.GetRequiredValue()">@folder.DisplayName</MudSelectItem>
                        }
                    </MudSelect>
                    <div class="hub-browser-count">@getFolderCountText()</div>
                    <MudTooltip Text="현재 위치 새로고침">
                        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Primary" Size="Size.Small" OnClick="loadFoldersAsync" Disabled="mIsLoadingFiles" aria-label="현재 위치 새로고침" />
                    </MudTooltip>
                    @if (mCurrentFolderCreateDecision.IsAllowed)
                    {
                        <div class="hub-browser-folder-action">
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.CreateNewFolder" OnClick="toggleFolderCreate" Class="hub-folder-create-toggle">새 폴더</MudButton>
                        </div>
                    }
                </div>
                @if (string.IsNullOrWhiteSpace(mFolderMessage) == false)
                {
                    <MudAlert Severity="@mFolderMessageSeverity" Dense="true" Class="hub-browser-inline-alert">@mFolderMessage</MudAlert>
                }
                @if (shouldShowFolderPath())
                {
                    <div class="hub-browser-location">
                        <div class="hub-browser-breadcrumbs" aria-label="현재 폴더 위치">
                            @for (int index = 0; index < mFolderPath.Count; index++)
                            {
                                int pathIndex = index;
                                DriveFolderPathItem pathItem = mFolderPath[index];
                                @if (index > 0)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Class="hub-browser-breadcrumb-separator" />
                                }
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Disabled="@(index == mFolderPath.Count - 1)" OnClick="@(() => navigateToPathAsync(pathIndex))">@pathItem.Name</MudButton>
                            }
                        </div>
                    </div>
                }
                @if (mIsFolderCreateOpen)
                {
                    <div class="hub-folder-create-panel" role="group" aria-label="새 폴더">
                        <div class="hub-folder-create-head">
                            <span class="hub-folder-create-icon">
                                <MudIcon Icon="@Icons.Material.Filled.CreateNewFolder" Size="Size.Small" />
                            </span>
                            <div>
                                <strong>새 폴더</strong>
                                <span>현재 위치에 새 폴더를 만듭니다.</span>
                            </div>
                            <MudTooltip Text="닫기">
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Default" OnClick="closeFolderCreate" aria-label="새 폴더 닫기" />
                            </MudTooltip>
                        </div>
                        <MudTextField @bind-Value="mNewFolderName"
                                      Label="폴더 이름"
                                      Placeholder="예: 6월 정산 자료"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      OnKeyDown="handleFolderCreateKeyDownAsync"
                                      Class="hub-folder-create-input" />
                        <div class="hub-folder-create-actions">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="@mIsCreatingFolder" OnClick="createFolderAsync">만들기</MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small" OnClick="closeFolderCreate">취소</MudButton>
                        </div>
                    </div>
                }
                @if (mIsLoadingFiles)
                {
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                }
                else if (string.IsNullOrWhiteSpace(mFolderLoadErrorMessage) == false)
                {
                    <ResourceStateMessage Icon="@Icons.Material.Filled.SyncProblem" Title="@mFolderLoadErrorMessage" ActionLabel="다시 시도" Action="loadFoldersAsync" />
                }
                else if (mCurrentFolderUploadDecision.IsAllowed == false)
                {
                    <ResourceStateMessage Icon="@Icons.Material.Filled.Lock" Title="@mCurrentFolderUploadDecision.Reason" />
                }
                else if (mFoldersInCurrentFolder.Count == 0 && mFilesInCurrentFolder.Count == 0)
                {
                    <ResourceStateMessage Icon="@Icons.Material.Filled.FolderOpen"
                                          Title="현재 위치에 항목이 없습니다."
                                          Description="현재 위치에 바로 올릴 수 있습니다." />
                }
                else
                {
                    <div class="hub-location-contents">
                        @if (mFoldersInCurrentFolder.Count > 0)
                        {
                            <section class="hub-location-section">
                                <div class="hub-location-section-heading">하위 폴더</div>
                                <div class="hub-folder-tile-list">
                                    @foreach (DriveFileItem folder in mFoldersInCurrentFolder)
                                    {
                                        <button type="button" class="hub-folder-tile" @onclick="@(() => openFolderAsync(folder))">
                                            <span class="hub-folder-tile-icon">
                                                <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" />
                                            </span>
                                            <span class="hub-folder-tile-content">
                                                <strong>@folder.Name</strong>
                                                <small>폴더 열기</small>
                                            </span>
                                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Class="hub-folder-tile-arrow" />
                                        </button>
                                    }
                                </div>
                            </section>
                        }
                        @if (mFilesInCurrentFolder.Count > 0)
                        {
                            <section class="hub-location-section">
                                <div class="hub-location-section-heading">현재 위치의 파일</div>
                                <div class="hub-location-file-list">
                                    @foreach (DriveFileItem file in mFilesInCurrentFolder)
                                    {
                                        <div class="hub-location-file-card">
                                            <span class="hub-location-file-icon">
                                                <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Size="Size.Small" />
                                            </span>
                                            <span class="hub-location-file-content">
                                                <strong>@file.Name</strong>
                                                <small>@formatOptionalDate(file.ModifiedTime)</small>
                                            </span>
                                        </div>
                                    }
                                </div>
                            </section>
                        }
                    </div>
                }
            }
        </MudPaper>
        <MudPaper Class="hub-card hub-upload-primary-card pa-4 mt-4">
            <MudText Typo="Typo.h6">파일</MudText>
            @if (mUploadRootFolders.Count == 0)
            {
                <ResourceStateMessage Icon="@Icons.Material.Filled.FolderOff" Title="파일을 올릴 수 있는 위치가 없습니다." />
            }
            else if (mCurrentFolderUploadDecision.IsAllowed == false)
            {
                <ResourceStateMessage Icon="@Icons.Material.Filled.Lock" Title="@mCurrentFolderUploadDecision.Reason" />
            }
            else
            {
                <div class="hub-file-picker">
                    <div class="hub-file-picker-icon">
                        <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Large" />
                    </div>
                    <div class="hub-file-picker-state">@getSelectedFileText()</div>
                    <div class="hub-upload-policy hub-muted">@getUploadPolicyText()</div>
                    <div class="hub-file-picker-actions">
                        <label class="hub-file-picker-control">
                            <InputFile OnChange="handleFileSelected" class="hub-file-input-native" />
                            <MudIcon Icon="@Icons.Material.Filled.AttachFile" Size="Size.Small" />
                            <span>파일 선택</span>
                        </label>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.UploadFile" Disabled="@(mIsUploading || mSelectedFileOrNull == null)" OnClick="uploadFileAsync" Class="hub-primary-action-button hub-upload-button">파일 올리기</MudButton>
                    </div>
                </div>
                @if (mUploadConflictOrNull != null && mUploadConflictOrNull.HasConflict)
                {
                    <div class="hub-file-conflict-panel">
                        <div class="hub-file-conflict-copy">
                            <span class="hub-file-conflict-icon">
                                <MudIcon Icon="@Icons.Material.Filled.ReportProblem" Size="Size.Small" />
                            </span>
                            <div>
                                <strong>@getUploadConflictTitle()</strong>
                                <span>새 파일로 추가할 이름: @getUploadSuggestedFileName()</span>
                                @if (mUploadConflictOrNull.CanReplaceExistingFile == false)
                                {
                                    <span>같은 이름의 파일이 여러 개여서 교체할 수 없습니다. 새 파일로 추가하거나 자료실에서 기존 파일을 정리해 주세요.</span>
                                }
                            </div>
                        </div>
                        <div class="hub-file-conflict-actions">
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Disabled="@(!mUploadConflictOrNull.CanReplaceExistingFile)" OnClick="@(() => uploadFileWithConflictResolutionAsync(EDriveFileNameConflictResolution.ReplaceExistingFile))">기존 파일 교체</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="@(() => uploadFileWithConflictResolutionAsync(EDriveFileNameConflictResolution.AddNewFile))">새 파일로 추가</MudButton>
                        </div>
                    </div>
                }
            }
            @if (string.IsNullOrWhiteSpace(mMessage) == false)
            {
                <MudAlert Severity="@mMessageSeverity" Class="mt-4">@mMessage</MudAlert>
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="5">
        <MudStack Spacing="4">
            <MudPaper Class="hub-card pa-4">
                <MudText Typo="Typo.h6">@getRecentUploadsTitle()</MudText>
                @if (mIsLoadingRecentUploads)
                {
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                }
                else if (string.IsNullOrWhiteSpace(mRecentUploadsErrorMessage) == false)
                {
                    <ResourceStateMessage Icon="@Icons.Material.Filled.SyncProblem" Title="@mRecentUploadsErrorMessage" ActionLabel="다시 시도" Action="loadRecentUploadsAsync" />
                }
                else if (mRecentUploads.Count == 0)
                {
                    <ResourceStateMessage Icon="@Icons.Material.Filled.CloudOff" Title="최근 업로드가 없습니다." />
                }
                else
                {
                    <div class="hub-upload-log-list">
                        @foreach (UploadAuditLogItem auditLog in mRecentUploads)
                        {
                            string recentUploadLocationText = getRecentUploadLocationText(auditLog);
                            <div class="hub-upload-log-row">
                                <div class="hub-upload-log-content">
                                    <MudText Typo="Typo.body2" Class="hub-list-title hub-file-compact-name">@auditLog.FileName</MudText>
                                    <div class="hub-upload-log-meta-row">
                                        <span class="hub-list-meta">@recentUploadLocationText</span>
                                        <span class="hub-list-meta hub-uploaded-by">업로드: @auditLog.GetUploaderAffiliationText()</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </MudPaper>
        </MudStack>
    </MudItem>
</MudGrid>
