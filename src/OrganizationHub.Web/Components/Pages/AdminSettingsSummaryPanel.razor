<MudPaper Class="hub-card hub-list-card pa-4">
    <div class="hub-admin-section-heading">
        <div>
            <MudText Typo="Typo.h6">리소스 위치 설정</MudText>
        </div>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => RefreshRequested.InvokeAsync())" StartIcon="@Icons.Material.Filled.Refresh" Disabled="IsRefreshing">새로고침</MudButton>
    </div>
    <details class="mb-3">
        <summary>연결 설정 도움말</summary>
        <MudText Typo="Typo.body2" Class="hub-muted mt-2">자료를 보관할 기본 폴더를 선택해 주세요. 일정과 할 일은 사용하는 업무에 맞춰 따로 연결할 수 있습니다.</MudText>
    </details>
    <div class="hub-resource-summary-grid">
        @foreach (SettingResourceSummary summary in ResourceSummaries)
        {
            <div class="hub-resource-summary-card">
                <div class="hub-resource-summary-heading">
                    <span>@summary.GroupName</span>
                    <span class="@(summary.IsConfigured ? "hub-status-pill hub-status-active" : "hub-status-pill hub-status-pending")">@(summary.IsConfigured ? "위치 지정됨" : "미설정")</span>
                </div>
                <div class="hub-resource-summary-title">@summary.DisplayName</div>
                <div class="hub-muted">@summary.Detail</div>
            </div>
        }
    </div>
</MudPaper>

@code {
    [Parameter]
    public IReadOnlyList<SettingResourceSummary> ResourceSummaries
    {
        get; set;
    } = new List<SettingResourceSummary>();

    [Parameter]
    public bool IsRefreshing
    {
        get; set;
    }

    [Parameter]
    public EventCallback RefreshRequested
    {
        get; set;
    }
}
