<MudPaper Class="hub-card hub-form-card pa-4">
    <div class="hub-admin-form-heading">
        <MudText Typo="Typo.h6">연결 상태</MudText>
        <span>@(Status.IsConnected ? "설정 가능" : "연결 필요")</span>
    </div>
    @if (Status.IsConnected == false)
    {
        <MudText Typo="Typo.body2" Class="hub-muted mt-3">자료·일정·할 일을 사용하려면 먼저 조직의 Google 계정을 연결해 주세요.</MudText>
        <AuthorizeView Policy="@OrganizationHubPolicies.GOOGLE_CONNECTION_MANAGE">
            <Authorized><MudButton Href="/admin/google" Variant="Variant.Outlined" Color="Color.Primary" Class="mt-3">Google 연결 설정</MudButton></Authorized>
            <NotAuthorized><MudText Typo="Typo.body2" Class="hub-muted mt-3">Google 연결 권한이 있는 관리자에게 요청해 주세요.</MudText></NotAuthorized>
        </AuthorizeView>
    }
    <div class="hub-google-status">
        <span class="@(Status.IsConnected ? "hub-status-pill hub-status-active" : "hub-status-pill hub-status-inactive")">@(Status.IsConnected ? "연결됨" : "미연결")</span>
        <div>
            <div class="hub-google-status-title">@getConnectionTitle()</div>
        </div>
    </div>
    @if (shouldShowConnectedEmail())
    {
        <MudExpansionPanels Elevation="0" Class="hub-advanced-settings hub-google-advanced-settings">
            <MudExpansionPanel Text="자세히">
                <div class="hub-google-callback">
                    <div class="hub-google-callback-label">연결 계정</div>
                    <code>@Status.ConnectedEmail</code>
                </div>
            </MudExpansionPanel>
        </MudExpansionPanels>
    }
</MudPaper>

@code {
    [Parameter]
    public GoogleConnectionStatus Status
    {
        get; set;
    } = new GoogleConnectionStatus();

    private string getConnectionTitle()
    {
        if (Status.IsConnected)
        {
            return "Google 계정 연결됨";
        }

        return "Google 계정 없음";
    }

    private bool shouldShowConnectedEmail()
    {
        return Status.IsConnected && string.IsNullOrWhiteSpace(Status.ConnectedEmail) == false;
    }
}
