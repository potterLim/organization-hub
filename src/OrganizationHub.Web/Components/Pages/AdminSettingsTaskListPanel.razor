<MudPaper Class="hub-card hub-list-card pa-4">
    <div class="hub-google-panel-heading">
        <div>
            <MudText Typo="Typo.h6">Google Tasks 목록 선택</MudText>
            <div class="hub-muted">할 일 화면에서 사용할 Google Tasks 목록을 연결합니다.</div>
        </div>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => Actions.RefreshRequested.InvokeAsync())" StartIcon="@Icons.Material.Filled.Refresh" Disabled="@(State.Status.IsConnected == false)">새로고침</MudButton>
    </div>
    @if (State.Status.IsConnected == false)
    {
        <div class="hub-empty">Google 계정을 연결하면 Google Tasks 목록을 선택할 수 있습니다.</div>
    }
    else
    {
        <div class="hub-google-toolbar">
            <MudSelect T="string" Label="Google Tasks 목록을 연결할 대상" Value="State.SelectedTaskListTargetKey.GetSelectionValue()" ValueChanged="handleTaskListTargetSelectionChangedAsync" Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (GoogleTaskListAssignmentOption option in State.TaskListAssignmentOptions)
                {
                    <MudSelectItem T="string" Value="@option.TargetSelectionValue">@option.DisplayName</MudSelectItem>
                }
            </MudSelect>
            <div class="hub-selected-resource">
                <div class="hub-muted">현재 연결</div>
                <strong>@State.SelectedTaskListAssignmentDisplayName</strong>
                <span>@State.SelectedTaskListAssignmentDetail</span>
            </div>
        </div>
        <div class="hub-resource-card-list">
            @foreach (GoogleTaskListItem taskList in State.TaskLists)
            {
                <div class="hub-resource-choice-card">
                    <div>
                        <div class="hub-resource-choice-title">@taskList.Title</div>
                        <div class="hub-muted">Google Tasks</div>
                    </div>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => Actions.AssignTaskListRequested.InvokeAsync(taskList))" StartIcon="@Icons.Material.Filled.CheckCircle">연결</MudButton>
                </div>
            }
        </div>
    }
</MudPaper>

@code {
    [Parameter]
    public AdminSettingsTaskListPanelState State
    {
        get; set;
    } = new AdminSettingsTaskListPanelState();

    [Parameter]
    public AdminSettingsTaskListPanelActions Actions
    {
        get; set;
    } = new AdminSettingsTaskListPanelActions();

    private async Task handleTaskListTargetSelectionChangedAsync(string targetSelectionValue)
    {
        GoogleWorkspaceAssignmentTargetKey targetKey = GoogleWorkspaceAssignmentTargetKey.FromSelectionValue(targetSelectionValue);
        await Actions.SelectedTaskListTargetKeyChanged.InvokeAsync(targetKey);
    }
}
