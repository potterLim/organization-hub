<MudPaper Class="hub-card hub-list-card pa-4">
    <div class="hub-google-panel-heading">
        <div>
            <MudText Typo="Typo.h6">Calendar 선택</MudText>
            <div class="hub-muted">일정을 표시하거나 작성할 Calendar를 목록에서 연결합니다.</div>
        </div>
    </div>
    @if (State.Status.IsConnected == false)
    {
        <div class="hub-empty">Google 계정을 연결하면 Calendar 목록을 선택할 수 있습니다.</div>
    }
    else
    {
        <div class="hub-google-toolbar">
            <MudSelect T="string" Label="연결할 화면" Value="State.SelectedCalendarTargetKey.GetSelectionValue()" ValueChanged="handleCalendarTargetSelectionChangedAsync" Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (GoogleCalendarAssignmentOption option in State.CalendarAssignmentOptions)
                {
                    <MudSelectItem T="string" Value="@option.TargetSelectionValue">@option.DisplayName</MudSelectItem>
                }
            </MudSelect>
            <div class="hub-selected-resource">
                <div class="hub-muted">현재 연결</div>
                <strong>@State.SelectedCalendarAssignmentDisplayName</strong>
                <span>@State.SelectedCalendarAssignmentDetail</span>
            </div>
        </div>
        <div class="hub-resource-picker-shell">
            <div class="hub-resource-picker-header">
                <div>
                    <strong>Calendar 목록</strong>
                    <span>필요할 때 목록을 열어 연결할 Calendar를 선택합니다.</span>
                </div>
                <div class="hub-resource-picker-actions">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="toggleCalendarPicker" StartIcon="@(mIsCalendarPickerVisible ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)">@(mIsCalendarPickerVisible ? "목록 닫기" : "Calendar 선택")</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => Actions.RefreshRequested.InvokeAsync())" StartIcon="@Icons.Material.Filled.Refresh">새로고침</MudButton>
                </div>
            </div>
            @if (mIsCalendarPickerVisible)
            {
                <div class="hub-resource-card-list">
                    @foreach (GoogleCalendarListItem calendar in State.Calendars)
                    {
                        <div class="hub-resource-choice-card">
                            <div>
                                <div class="hub-resource-choice-title">@calendar.Summary</div>
                                <div class="hub-muted">@State.GetCalendarAccessDisplayName(calendar)</div>
                            </div>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => Actions.AssignCalendarRequested.InvokeAsync(calendar))" StartIcon="@Icons.Material.Filled.CheckCircle">연결</MudButton>
                        </div>
                    }
                </div>
            }
        </div>
    }
</MudPaper>

@code {
    [Parameter]
    public AdminSettingsCalendarPanelState State
    {
        get; set;
    } = new AdminSettingsCalendarPanelState();

    [Parameter]
    public AdminSettingsCalendarPanelActions Actions
    {
        get; set;
    } = new AdminSettingsCalendarPanelActions();

    private bool mIsCalendarPickerVisible;

    private async Task handleCalendarTargetSelectionChangedAsync(string targetSelectionValue)
    {
        GoogleWorkspaceAssignmentTargetKey targetKey = GoogleWorkspaceAssignmentTargetKey.FromSelectionValue(targetSelectionValue);
        await Actions.SelectedCalendarTargetKeyChanged.InvokeAsync(targetKey);
    }

    private void toggleCalendarPicker()
    {
        mIsCalendarPickerVisible = mIsCalendarPickerVisible == false;
    }
}
