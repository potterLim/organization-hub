@using OrganizationHub.Web.Domain

<MudPaper Class="hub-card hub-form-card pa-4">
    <div class="hub-google-health-heading">
        <div>
            <MudText Typo="Typo.h6">연결 점검</MudText>
        </div>
        <MudTooltip Text="점검 새로고침">
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Primary" Size="Size.Small" OnClick="@(() => RefreshRequested.InvokeAsync())" aria-label="점검 새로고침" />
        </MudTooltip>
    </div>
    @if (Items.Count == 0)
    {
        <div class="hub-empty">표시할 연결 점검 항목이 없습니다.</div>
    }
    else
    {
        IReadOnlyList<GoogleHealthCheckItem> attentionHealthItems = getAttentionHealthItems();
        IReadOnlyList<GoogleHealthCheckItem> healthyHealthItems = getHealthyHealthItems();
        GoogleHealthSummaryCounts healthSummaryCounts = new GoogleHealthSummaryCounts
        {
            AttentionCount = attentionHealthItems.Count,
            HealthyCount = healthyHealthItems.Count
        };
        <div class="hub-health-list">
            <div class="hub-health-summary">
                <span class="@("hub-health-summary-pill " + getHealthSummaryClass())">@getHealthSummaryText()</span>
                <span>@getHealthSummaryDescription(healthSummaryCounts)</span>
            </div>
            @if (attentionHealthItems.Count == 0)
            {
                <div class="hub-health-row hub-health-row-muted">
                    <div class="hub-health-copy">
                        <div class="hub-health-area">연결 점검</div>
                        <div class="hub-health-name">확인 필요 없음</div>
                    </div>
                    <span class="hub-health-pill hub-health-healthy">정상</span>
                </div>
            }
            @foreach (GoogleHealthCheckItem item in attentionHealthItems)
            {
                <div class="hub-health-row">
                    <div class="hub-health-copy">
                        <div class="hub-health-area">@item.Area</div>
                        <div class="hub-health-name">@item.Name</div>
                        <div class="hub-muted">@item.Message</div>
                    </div>
                    <span class="@("hub-health-pill " + getHealthClass(item.Status))">@getHealthText(item.Status)</span>
                </div>
            }
            @if (healthyHealthItems.Count > 0)
            {
                <button type="button" class="hub-health-toggle" @onclick="@(() => ToggleHealthyItemsRequested.InvokeAsync())">
                    <span>정상 항목 보기 @(healthyHealthItems.Count)개</span>
                    <MudIcon Icon="@(ShouldShowHealthyItems ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small" />
                </button>
                @if (ShouldShowHealthyItems)
                {
                    @foreach (GoogleHealthCheckItem item in healthyHealthItems)
                    {
                        <div class="hub-health-row hub-health-row-muted">
                            <div class="hub-health-copy">
                                <div class="hub-health-area">@item.Area</div>
                                <div class="hub-health-name">@item.Name</div>
                                <div class="hub-muted">@item.Message</div>
                            </div>
                            <span class="@("hub-health-pill " + getHealthClass(item.Status))">@getHealthText(item.Status)</span>
                        </div>
                    }
                }
            }
        </div>
    }
</MudPaper>

@code {
    [Parameter]
    public IReadOnlyList<GoogleHealthCheckItem> Items
    {
        get; set;
    } = new List<GoogleHealthCheckItem>();

    [Parameter]
    public bool ShouldShowHealthyItems
    {
        get; set;
    }

    [Parameter]
    public EventCallback RefreshRequested
    {
        get; set;
    }

    [Parameter]
    public EventCallback ToggleHealthyItemsRequested
    {
        get; set;
    }

    private IReadOnlyList<GoogleHealthCheckItem> getAttentionHealthItems()
    {
        return Items.Where(item => isHealthyHealthStatus(item.Status) == false).ToList();
    }

    private IReadOnlyList<GoogleHealthCheckItem> getHealthyHealthItems()
    {
        return Items.Where(item => isHealthyHealthStatus(item.Status)).ToList();
    }

    private bool isHealthyHealthStatus(EGoogleHealthStatus status)
    {
        return status == EGoogleHealthStatus.Healthy;
    }

    private string getHealthSummaryClass()
    {
        if (Items.Any(item => item.Status == EGoogleHealthStatus.Error))
        {
            return "hub-health-error";
        }

        if (Items.Any(item => item.Status == EGoogleHealthStatus.Warning))
        {
            return "hub-health-warning";
        }

        return "hub-health-healthy";
    }

    private string getHealthSummaryText()
    {
        int errorCount = Items.Count(item => item.Status == EGoogleHealthStatus.Error);
        int warningCount = Items.Count(item => item.Status == EGoogleHealthStatus.Warning);
        if (errorCount > 0)
        {
            return "오류 " + errorCount.ToString(CultureInfo.InvariantCulture) + "개";
        }

        if (warningCount > 0)
        {
            return "주의 " + warningCount.ToString(CultureInfo.InvariantCulture) + "개";
        }

        return "정상";
    }

    private string getHealthSummaryDescription(GoogleHealthSummaryCounts healthSummaryCounts)
    {
        if (healthSummaryCounts.AttentionCount > 0)
        {
            return "정상 " + healthSummaryCounts.HealthyCount.ToString(CultureInfo.InvariantCulture) + "개";
        }

        return healthSummaryCounts.HealthyCount.ToString(CultureInfo.InvariantCulture) + "개 항목";
    }

    private string getHealthClass(EGoogleHealthStatus status)
    {
        switch (status)
        {
            case EGoogleHealthStatus.Healthy:
                return "hub-health-healthy";
            case EGoogleHealthStatus.Warning:
                return "hub-health-warning";
            default:
                return "hub-health-error";
        }
    }

    private string getHealthText(EGoogleHealthStatus status)
    {
        switch (status)
        {
            case EGoogleHealthStatus.Healthy:
                return "정상";
            case EGoogleHealthStatus.Warning:
                return "주의";
            default:
                return "오류";
        }
    }
}
