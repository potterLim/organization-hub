@page "/admin/menus"
@attribute [Authorize(Policy = OrganizationHubPolicies.MENUS_MANAGE)]
@implements IAsyncDisposable
@inject INavigationMenuService NavigationMenuService
@inject ITeamManagementService TeamManagementService
@inject IJSRuntime JavaScriptRuntime

<PageTitle>@OrganizationHubProduct.FormatPageTitle("메뉴 보이기 설정")</PageTitle>

<div class="hub-page-header">
    <div>
        <h1 class="hub-page-title">메뉴 보이기 설정</h1>
        <div class="hub-page-description">왼쪽 메뉴의 이름과 표시 대상을 정하고, 목록에서 드래그해 메뉴 순서를 조정합니다.</div>
    </div>
</div>

@if (string.IsNullOrWhiteSpace(mMessage) == false)
{
    <MudAlert Severity="@mMessageSeverity" Class="mb-4">@mMessage</MudAlert>
}

<MudGrid Spacing="6" Class="hub-management-grid hub-admin-page-grid">
    <MudItem xs="12" lg="5" xl="4">
        <MudPaper Class="hub-card hub-form-card pa-4">
            @if (mSelectedMenuItemOrNull == null)
            {
                <div class="hub-empty">수정할 메뉴를 선택해 주세요.</div>
            }
            else
            {
                <div class="hub-admin-form-heading">
                    <MudText Typo="Typo.h6">@mSelectedMenuItemOrNull.DisplayName</MudText>
                    <span>@MenuAccessLevelUtility.GetShortDisplayName(mFormModel.AccessLevel)</span>
                </div>
                <div class="hub-form-hint">
                    <span>메뉴가 보일 대상을 정합니다.</span>
                    <span>화면 주소는 시스템이 관리합니다.</span>
                </div>
                <MudTextField @bind-Value="mFormModel.DisplayName" Label="메뉴 이름" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                <MudSelect T="EMenuAccessLevel" Label="표시 대상" Value="mFormModel.AccessLevel" ValueChanged="setAccessLevel" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@mSelectedMenuItemOrNull.IsLocked">
                    <MudSelectItem T="EMenuAccessLevel" Value="EMenuAccessLevel.Authenticated">전체</MudSelectItem>
                    <MudSelectItem T="EMenuAccessLevel" Value="EMenuAccessLevel.TeamMember">팀 구성원</MudSelectItem>
                    <MudSelectItem T="EMenuAccessLevel" Value="EMenuAccessLevel.TeamLeader">팀 책임자 이상</MudSelectItem>
                    <MudSelectItem T="EMenuAccessLevel" Value="EMenuAccessLevel.ManagementManager">관리팀 책임자 이상</MudSelectItem>
                    <MudSelectItem T="EMenuAccessLevel" Value="EMenuAccessLevel.Management">관리팀</MudSelectItem>
                    <MudSelectItem T="EMenuAccessLevel" Value="EMenuAccessLevel.Admin">시스템 관리자</MudSelectItem>
                </MudSelect>
                <MudSwitch T="bool" @bind-Value="mFormModel.IsActive" Label="메뉴 사용" Color="Color.Primary" Disabled="@mSelectedMenuItemOrNull.IsLocked" />
                @if (mSelectedMenuItemOrNull.IsLocked)
                {
                    <MudAlert Severity="Severity.Info" Class="mb-3">필수 관리 메뉴라 접근 권한과 활성 상태를 변경할 수 없습니다.</MudAlert>
                }
                @if (MenuAccessLevelUtility.IsTeamScoped(mFormModel.AccessLevel))
                {
                    <MudDivider Class="my-4" />
                    <MudText Typo="Typo.h6">팀 표시 범위</MudText>
                    <MudSwitch T="bool" Value="mFormModel.IsVisibleToAllTeams" ValueChanged="@(value => setVisibleToAllTeams(value ? EMenuTeamVisibility.AllTeams : EMenuTeamVisibility.SelectedTeams))" Label="모든 팀에 표시" Color="Color.Primary" />
                    <div class="hub-team-check-grid">
                        @foreach (Team team in mTeams)
                        {
                            <MudCheckBox T="bool" Value="@isTeamSelected(team.Id)" ValueChanged="@(value => setTeamSelected(team.Id, value ? ETeamSelectionState.Selected : ETeamSelectionState.Deselected))" Label="@team.DisplayName" Color="Color.Primary" Disabled="@mFormModel.IsVisibleToAllTeams" />
                        }
                    </div>
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Class="mt-4">이 메뉴는 표시 대상만으로 관리되며 팀 범위를 따로 고르지 않습니다.</MudAlert>
                }
                <div class="hub-submit-row">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="saveMenuAsync" StartIcon="@Icons.Material.Filled.Save" Class="hub-primary-action-button">저장</MudButton>
                </div>
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" lg="7" xl="8">
        <MudPaper Class="hub-card hub-list-card pa-4">
            <div class="hub-admin-section-heading">
                <div>
                    <MudText Typo="Typo.h6">메뉴 목록</MudText>
                    <div class="hub-muted">왼쪽 메뉴에 보일 순서대로 드래그해 정렬합니다.</div>
                </div>
            </div>
            <div @ref="mSortableRootElement" class="hub-sortable-list hub-menu-sortable-list" data-sortable-list>
                @foreach (NavigationMenuItem menuItem in mMenuItems)
                {
                    <div class="hub-sortable-row hub-menu-sortable-row" data-sortable-item-id="@menuItem.Id" draggable="true">
                        <span class="hub-sortable-handle" role="button" aria-label="메뉴 순서 변경">
                            <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" />
                        </span>
                        <div class="hub-sortable-main">
                            <div class="hub-sortable-title">@menuItem.DisplayName</div>
                            <div class="hub-sortable-meta">
                                <span>@MenuAccessLevelUtility.GetShortDisplayName(menuItem.AccessLevel)</span>
                                <span>·</span>
                                <span>@getTeamPermissionText(menuItem)</span>
                            </div>
                        </div>
                        <div class="hub-sortable-actions">
                            <span class="hub-sortable-status @(menuItem.IsActive ? "hub-status-pill hub-status-active" : "hub-status-pill hub-status-inactive")">@(menuItem.IsActive ? "사용 중" : "숨김")</span>
                            <MudTooltip Text="메뉴 수정">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => editMenu(menuItem))" aria-label="메뉴 수정" />
                            </MudTooltip>
                        </div>
                    </div>
                }
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>
