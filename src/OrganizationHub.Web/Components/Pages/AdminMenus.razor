@page "/admin/menus"
@attribute [Authorize(Policy = OrganizationHubPolicies.MENUS_MANAGE)]
@implements IAsyncDisposable
@inject INavigationMenuService NavigationMenuService
@inject ITeamManagementService TeamManagementService
@inject IJSRuntime JavaScriptRuntime

@if (string.IsNullOrWhiteSpace(mPreviousDraft) == false)
{
    <MudAlert Severity="Severity.Info" Class="mb-3">
        <strong>다시 불러오기 전 내 입력</strong>
        <div class="hub-draft-copy">@mPreviousDraft</div>
        <span>현재의 최신 내용과 비교한 뒤 필요한 변경을 다시 입력해 주세요.</span>
        <MudButton Variant="Variant.Text" OnClick="@(() => mPreviousDraft = string.Empty)">비교 마침</MudButton>
    </MudAlert>
}

<PageTitle>@OrganizationHubProduct.FormatPageTitle("메뉴 보이기 설정")</PageTitle>

<h1 class="hub-sr-only">메뉴 보이기 설정</h1>

@if (string.IsNullOrWhiteSpace(mMessage) == false)
{
    <MudAlert Severity="@mMessageSeverity" Class="mb-4">@mMessage</MudAlert>
    @if (mHasSaveConflict)
    {
        <MudButton OnClick="reloadMenusAsync" Variant="Variant.Outlined" Color="Color.Primary" Class="mb-4">최신 메뉴 설정 불러오기</MudButton>
    }
}

<MudGrid Spacing="6" Class="hub-management-grid hub-admin-page-grid">
    <MudItem xs="12" lg="5" xl="4" Class="hub-admin-sticky-column hub-editor-anchor" id="menu-editor" tabindex="-1">
        <MudPaper Class="hub-card hub-form-card hub-menu-editor-card pa-4">
            @if (mSelectedMenuItemOrNull == null)
            {
                <div class="hub-empty">수정할 메뉴를 선택해 주세요.</div>
            }
            else
            {
                <div class="hub-admin-form-heading">
                    <MudText Typo="Typo.h6">메뉴 설정</MudText>
                    <span>표시 대상: @MenuAccessLevelUtility.GetShortDisplayName(mFormModel.AccessLevel)</span>
                </div>
                <div class="hub-selected-editor-summary">
                    <span>현재 편집 중</span>
                    <strong>@mSelectedMenuItemOrNull.DisplayName</strong>
                    <small>@getTeamPermissionText(mSelectedMenuItemOrNull)</small>
                </div>
                <div class="hub-form-hint">
                    <span>일반 사용자는 표시 대상과 필요 권한을 모두 만족해야 메뉴가 보입니다.</span>
                    <span>시스템 관리자는 관리 목적상 모든 활성 메뉴를 확인합니다.</span>
                </div>
                <div class="hub-menu-access-summary">
                    <span>필요 권한</span>
                    <strong>@getRequiredPermissionText()</strong>
                    <small>이 권한이 없으면 표시 대상에 포함되어도 메뉴가 숨겨집니다.</small>
                </div>
                <MudSelect T="int" Label="메뉴 섹션" @bind-Value="mFormModel.SectionId" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (NavigationMenuSection menuSection in mSections)
                    {
                        <MudSelectItem T="int" Value="@menuSection.Id">@menuSection.DisplayName</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField @bind-Value="mFormModel.DisplayName" Label="메뉴 이름 (필수)" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                <MudSelect T="EMenuAccessLevel" Label="표시 대상" Value="mFormModel.AccessLevel" ValueChanged="setAccessLevel" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@mSelectedMenuItemOrNull.IsLocked">
                    <MudSelectItem T="EMenuAccessLevel" Value="EMenuAccessLevel.Authenticated">전체 사용자</MudSelectItem>
                    <MudSelectItem T="EMenuAccessLevel" Value="EMenuAccessLevel.TeamMember">선택한 팀</MudSelectItem>
                    <MudSelectItem T="EMenuAccessLevel" Value="EMenuAccessLevel.TeamLeader">선택한 팀 + 필요 권한</MudSelectItem>
                    <MudSelectItem T="EMenuAccessLevel" Value="EMenuAccessLevel.ManagementManager">관리 권한 보유자</MudSelectItem>
                    <MudSelectItem T="EMenuAccessLevel" Value="EMenuAccessLevel.Management">관리팀</MudSelectItem>
                    <MudSelectItem T="EMenuAccessLevel" Value="EMenuAccessLevel.Admin">시스템 관리자</MudSelectItem>
                </MudSelect>
                <MudSelect T="string" Label="필요 권한" MultiSelection="true" MultiSelectionTextFunc="getRequiredPermissionSelectionText" SelectedValues="mFormModel.RequiredPermissionKeys" SelectedValuesChanged="setRequiredPermissionKeys" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@mSelectedMenuItemOrNull.IsLocked">
                    @foreach (PermissionDefinition permissionDefinition in mPermissionDefinitions)
                    {
                        <MudSelectItem T="string" Value="@permissionDefinition.Key">@permissionDefinition.Category · @permissionDefinition.DisplayName</MudSelectItem>
                    }
                </MudSelect>
                <MudSwitch T="bool" @bind-Value="mFormModel.IsActive" Label="메뉴 사용" Color="Color.Primary" Disabled="@mSelectedMenuItemOrNull.IsLocked" />
                @if (mSelectedMenuItemOrNull.IsLocked)
                {
                    <MudAlert Severity="Severity.Info" Class="mb-3">필수 관리 메뉴라 접근 권한과 활성 상태를 변경할 수 없습니다.</MudAlert>
                }
                @if (MenuAccessLevelUtility.IsTeamScoped(mFormModel.AccessLevel))
                {
                    <MudDivider Class="my-4" />
                    <MudText Typo="Typo.h6">팀 표시 범위</MudText>
                    <MudSwitch T="bool" Value="mFormModel.IsVisibleToAllTeams" ValueChanged="@(value => setVisibleToAllTeams(value ? EMenuTeamVisibility.AllTeams : EMenuTeamVisibility.SelectedTeams))" Label="모든 팀에 표시" Color="Color.Primary" />
                    @if (mFormModel.IsVisibleToAllTeams)
                    {
                        <MudAlert Severity="Severity.Info" Class="mt-3">
                            <div class="hub-alert-line-stack">
                                <span>모든 팀에 표시됩니다.</span>
                                <span>시스템 관리자는 모든 활성 메뉴를 관리할 수 있습니다.</span>
                            </div>
                        </MudAlert>
                    }
                    else
                    {
                        <div class="hub-team-check-grid">
                            @foreach (Team team in mTeams)
                            {
                                <MudCheckBox T="bool" Value="@isTeamSelected(team.Id)" ValueChanged="@(value => setTeamSelected(team.Id, value ? ETeamSelectionState.Selected : ETeamSelectionState.Deselected))" Label="@team.DisplayName" Color="Color.Primary" />
                            }
                        </div>
                    }
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Class="mt-4">팀 범위 없이 표시 대상과 직책 권한으로 판단합니다. 시스템 관리자는 모든 활성 메뉴를 관리할 수 있습니다.</MudAlert>
                }
                <div class="hub-submit-row">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="saveMenuAsync" StartIcon="@Icons.Material.Filled.Save" Class="hub-primary-action-button">저장</MudButton>
                </div>
            }
        </MudPaper>
        <MudPaper Class="hub-card hub-form-card hub-menu-section-card pa-4 mt-4">
            <div class="hub-admin-form-heading">
                <MudText Typo="Typo.h6">섹션 관리</MudText>
                <span>@(mSectionFormModel.Id == 0 ? "새 섹션" : "수정 중")</span>
            </div>
                <div class="hub-form-hint">
                    <span>섹션은 왼쪽 메뉴의 묶음 제목입니다.</span>
                    <span>섹션 순서에서 드래그하거나 위·아래 버튼으로 위치를 바꿀 수 있습니다.</span>
                </div>
            <MudTextField @bind-Value="mSectionFormModel.DisplayName" Label="섹션 이름 (필수)" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
            @if (mMessageSeverity == Severity.Error && string.IsNullOrWhiteSpace(mMessage) == false)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3" role="alert">@mMessage</MudAlert>
            }
            <MudStack Row="true" Spacing="2" Class="hub-form-actions hub-form-actions-centered mt-3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="saveSectionAsync" StartIcon="@Icons.Material.Filled.Save" Class="hub-primary-action-button">저장</MudButton>
                @if (mSectionFormModel.Id != 0)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="clearSectionForm">새 섹션</MudButton>
                }
            </MudStack>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" lg="7" xl="8">
        <MudPaper Class="hub-card hub-list-card pa-4">
            <div class="hub-admin-section-heading">
                <div>
                    <MudText Typo="Typo.h6">메뉴 구조</MudText>
                    <div class="hub-muted">섹션 순서와 메뉴 순서를 드래그하거나 위·아래 버튼으로 조정합니다.</div>
                </div>
            </div>
            <div class="hub-menu-structure" @ref="mSortableRootElement">
                <section>
                    <div class="hub-menu-structure-heading">섹션 순서</div>
                    <div class="hub-sortable-list hub-menu-section-list" data-sortable-list>
                        @foreach (NavigationMenuSection menuSection in mSections)
                        {
                            <div class="hub-sortable-row hub-menu-section-row" data-sortable-item-id="@getSectionSortableItemId(menuSection)" draggable="true">
                                <span class="hub-sortable-handle" aria-hidden="true">
                                    <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" />
                                </span>
                                <div class="hub-sortable-main">
                                    <div class="hub-sortable-title">@menuSection.DisplayName</div>
                                    <div class="hub-sortable-meta">@getSectionMenuCountText(menuSection)</div>
                                </div>
                                <div class="hub-sortable-actions">
                                    <SortableOrderControls ItemId="menuSection.Id" ItemKeyPrefix="section:" Label="@menuSection.DisplayName" OrderedIds="@(mSections.Select(item => item.Id).ToArray())" MoveRequested="moveSectionAsync" />
                                    <MudTooltip Text="섹션 수정">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => editSection(menuSection))" aria-label="섹션 수정" />
                                    </MudTooltip>
                                </div>
                            </div>
                        }
                    </div>
                </section>
                <section>
                    <div class="hub-menu-structure-heading">메뉴 순서</div>
                    @foreach (NavigationMenuSection menuSection in mSections)
                    {
                        IReadOnlyList<NavigationMenuItem> sectionMenuItems = getMenuItemsForSection(menuSection);
                        if (sectionMenuItems.Count == 0)
                        {
                            continue;
                        }

                        <div class="hub-menu-section-heading-row">@menuSection.DisplayName</div>
                        <div class="hub-sortable-list hub-menu-sortable-list" data-sortable-list>
                            @foreach (NavigationMenuItem menuItem in sectionMenuItems)
                            {
                                <div class="@getMenuSortableRowClass(menuItem)" data-sortable-item-id="@getMenuSortableItemId(menuItem)" draggable="true">
                                    <span class="hub-sortable-handle" aria-hidden="true">
                                        <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" />
                                    </span>
                                    <div class="hub-sortable-main">
                                        <div class="hub-sortable-title">@menuItem.DisplayName</div>
                                        <div class="hub-sortable-meta">
                                            <span>@MenuAccessLevelUtility.GetShortDisplayName(menuItem.AccessLevel)</span>
                                            <span>·</span>
                                            <span>@getTeamPermissionText(menuItem)</span>
                                        </div>
                                    </div>
                                    <div class="hub-sortable-actions">
                                        <span class="hub-sortable-status @(menuItem.IsActive ? "hub-status-pill hub-status-active" : "hub-status-pill hub-status-inactive")">@(menuItem.IsActive ? "사용 중" : "숨김")</span>
                                        <SortableOrderControls ItemId="menuItem.Id" ItemKeyPrefix="menu:" Label="@menuItem.DisplayName" OrderedIds="@(sectionMenuItems.Select(item => item.Id).ToArray())" MoveRequested="moveMenuItemAsync" />
                                        <MudTooltip Text="메뉴 수정">
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" Href="/admin/menus#menu-editor" OnClick="@(() => editMenu(menuItem))" aria-label="@(menuItem.DisplayName + " 메뉴 수정")" />
                                        </MudTooltip>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </section>
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>
