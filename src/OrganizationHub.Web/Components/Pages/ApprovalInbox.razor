@page "/approvals/inbox"
@attribute [Authorize]
@inherits TimeZoneAwareOrganizationHubComponentBase
@inject Microsoft.Extensions.Logging.ILogger<ApprovalInbox> Logger
@inject IApprovalService ApprovalService
@inject IDriveFileNameConflictService DriveFileNameConflictService

<PageTitle>@OrganizationHubProduct.FormatPageTitle("내 결재함")</PageTitle>

<h1 class="hub-sr-only">내 결재함</h1>

@if (string.IsNullOrWhiteSpace(mMessage) == false)
{
    <MudAlert Severity="@mMessageSeverity" Class="mb-4">@mMessage</MudAlert>
}

@if (mIsLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    @if (mPendingApprovals.Count == 0)
    {
        <ResourceStateMessage Icon="@Icons.Material.Filled.FactCheck" Title="현재 처리할 결재가 없습니다." Description="대기 중인 결재가 생기면 이 화면에 바로 표시됩니다." />
    }
    else
    {
        <div class="hub-approval-list">
        @foreach (ApprovalRequestItem approvalRequest in mPendingApprovals)
        {
            <MudPaper Class="hub-card hub-approval-card pa-4">
                <div class="hub-approval-card-head">
                    <div>
                        <MudText Typo="Typo.h6" Class="hub-list-title hub-approval-title">@approvalRequest.Title</MudText>
                        <MudText Typo="Typo.body2" Class="hub-list-meta">@approvalRequest.GetRequesterAffiliationText() · @formatDate(approvalRequest.RequestedAt)</MudText>
                    </div>
                    <span class="hub-status-pill hub-status-active">@getCurrentStepLabel(approvalRequest)</span>
                </div>
                @if (mErrorsByApprovalId.TryGetValue(approvalRequest.Id, out string? operationErrorOrNull))
                {
                    <MudAlert Severity="Severity.Error" Dense="true" role="alert">@operationErrorOrNull</MudAlert>
                }
                @if (mProcessingApprovalIds.Contains(approvalRequest.Id))
                {
                    <MudProgressLinear Indeterminate="true" aria-label="결재 처리 중" />
                }
                <div class="hub-approval-file-row">
                    <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Size="Size.Small" />
                    <span>@approvalRequest.FileName</span>
                    <MudTooltip Text="다운로드">
                        <MudIconButton Href="@(approvalRequest.HasDocumentSnapshot ? "/approvals/" + approvalRequest.Id + "/document" : "/files/" + approvalRequest.FileId + "/download")" download="@approvalRequest.FileName" data-enhance-nav="false" Icon="@Icons.Material.Filled.Download" Color="Color.Primary" Size="Size.Small" aria-label="다운로드" />
                    </MudTooltip>
                </div>
                @if (approvalRequest.HasDocumentSnapshot)
                {
                    <MudText Typo="Typo.body2" Class="hub-list-meta">제출 시점에 보존한 문서입니다.</MudText>
                }
                @if (shouldShowNextStepSummary(approvalRequest))
                {
                    <div class="hub-approval-next-step">
                        <MudIcon Icon="@Icons.Material.Filled.Route" Size="Size.Small" />
                        <span>@getNextStepSummaryText(approvalRequest)</span>
                    </div>
                }
                @if (approvalRequest.Status != EApprovalRequestStatus.Publishing)
                {
                    <MudTextField Value="@getCommentValue(ApprovalRequestId.CreateExisting(approvalRequest.Id))"
                                  ValueChanged="@((string comment) => setCommentValue(ApprovalRequestId.CreateExisting(approvalRequest.Id), comment))"
                                  Label="코멘트"
                                  ReadOnly="@(approvalRequest.Status == EApprovalRequestStatus.Publishing)"
                                  Lines="3"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Class="hub-approval-comment-field" />
                }
                @if (hasApprovedFileConflict(approvalRequest))
                {
                    <div class="hub-file-conflict-panel hub-approval-conflict-panel">
                        <div class="hub-file-conflict-copy">
                            <span class="hub-file-conflict-icon">
                                <MudIcon Icon="@Icons.Material.Filled.ReportProblem" Size="Size.Small" />
                            </span>
                            <div>
                                <strong>@getApprovedFileConflictTitle(approvalRequest)</strong>
                                <span>새 파일로 추가할 이름: @getApprovedFileSuggestedFileName(approvalRequest)</span>
                                @if (getApprovedFileConflictOrNull(approvalRequest)?.CanReplaceExistingFile != true)
                                {
                                    <span>같은 이름의 파일이 여러 개여서 교체할 수 없습니다. 새 파일로 추가하거나 자료실에서 기존 파일을 정리해 주세요.</span>
                                }
                            </div>
                        </div>
                        <div class="hub-file-conflict-actions">
                            <MudButton Disabled="@(mProcessingApprovalIds.Contains(approvalRequest.Id) || getApprovedFileConflictOrNull(approvalRequest)?.CanReplaceExistingFile != true)" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="@(() => approveRequestWithConflictResolutionAsync(approvalRequest, EDriveFileNameConflictResolution.ReplaceExistingFile))">기존 파일 교체</MudButton>
                            <MudButton Disabled="@mProcessingApprovalIds.Contains(approvalRequest.Id)" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="@(() => approveRequestWithConflictResolutionAsync(approvalRequest, EDriveFileNameConflictResolution.AddNewFile))">새 파일로 추가</MudButton>
                        </div>
                    </div>
                }
                <div class="hub-approval-steps">
                    @foreach (ApprovalStepItem step in approvalRequest.Steps)
                    {
                        <span class="@getStepClass(step)">@getStepDisplayText(approvalRequest, step)</span>
                    }
                </div>
                <MudStack Row="true" Spacing="2" Class="hub-form-actions mt-3">
                    @if (approvalRequest.Status == EApprovalRequestStatus.Publishing)
                    {
                        @if (approvalRequest.IsPublicationProcessing)
                        {
                            <MudText Typo="Typo.body2">승인본을 저장하고 있습니다. 잠시 후 저장 상태를 다시 확인해 주세요.</MudText>
                            <MudButton Disabled="@mProcessingApprovalIds.Contains(approvalRequest.Id)" Variant="Variant.Outlined" Color="Color.Primary" OnClick="loadDataAsync">저장 상태 새로고침</MudButton>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2">@(approvalRequest.HasPublicationFailure ? "승인본 저장이 지연되었습니다. 자동으로 재시도되며 지금 다시 시도할 수도 있습니다." : "결재가 완료되어 승인본 저장을 기다리고 있습니다.")</MudText>
                            <MudButton Disabled="@mProcessingApprovalIds.Contains(approvalRequest.Id)" Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => approveRequestAsync(approvalRequest))">저장 다시 시도</MudButton>
                        }
                    }
                    else if (hasApprovedFileConflict(approvalRequest) == false)
                    {
                        <MudButton Disabled="@mProcessingApprovalIds.Contains(approvalRequest.Id)" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CheckCircle" OnClick="@(() => approveRequestAsync(approvalRequest))">승인</MudButton>
                    }
                    @if (approvalRequest.Status != EApprovalRequestStatus.Publishing)
                    {
                        <MudButton Disabled="@mProcessingApprovalIds.Contains(approvalRequest.Id)" Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Cancel" OnClick="@(() => rejectRequestAsync(approvalRequest))">반려</MudButton>
                    }
                </MudStack>
            </MudPaper>
        }
        </div>
    }
}
