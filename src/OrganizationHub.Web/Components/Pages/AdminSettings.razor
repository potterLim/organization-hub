@page "/admin/settings"
@attribute [Authorize(Policy = OrganizationHubPolicies.SYSTEM_SETTINGS_MANAGE)]
@inject ITeamManagementService TeamManagementService
@inject IGoogleConnectionService GoogleConnectionService
@inject IGoogleWorkspaceBrowserService GoogleWorkspaceBrowserService
@inject IGoogleWorkspaceSetupService GoogleWorkspaceSetupService
@inject IDriveService DriveService

<PageTitle>@OrganizationHubProduct.FormatPageTitle("시스템 설정")</PageTitle>

<div class="hub-page-header">
    <div>
        <h1 class="hub-page-title">시스템 설정</h1>
        <div class="hub-page-description">Drive, Calendar, Google Tasks와 공지 파일을 각 화면에 연결합니다.</div>
    </div>
</div>

@if (string.IsNullOrWhiteSpace(mMessage) == false)
{
    <MudAlert Severity="@mMessageSeverity" Class="mb-4">@mMessage</MudAlert>
}

<div class="hub-settings-layout">
    <div class="hub-settings-side">
        <AdminSettingsConnectionCard Status="mStatus" />
        <AdminSettingsDisplayOptionsCard FormModel="mFormModel" SaveRequested="saveSettingAsync" />
    </div>

    <div class="hub-settings-main">
        <MudTabs Elevation="0" Class="hub-settings-tabs">
            <MudTabPanel Text="요약">
                <AdminSettingsSummaryPanel ResourceSummaries="getPrimaryResourceSummaries()" IsRefreshing="mIsRefreshing" RefreshRequested="refreshAllAsync" />
            </MudTabPanel>
            <MudTabPanel Text="Drive">
                <AdminSettingsDrivePanel State="@createDrivePanelState()" Actions="@createDrivePanelActions()" />
            </MudTabPanel>
            <MudTabPanel Text="Calendar">
                <AdminSettingsCalendarPanel State="@createCalendarPanelState()" Actions="@createCalendarPanelActions()" />
            </MudTabPanel>
            <MudTabPanel Text="Google Tasks">
                <AdminSettingsTaskListPanel State="@createTaskListPanelState()" Actions="@createTaskListPanelActions()" />
            </MudTabPanel>
            <MudTabPanel Text="고급">
                <AdminSettingsAdvancedPanel FormModel="mFormModel" SaveRequested="saveSettingAsync" />
            </MudTabPanel>
        </MudTabs>
    </div>
</div>
