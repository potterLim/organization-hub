@page "/admin/approval-workflows"
@attribute [Authorize(Policy = OrganizationHubPolicies.APPROVAL_WORKFLOWS_MANAGE)]
@inject IApprovalWorkflowManagementService ApprovalWorkflowManagementService
@inject IPositionManagementService PositionManagementService
@inject ITeamManagementService TeamManagementService

<PageTitle>@OrganizationHubProduct.FormatPageTitle("결재 경로 설정")</PageTitle>

<div class="hub-page-header">
    <div>
        <h1 class="hub-page-title">결재 경로 설정</h1>
        <div class="hub-page-description">요청 팀에 따라 어떤 순서로 누구에게 결재를 받을지 정합니다.</div>
    </div>
</div>

@if (string.IsNullOrWhiteSpace(mMessage) == false)
{
    <MudAlert Severity="@mMessageSeverity" Class="mb-4">@mMessage</MudAlert>
}

<MudGrid Spacing="6" Class="hub-management-grid hub-admin-page-grid">
    <MudItem xs="12" lg="5" xl="4">
        <MudPaper Class="hub-card hub-form-card pa-4">
            <div class="hub-admin-form-heading">
                <MudText Typo="Typo.h6">@mFormTitle</MudText>
                <span>@(mFormModel.ID == 0 ? "새 경로" : "수정 중")</span>
            </div>
            <MudTextField @bind-Value="mFormModel.Name" Label="결재 경로 이름" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
            <MudTextField @bind-Value="mFormModel.Description" Label="설명" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" Immediate="true" />
            <MudSelect T="int?" Label="요청을 올리는 팀" Value="mFormModel.AppliesToTeamID" ValueChanged="setAppliesToTeamID" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                @foreach (Team team in mTeams)
                {
                    <MudSelectItem T="int?" Value="@((int?)team.ID)">@team.DisplayName</MudSelectItem>
                }
            </MudSelect>
            <MudNumericField T="int" @bind-Value="mFormModel.Priority" Label="우선순위 숫자" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
            <div class="hub-form-hint">겹치면 숫자가 낮은 경로가 먼저 적용됩니다. 예: 팀 전용 10, 기본 경로 100.</div>
            <MudSwitch T="bool" @bind-Value="mFormModel.IsActive" Label="바로 사용" Color="Color.Primary" />

            <MudDivider Class="my-4" />
            <div class="hub-google-panel-heading">
                <MudText Typo="Typo.h6">결재 단계</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="addStep" StartIcon="@Icons.Material.Filled.Add">단계 추가</MudButton>
            </div>

            <div class="hub-workflow-step-list">
                @foreach (ApprovalWorkflowStepFormModel step in mFormModel.Steps.OrderBy(step => step.StepOrder))
                {
                    <MudPaper Class="hub-workflow-step pa-3" Elevation="0">
                        <div class="hub-workflow-step-heading">
                            <MudText Typo="Typo.subtitle1">@(step.StepOrder)단계</MudText>
                            <MudTooltip Text="단계 삭제">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => removeStep(step))" aria-label="단계 삭제" />
                            </MudTooltip>
                        </div>
                        <div class="hub-workflow-step-fields">
                            <MudTextField @bind-Value="step.StepName" Label="단계 이름" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                            <MudSelect T="EApproverSelectionType" Label="승인자를 찾는 방법" Value="step.ApproverSelectionType" ValueChanged="@(selectionType => setApproverSelectionType(step, selectionType))" Variant="Variant.Outlined" Margin="Margin.Dense">
                                <MudSelectItem T="EApproverSelectionType" Value="EApproverSelectionType.SpecificUser">특정 사용자</MudSelectItem>
                                <MudSelectItem T="EApproverSelectionType" Value="EApproverSelectionType.SpecificPosition">특정 직책</MudSelectItem>
                                <MudSelectItem T="EApproverSelectionType" Value="EApproverSelectionType.PositionInRequesterTeam">요청자 팀의 직책</MudSelectItem>
                                <MudSelectItem T="EApproverSelectionType" Value="EApproverSelectionType.PositionInSelectedTeam">특정 팀의 직책</MudSelectItem>
                                <MudSelectItem T="EApproverSelectionType" Value="EApproverSelectionType.PermissionHolder">특정 권한 보유자</MudSelectItem>
                            </MudSelect>

                            @if (step.ApproverSelectionType == EApproverSelectionType.SpecificUser)
                            {
                                <MudSelect T="int?" Label="승인자" Value="step.ApproverUserID" ValueChanged="@(userID => step.ApproverUserID = userID)" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    @foreach (UserAccount user in mUsers)
                                    {
                                        <MudSelectItem T="int?" Value="@((int?)user.ID)">@getUserDisplayName(user)</MudSelectItem>
                                    }
                                </MudSelect>
                            }

                            @if (usesPosition(step.ApproverSelectionType))
                            {
                                <MudSelect T="int?" Label="승인 직책" Value="step.ApproverPositionID" ValueChanged="@(positionID => step.ApproverPositionID = positionID)" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    @foreach (OrganizationPosition position in mPositions)
                                    {
                                        <MudSelectItem T="int?" Value="@((int?)position.ID)">@getPositionDisplayName(position)</MudSelectItem>
                                    }
                                </MudSelect>
                            }

                            @if (step.ApproverSelectionType == EApproverSelectionType.PositionInSelectedTeam)
                            {
                                <MudSelect T="int?" Label="승인 팀" Value="step.ApproverTeamID" ValueChanged="@(teamID => step.ApproverTeamID = teamID)" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    @foreach (Team team in mTeams)
                                    {
                                        <MudSelectItem T="int?" Value="@((int?)team.ID)">@team.DisplayName</MudSelectItem>
                                    }
                                </MudSelect>
                            }

                            @if (step.ApproverSelectionType == EApproverSelectionType.PermissionHolder)
                            {
                                    <MudSelect T="string" Label="승인할 사람의 권한" Value="step.RequiredPermissionKey" ValueChanged="@(permissionKey => step.RequiredPermissionKey = permissionKey)" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    @foreach (PermissionDefinition definition in mPermissionDefinitions)
                                    {
                                        <MudSelectItem T="string" Value="@definition.Key">@definition.DisplayName</MudSelectItem>
                                    }
                                </MudSelect>
                                <MudSelect T="EPermissionScopeType" Label="권한 적용 범위" @bind-Value="step.ScopeType" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    <MudSelectItem T="EPermissionScopeType" Value="EPermissionScopeType.Global">모든 팀</MudSelectItem>
                                    <MudSelectItem T="EPermissionScopeType" Value="EPermissionScopeType.OwnTeam">소속 팀</MudSelectItem>
                                    <MudSelectItem T="EPermissionScopeType" Value="EPermissionScopeType.OwnTeamAndChildren">소속 팀과 하위 팀</MudSelectItem>
                                    <MudSelectItem T="EPermissionScopeType" Value="EPermissionScopeType.SelectedTeam">지정한 팀</MudSelectItem>
                                </MudSelect>
                            }
                        </div>
                        <MudSwitch T="bool" @bind-Value="step.IsRequired" Label="필수 단계" Color="Color.Primary" />
                    </MudPaper>
                }
            </div>

            <div class="hub-workflow-preview">
                <div class="hub-workflow-preview-heading">
                    <MudIcon Icon="@Icons.Material.Filled.Route" Size="Size.Small" />
                    <span>결재 흐름 미리보기</span>
                </div>
                <div class="hub-muted">@getWorkflowTargetPreview()</div>
                <div class="hub-workflow-preview-steps">
                    @foreach (ApprovalWorkflowStepFormModel step in mFormModel.Steps.OrderBy(step => step.StepOrder))
                    {
                        <div class="hub-workflow-preview-step">
                            <span>@step.StepOrder</span>
                            <div>
                                <strong>@step.StepName</strong>
                                <div>@getWorkflowStepPreview(step)</div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <MudStack Row="true" Spacing="2" Class="hub-form-actions hub-form-actions-centered mt-4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="saveWorkflowAsync" StartIcon="@Icons.Material.Filled.Save" Class="hub-primary-action-button">저장</MudButton>
                @if (mFormModel.ID != 0)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="clearForm">새 경로</MudButton>
                }
            </MudStack>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" lg="7" xl="8">
        <MudPaper Class="hub-card hub-list-card pa-4">
            <MudText Typo="Typo.h6">결재 경로 목록</MudText>
            <MudTable Items="mWorkflows" Dense="true" Hover="true" Elevation="0" Class="hub-admin-table">
                <HeaderContent>
                    <MudTh>우선순위</MudTh>
                    <MudTh>이름</MudTh>
                    <MudTh>적용 팀</MudTh>
                    <MudTh>단계</MudTh>
                    <MudTh>상태</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate Context="workflow">
                    <MudTd DataLabel="우선순위">@workflow.Priority</MudTd>
                    <MudTd DataLabel="이름">@workflow.Name</MudTd>
                    <MudTd DataLabel="적용 팀">@getWorkflowTeamName(workflow)</MudTd>
                    <MudTd DataLabel="단계">@workflow.Steps.Count</MudTd>
                    <MudTd DataLabel="상태"><span class="@(workflow.IsActive ? "hub-status-pill hub-status-active" : "hub-status-pill hub-status-inactive")">@(workflow.IsActive ? "사용 중" : "비활성")</span></MudTd>
                    <MudTd DataLabel="작업" Class="hub-action-cell">
                        <div class="hub-table-actions">
                            <MudTooltip Text="결재 경로 수정">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => editWorkflow(workflow))" aria-label="결재 경로 수정" />
                            </MudTooltip>
                            <MudTooltip Text="@(workflow.IsActive ? "결재 경로 비활성화" : "결재 경로 활성화")">
                                <MudIconButton Icon="@(workflow.IsActive ? Icons.Material.Filled.Block : Icons.Material.Filled.CheckCircle)" Color="Color.Warning" Size="Size.Small" OnClick="@(() => toggleWorkflowActiveAsync(workflow))" aria-label="@(workflow.IsActive ? "결재 경로 비활성화" : "결재 경로 활성화")" />
                            </MudTooltip>
                        </div>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    </MudItem>
</MudGrid>

@code
{
    private List<Team> mTeams = new List<Team>();
    private List<OrganizationPosition> mPositions = new List<OrganizationPosition>();
    private List<UserAccount> mUsers = new List<UserAccount>();
    private List<PermissionDefinition> mPermissionDefinitions = new List<PermissionDefinition>();
    private List<ApprovalWorkflow> mWorkflows = new List<ApprovalWorkflow>();
    private ApprovalWorkflowFormModel mFormModel = new ApprovalWorkflowFormModel();
    private string mFormTitle = "새 결재 경로";
    private string mMessage = string.Empty;
    private Severity mMessageSeverity = Severity.Info;

    protected override async Task OnInitializedAsync()
    {
        await loadDataAsync();
        clearForm();
    }

    private async Task loadDataAsync()
    {
        IReadOnlyList<Team> teams = await TeamManagementService.GetTeamsAsync(CancellationToken.None);
        IReadOnlyList<OrganizationPosition> positions = await PositionManagementService.GetPositionsAsync(CancellationToken.None);
        IReadOnlyList<UserAccount> users = await ApprovalWorkflowManagementService.GetApproverUsersAsync(CancellationToken.None);
        IReadOnlyList<PermissionDefinition> permissionDefinitions = await PositionManagementService.GetPermissionDefinitionsAsync(CancellationToken.None);
        IReadOnlyList<ApprovalWorkflow> workflows = await ApprovalWorkflowManagementService.GetWorkflowsAsync(CancellationToken.None);
        mTeams = teams.Where(team => team.IsActive).OrderBy(team => team.SortOrder).ThenBy(team => team.DisplayName).ToList();
        mPositions = positions.Where(position => position.IsActive).ToList();
        mUsers = users.ToList();
        mPermissionDefinitions = permissionDefinitions.OrderBy(definition => definition.Category).ThenBy(definition => definition.DisplayName).ToList();
        mWorkflows = workflows.ToList();
    }

    private async Task saveWorkflowAsync()
    {
        ServiceResult result = mFormModel.ID == 0 ? await ApprovalWorkflowManagementService.CreateWorkflowAsync(mFormModel, CancellationToken.None) : await ApprovalWorkflowManagementService.UpdateWorkflowAsync(mFormModel, CancellationToken.None);
        showResult(result, "결재 경로 설정이 저장되었습니다.");
        if (result.IsSuccess)
        {
            await loadDataAsync();
            clearForm();
        }
    }

    private void editWorkflow(ApprovalWorkflow workflow)
    {
        mFormModel = new ApprovalWorkflowFormModel();
        mFormModel.ID = workflow.ID;
        mFormModel.Name = workflow.Name;
        mFormModel.Description = workflow.Description;
        mFormModel.AppliesToTeamID = workflow.AppliesToTeamID;
        mFormModel.Priority = workflow.Priority;
        mFormModel.IsActive = workflow.IsActive;
        foreach (ApprovalWorkflowStep step in workflow.Steps.OrderBy(step => step.StepOrder))
        {
            ApprovalWorkflowStepFormModel stepFormModel = new ApprovalWorkflowStepFormModel();
            stepFormModel.ID = step.ID;
            stepFormModel.StepOrder = step.StepOrder;
            stepFormModel.StepName = step.StepName;
            stepFormModel.ApproverSelectionType = step.ApproverSelectionType;
            stepFormModel.ApproverUserID = step.ApproverUserID;
            stepFormModel.ApproverPositionID = step.ApproverPositionID;
            stepFormModel.ApproverTeamID = step.ApproverTeamID;
            stepFormModel.RequiredPermissionKey = step.RequiredPermissionKey;
            stepFormModel.ScopeType = step.ScopeType;
            stepFormModel.IsRequired = step.IsRequired;
            mFormModel.Steps.Add(stepFormModel);
        }

        mFormTitle = "결재 경로 수정";
    }

    private async Task toggleWorkflowActiveAsync(ApprovalWorkflow workflow)
    {
        ServiceResult result = workflow.IsActive ? await ApprovalWorkflowManagementService.DeactivateWorkflowAsync(workflow.ID, CancellationToken.None) : await ApprovalWorkflowManagementService.ActivateWorkflowAsync(workflow.ID, CancellationToken.None);
        showResult(result, "결재 경로 상태가 변경되었습니다.");
        await loadDataAsync();
    }

    private void clearForm()
    {
        mFormModel = new ApprovalWorkflowFormModel();
        mFormModel.Priority = 100;
        mFormModel.IsActive = true;
        addStep();
        mFormTitle = "새 결재 경로";
    }

    private void addStep()
    {
        int stepOrder = mFormModel.Steps.Count + 1;
        ApprovalWorkflowStepFormModel step = new ApprovalWorkflowStepFormModel();
        step.StepOrder = stepOrder;
        step.StepName = stepOrder.ToString(CultureInfo.InvariantCulture) + "단계 승인";
        step.IsRequired = true;
        mFormModel.Steps.Add(step);
    }

    private void removeStep(ApprovalWorkflowStepFormModel step)
    {
        if (mFormModel.Steps.Count <= 1)
        {
            return;
        }

        mFormModel.Steps.Remove(step);
        renumberSteps();
    }

    private void renumberSteps()
    {
        int stepOrder = 1;
        foreach (ApprovalWorkflowStepFormModel step in mFormModel.Steps.OrderBy(step => step.StepOrder))
        {
            step.StepOrder = stepOrder;
            stepOrder++;
        }
    }

    private void setAppliesToTeamID(int? teamIDOrNull)
    {
        mFormModel.AppliesToTeamID = teamIDOrNull;
    }

    private void setApproverSelectionType(ApprovalWorkflowStepFormModel step, EApproverSelectionType selectionType)
    {
        step.ApproverSelectionType = selectionType;
        step.ApproverUserID = null;
        step.ApproverTeamID = null;
        step.RequiredPermissionKey = string.Empty;
        if (usesPosition(selectionType) == false)
        {
            step.ApproverPositionID = null;
        }
    }

    private bool usesPosition(EApproverSelectionType selectionType)
    {
        return selectionType == EApproverSelectionType.SpecificPosition ||
            selectionType == EApproverSelectionType.PositionInRequesterTeam ||
            selectionType == EApproverSelectionType.PositionInSelectedTeam;
    }

    private string getWorkflowTeamName(ApprovalWorkflow workflow)
    {
        if (workflow.AppliesToTeam == null)
        {
            return "전체";
        }

        return workflow.AppliesToTeam.DisplayName;
    }

    private string getPositionDisplayName(OrganizationPosition position)
    {
        if (position.Team == null)
        {
            return position.Name;
        }

        return position.Team.DisplayName + " / " + position.Name;
    }

    private string getUserDisplayName(UserAccount user)
    {
        if (user.Team == null)
        {
            return user.DisplayName;
        }

        return user.DisplayName + " · " + user.Team.DisplayName;
    }

    private string getWorkflowTargetPreview()
    {
        if (mFormModel.AppliesToTeamID.HasValue == false)
        {
            return "모든 팀 요청에 적용됩니다. 겹치면 숫자가 낮은 경로가 먼저입니다.";
        }

        Team? teamOrNull = mTeams.FirstOrDefault(team => team.ID == mFormModel.AppliesToTeamID.Value);
        if (teamOrNull == null)
        {
            return "선택한 팀 요청에 적용됩니다.";
        }

        return teamOrNull.DisplayName + " 팀 요청에 적용됩니다.";
    }

    private string getWorkflowStepPreview(ApprovalWorkflowStepFormModel step)
    {
        string approverText = getApproverPreview(step);
        if (step.IsRequired)
        {
            return approverText + "에게 반드시 결재를 받습니다.";
        }

        return approverText + "에게 필요한 경우 결재를 받습니다.";
    }

    private string getApproverPreview(ApprovalWorkflowStepFormModel step)
    {
        if (step.ApproverSelectionType == EApproverSelectionType.SpecificUser)
        {
            UserAccount? userOrNull = mUsers.FirstOrDefault(user => step.ApproverUserID.HasValue && user.ID == step.ApproverUserID.Value);
            if (userOrNull == null)
            {
                return "선택한 사용자";
            }

            return getUserDisplayName(userOrNull);
        }

        if (step.ApproverSelectionType == EApproverSelectionType.SpecificPosition)
        {
            return getSelectedPositionPreview(step, "선택한 직책");
        }

        if (step.ApproverSelectionType == EApproverSelectionType.PositionInRequesterTeam)
        {
            return "요청자 팀의 " + getSelectedPositionPreview(step, "선택한 직책");
        }

        if (step.ApproverSelectionType == EApproverSelectionType.PositionInSelectedTeam)
        {
            string teamText = "선택한 팀";
            Team? teamOrNull = mTeams.FirstOrDefault(team => step.ApproverTeamID.HasValue && team.ID == step.ApproverTeamID.Value);
            if (teamOrNull != null)
            {
                teamText = teamOrNull.DisplayName;
            }

            return teamText + "의 " + getSelectedPositionPreview(step, "선택한 직책");
        }

        PermissionDefinition? definitionOrNull = mPermissionDefinitions.FirstOrDefault(definition => definition.Key == step.RequiredPermissionKey);
        if (definitionOrNull == null)
        {
            return "선택한 권한 보유자";
        }

        return definitionOrNull.DisplayName + " 권한 보유자";
    }

    private string getSelectedPositionPreview(ApprovalWorkflowStepFormModel step, string fallback)
    {
        OrganizationPosition? positionOrNull = mPositions.FirstOrDefault(position => step.ApproverPositionID.HasValue && position.ID == step.ApproverPositionID.Value);
        if (positionOrNull == null)
        {
            return fallback;
        }

        return getPositionDisplayName(positionOrNull);
    }

    private void showResult(ServiceResult result, string successMessage)
    {
        if (result.IsSuccess)
        {
            mMessage = successMessage;
            mMessageSeverity = Severity.Success;
            return;
        }

        mMessage = result.ErrorMessage;
        mMessageSeverity = Severity.Error;
    }
}
