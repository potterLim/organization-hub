@page "/admin/approval-workflows"
@attribute [Authorize(Policy = OrganizationHubPolicies.APPROVAL_WORKFLOWS_MANAGE)]
@inject IApprovalWorkflowManagementService ApprovalWorkflowManagementService
@inject IPositionManagementService PositionManagementService
@inject ITeamManagementService TeamManagementService

<PageTitle>@OrganizationHubProduct.FormatPageTitle("결재 경로 설정")</PageTitle>

<div class="hub-page-header">
    <div>
        <h1 class="hub-page-title">결재 경로 설정</h1>
        <div class="hub-page-description">요청 팀과 조건에 따라 결재자를 어떤 순서로 배정할지 정합니다.</div>
    </div>
</div>

@if (string.IsNullOrWhiteSpace(mMessage) == false)
{
    <MudAlert Severity="@mMessageSeverity" Class="mb-4">@mMessage</MudAlert>
}

<MudGrid Spacing="6" Class="hub-management-grid hub-admin-page-grid">
    <MudItem xs="12" lg="5" xl="4">
        <MudPaper Class="hub-card hub-form-card hub-workflow-designer-card pa-4">
            <div class="hub-admin-form-heading">
                <MudText Typo="Typo.h6">@mFormTitle</MudText>
                <span>@(mFormModel.ID == 0 ? "새 경로" : "수정 중")</span>
            </div>
            <section class="hub-workflow-section">
                <div class="hub-workflow-section-title">적용 조건</div>
                <MudTextField @bind-Value="mFormModel.Name" Label="결재 경로 이름" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                <MudTextField @bind-Value="mFormModel.Description" Label="설명" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" Immediate="true" />
                <MudSelect T="int?" Label="요청 팀" Value="mFormModel.AppliesToTeamID" ValueChanged="setAppliesToTeamID" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                    @foreach (Team team in mTeams)
                    {
                        <MudSelectItem T="int?" Value="@((int?)team.ID)">@team.DisplayName</MudSelectItem>
                    }
                </MudSelect>
                <MudNumericField T="int" @bind-Value="mFormModel.Priority" Label="적용 우선순위" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" HelperText="숫자가 낮을수록 먼저 적용됩니다." />
                <div class="hub-form-hint">여러 경로가 같은 요청에 맞으면 적용 우선순위가 낮은 경로를 먼저 사용합니다. 팀 전용 경로는 낮게, 기본 경로는 높게 두면 관리하기 쉽습니다.</div>
                <MudSwitch T="bool" @bind-Value="mFormModel.IsActive" Label="저장 후 바로 사용" Color="Color.Primary" />
            </section>

            <div class="hub-google-panel-heading">
                <MudText Typo="Typo.h6">결재 단계</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="addStep" StartIcon="@Icons.Material.Filled.Add">단계 추가</MudButton>
            </div>

            <div class="hub-workflow-step-list">
                @foreach (ApprovalWorkflowStepFormModel step in mFormModel.Steps.OrderBy(step => step.StepOrder))
                {
                    <MudPaper Class="hub-workflow-step pa-3" Elevation="0">
                        <div class="hub-workflow-step-heading">
                            <MudText Typo="Typo.subtitle1">@(step.StepOrder)단계</MudText>
                            <MudTooltip Text="단계 삭제">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => removeStep(step))" aria-label="단계 삭제" />
                            </MudTooltip>
                        </div>
                        <div class="hub-workflow-step-fields">
                            <MudTextField @bind-Value="step.StepName" Label="단계 이름" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                            <MudSelect T="EApproverSelectionType" Label="결재자 지정 방식" Value="step.ApproverSelectionType" ValueChanged="@(selectionType => setApproverSelectionType(step, selectionType))" Variant="Variant.Outlined" Margin="Margin.Dense">
                                <MudSelectItem T="EApproverSelectionType" Value="EApproverSelectionType.SpecificUser">특정 사용자</MudSelectItem>
                                <MudSelectItem T="EApproverSelectionType" Value="EApproverSelectionType.SpecificPosition">특정 직책</MudSelectItem>
                                <MudSelectItem T="EApproverSelectionType" Value="EApproverSelectionType.PositionInRequesterTeam">요청자 팀의 직책</MudSelectItem>
                                <MudSelectItem T="EApproverSelectionType" Value="EApproverSelectionType.PositionInSelectedTeam">특정 팀의 직책</MudSelectItem>
                                <MudSelectItem T="EApproverSelectionType" Value="EApproverSelectionType.PermissionHolder">특정 권한 보유자</MudSelectItem>
                            </MudSelect>

                            @if (step.ApproverSelectionType == EApproverSelectionType.SpecificUser)
                            {
                                <MudSelect T="int?" Label="결재자" Value="step.ApproverUserID" ValueChanged="@(userID => step.ApproverUserID = userID)" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    @foreach (UserAccount user in mUsers)
                                    {
                                        <MudSelectItem T="int?" Value="@((int?)user.ID)">@getUserDisplayName(user)</MudSelectItem>
                                    }
                                </MudSelect>
                            }

                            @if (usesPosition(step.ApproverSelectionType))
                            {
                                <MudSelect T="int?" Label="결재 직책" Value="step.ApproverPositionID" ValueChanged="@(positionID => step.ApproverPositionID = positionID)" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    @foreach (OrganizationPosition position in mPositions)
                                    {
                                        <MudSelectItem T="int?" Value="@((int?)position.ID)">@getPositionDisplayName(position)</MudSelectItem>
                                    }
                                </MudSelect>
                            }

                            @if (step.ApproverSelectionType == EApproverSelectionType.PositionInSelectedTeam)
                            {
                                <MudSelect T="int?" Label="결재 팀" Value="step.ApproverTeamID" ValueChanged="@(teamID => step.ApproverTeamID = teamID)" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    @foreach (Team team in mTeams)
                                    {
                                        <MudSelectItem T="int?" Value="@((int?)team.ID)">@team.DisplayName</MudSelectItem>
                                    }
                                </MudSelect>
                            }

                            @if (step.ApproverSelectionType == EApproverSelectionType.PermissionHolder)
                            {
                                <MudSelect T="string" Label="결재자 권한" Value="step.RequiredPermissionKey" ValueChanged="@(permissionKey => step.RequiredPermissionKey = permissionKey)" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    @foreach (PermissionDefinition definition in mPermissionDefinitions)
                                    {
                                        <MudSelectItem T="string" Value="@definition.Key">@definition.DisplayName</MudSelectItem>
                                    }
                                </MudSelect>
                                <MudSelect T="EPermissionScopeType" Label="권한 적용 범위" @bind-Value="step.ScopeType" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    <MudSelectItem T="EPermissionScopeType" Value="EPermissionScopeType.Global">모든 팀</MudSelectItem>
                                    <MudSelectItem T="EPermissionScopeType" Value="EPermissionScopeType.OwnTeam">소속 팀</MudSelectItem>
                                    <MudSelectItem T="EPermissionScopeType" Value="EPermissionScopeType.OwnTeamAndChildren">소속 팀과 하위 팀</MudSelectItem>
                                    <MudSelectItem T="EPermissionScopeType" Value="EPermissionScopeType.SelectedTeam">지정한 팀</MudSelectItem>
                                </MudSelect>
                            }
                        </div>
                        <MudSwitch T="bool" @bind-Value="step.IsRequired" Label="필수 결재" Color="Color.Primary" />
                    </MudPaper>
                }
            </div>

            <div class="hub-workflow-preview">
                <div class="hub-workflow-preview-heading">
                    <MudIcon Icon="@Icons.Material.Filled.Route" Size="Size.Small" />
                    <span>결재 흐름 미리보기</span>
                </div>
                <div class="hub-muted">@getWorkflowTargetPreview()</div>
                <div class="hub-workflow-preview-steps">
                    @foreach (ApprovalWorkflowStepFormModel step in mFormModel.Steps.OrderBy(step => step.StepOrder))
                    {
                        <div class="hub-workflow-preview-step">
                            <span>@step.StepOrder</span>
                            <div>
                                <strong>@step.StepName</strong>
                                <div>@getWorkflowStepPreview(step)</div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <MudStack Row="true" Spacing="2" Class="hub-form-actions hub-form-actions-centered mt-4">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="saveWorkflowAsync" StartIcon="@Icons.Material.Filled.Save" Class="hub-primary-action-button">저장</MudButton>
                @if (mFormModel.ID != 0)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="clearForm">새 경로</MudButton>
                }
            </MudStack>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" lg="7" xl="8">
        <MudPaper Class="hub-card hub-list-card pa-4">
            <div class="hub-admin-section-heading">
                <div>
                    <MudText Typo="Typo.h6">저장된 결재 경로</MudText>
                    <div class="hub-muted">적용 우선순위가 낮은 경로부터 요청에 맞는지 확인합니다.</div>
                </div>
            </div>
            <MudTable Items="mWorkflows" Dense="true" Hover="true" Elevation="0" Class="hub-admin-table">
                <HeaderContent>
                    <MudTh>적용 우선순위</MudTh>
                    <MudTh>이름</MudTh>
                    <MudTh>요청 팀</MudTh>
                    <MudTh>단계</MudTh>
                    <MudTh>상태</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate Context="workflow">
                    <MudTd DataLabel="적용 우선순위">@workflow.Priority</MudTd>
                    <MudTd DataLabel="이름">@workflow.Name</MudTd>
                    <MudTd DataLabel="요청 팀">@getWorkflowTeamName(workflow)</MudTd>
                    <MudTd DataLabel="단계">@workflow.Steps.Count</MudTd>
                    <MudTd DataLabel="상태"><span class="@(workflow.IsActive ? "hub-status-pill hub-status-active" : "hub-status-pill hub-status-inactive")">@(workflow.IsActive ? "사용 중" : "비활성")</span></MudTd>
                    <MudTd DataLabel="작업" Class="hub-action-cell">
                        <div class="hub-table-actions">
                            <MudTooltip Text="결재 경로 수정">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => editWorkflow(workflow))" aria-label="결재 경로 수정" />
                            </MudTooltip>
                            <MudTooltip Text="@(workflow.IsActive ? "결재 경로 비활성화" : "결재 경로 활성화")">
                                <MudIconButton Icon="@(workflow.IsActive ? Icons.Material.Filled.Block : Icons.Material.Filled.CheckCircle)" Color="Color.Warning" Size="Size.Small" OnClick="@(() => toggleWorkflowActiveAsync(workflow))" aria-label="@(workflow.IsActive ? "결재 경로 비활성화" : "결재 경로 활성화")" />
                            </MudTooltip>
                        </div>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    </MudItem>
</MudGrid>
