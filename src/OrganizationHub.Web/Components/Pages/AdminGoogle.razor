@page "/admin/google"
@attribute [Authorize(Policy = OrganizationHubPolicies.GOOGLE_CONNECTION_MANAGE)]
@inject IGoogleConnectionService GoogleConnectionService
@inject IGoogleHealthCheckService GoogleHealthCheckService
@inject IGoogleWorkspaceBrowserService GoogleWorkspaceBrowserService
@inject IGoogleWorkspaceSetupService GoogleWorkspaceSetupService
@inject NavigationManager NavigationManager

<PageTitle>@OrganizationHubProduct.FormatPageTitle("Google 연결")</PageTitle>

<div class="hub-page-header">
    <div>
        <h1 class="hub-page-title">Google 연결</h1>
        <div class="hub-page-description">Google 계정을 연결하고 Drive 폴더, Calendar, Google Tasks 목록을 운영 화면에 연결합니다.</div>
    </div>
</div>

@if (string.IsNullOrWhiteSpace(MessageOrNull) == false)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">@MessageOrNull</MudAlert>
}

@if (string.IsNullOrWhiteSpace(mMessage) == false)
{
    <MudAlert Severity="@mMessageSeverity" Class="mb-4">@mMessage</MudAlert>
}

<div class="hub-google-layout">
    <div class="hub-google-side">
        <MudPaper Class="hub-card hub-form-card pa-4">
            <MudText Typo="Typo.h6">연결 상태</MudText>
            @if (mStatus.HasOAuthConfiguration == false)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-4">Google 연결 정보가 아직 준비되지 않았습니다. 배포 담당자에게 설정을 요청해 주세요.</MudAlert>
            }
            <div class="hub-google-status">
                <span class="@(mStatus.IsConnected ? "hub-status-pill hub-status-active" : "hub-status-pill hub-status-inactive")">@(mStatus.IsConnected ? "연결됨" : "미연결")</span>
                <div>
                    <div class="hub-google-status-title">@(mStatus.IsConnected ? mStatus.ConnectedEmail : "Google 계정 없음")</div>
                    <div class="hub-muted">@mStatus.Message</div>
                </div>
            </div>
            @if (mStatus.ConnectedAt.HasValue)
            {
                <div class="hub-google-meta">연결일 @formatDate(mStatus.ConnectedAt)</div>
            }
            <MudExpansionPanels Elevation="0" Class="hub-advanced-settings hub-google-advanced-settings">
                <MudExpansionPanel Text="고급: Google 연결 주소">
                    <div class="hub-google-callback">
                        <div class="hub-google-callback-label">승인 후 돌아올 주소</div>
                        <code>@getCallbackUri()</code>
                    </div>
                </MudExpansionPanel>
            </MudExpansionPanels>
            <div class="hub-google-connect-actions">
                @if (mStatus.IsConnected)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="disconnectGoogleAsync" StartIcon="@Icons.Material.Filled.LinkOff" Class="hub-primary-action-button">연결 해제</MudButton>
                }
                else if (mStatus.HasOAuthConfiguration)
                {
                    <MudButton Href="/admin/google/connect" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Link" Class="hub-primary-action-button">계정 연결</MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="true" StartIcon="@Icons.Material.Filled.Link" Class="hub-primary-action-button">계정 연결</MudButton>
                }
            </div>
        </MudPaper>
        <MudPaper Class="hub-card hub-form-card pa-4">
            <div class="hub-google-health-heading">
                <MudText Typo="Typo.h6">연결 진단</MudText>
                <MudTooltip Text="진단 새로고침">
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Primary" Size="Size.Small" OnClick="loadHealthCheckAsync" aria-label="진단 새로고침" />
                </MudTooltip>
            </div>
            @if (mHealthItems.Count == 0)
            {
                <div class="hub-empty">표시할 진단 항목이 없습니다.</div>
            }
            else
            {
                IReadOnlyList<GoogleHealthCheckItem> attentionHealthItems = getAttentionHealthItems();
                IReadOnlyList<GoogleHealthCheckItem> healthyHealthItems = getHealthyHealthItems();
                <div class="hub-health-list">
                    <div class="hub-health-summary">
                        <span class="@("hub-health-summary-pill " + getHealthSummaryClass())">@getHealthSummaryText()</span>
                        <span>@getHealthSummaryDescription()</span>
                    </div>
                    @if (attentionHealthItems.Count == 0)
                    {
                        <div class="hub-health-row hub-health-row-muted">
                            <div class="hub-health-copy">
                                <div class="hub-health-area">진단</div>
                                <div class="hub-health-name">조치가 필요한 항목 없음</div>
                                <div class="hub-muted">정상 항목은 아래에서 필요할 때만 펼쳐 확인합니다.</div>
                            </div>
                            <span class="hub-health-pill hub-health-healthy">정상</span>
                        </div>
                    }
                    @foreach (GoogleHealthCheckItem item in attentionHealthItems)
                    {
                        <div class="hub-health-row">
                            <div class="hub-health-copy">
                                <div class="hub-health-area">@item.Area</div>
                                <div class="hub-health-name">@item.Name</div>
                                <div class="hub-muted">@item.Message</div>
                            </div>
                            <span class="@("hub-health-pill " + getHealthClass(item.Status))">@getHealthText(item.Status)</span>
                        </div>
                    }
                    @if (healthyHealthItems.Count > 0)
                    {
                        <button type="button" class="hub-health-toggle" @onclick="toggleHealthyHealthItems">
                            <span>정상 항목 @(healthyHealthItems.Count)개</span>
                            <MudIcon Icon="@(mShowHealthyHealthItems ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small" />
                        </button>
                        @if (mShowHealthyHealthItems)
                        {
                            @foreach (GoogleHealthCheckItem item in healthyHealthItems)
                            {
                                <div class="hub-health-row hub-health-row-muted">
                                    <div class="hub-health-copy">
                                        <div class="hub-health-area">@item.Area</div>
                                        <div class="hub-health-name">@item.Name</div>
                                        <div class="hub-muted">@item.Message</div>
                                    </div>
                                    <span class="@("hub-health-pill " + getHealthClass(item.Status))">@getHealthText(item.Status)</span>
                                </div>
                            }
                        }
                    }
                </div>
            }
        </MudPaper>
    </div>
    <div class="hub-google-panel-stack">
        <MudPaper Class="hub-card hub-list-card pa-4">
            <div class="hub-google-panel-heading">
                <MudText Typo="Typo.h6">Drive 폴더 선택</MudText>
                <div class="hub-google-panel-actions">
                    <MudTooltip Text="표준 Drive 폴더가 없으면 만들고 설정에 연결합니다.">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(mStatus.IsConnected == false || mIsEnsuringStandardDriveFolders)" OnClick="ensureStandardDriveFoldersAsync" StartIcon="@Icons.Material.Filled.CreateNewFolder">표준 Drive 폴더 준비</MudButton>
                    </MudTooltip>
                    <MudTooltip Text="저장된 Drive 폴더 이름과 기본 자료 위치를 정리합니다.">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(mStatus.IsConnected == false || mIsApplyingStandardDriveFolderNames)" OnClick="applyStandardDriveFolderNamesAsync" StartIcon="@Icons.Material.Filled.DriveFileRenameOutline">폴더 이름 정리</MudButton>
                    </MudTooltip>
                </div>
            </div>
            <div class="hub-google-toolbar">
                <MudSelect T="string" Label="저장 대상" Value="mSelectedFolderTargetKey" ValueChanged="setFolderTarget" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (GoogleFolderAssignmentOption option in mFolderAssignmentOptions)
                    {
                        <MudSelectItem T="string" Value="@option.TargetKey">@option.DisplayName</MudSelectItem>
                    }
                </MudSelect>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="loadCurrentFolderAsync" StartIcon="@Icons.Material.Filled.Refresh">새로고침</MudButton>
            </div>
            <div class="hub-google-path">
                @for (int index = 0; index < mFolderPath.Count; index++)
                {
                    GoogleDriveFolderPathItem pathItem = mFolderPath[index];
                    <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => openPathAsync(index))">@pathItem.Name</MudButton>
                    @if (index < mFolderPath.Count - 1)
                    {
                        <span>/</span>
                    }
                }
            </div>
            @if (mFolders.Count == 0)
            {
                <div class="hub-empty">표시할 하위 폴더가 없습니다.</div>
            }
            else
            {
                <MudTable Items="mFolders" Dense="true" Hover="true" Elevation="0" Class="hub-admin-table">
                    <HeaderContent>
                        <MudTh>폴더</MudTh>
                        <MudTh>수정일</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate Context="folder">
                        <MudTd DataLabel="폴더">@folder.Name</MudTd>
                        <MudTd DataLabel="수정일">@formatDate(folder.ModifiedTime)</MudTd>
                        <MudTd DataLabel="작업" Class="hub-action-cell">
                            <div class="hub-table-actions">
                                <MudTooltip Text="하위 폴더 열기">
                                    <MudIconButton Icon="@Icons.Material.Filled.FolderOpen" Color="Color.Primary" Size="Size.Small" OnClick="@(() => openFolderAsync(folder))" aria-label="하위 폴더 열기" />
                                </MudTooltip>
                                <MudTooltip Text="이 폴더로 연결">
                                    <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" OnClick="@(() => assignFolderAsync(folder))" aria-label="이 폴더로 연결" />
                                </MudTooltip>
                            </div>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>
        <MudPaper Class="hub-card hub-list-card pa-4">
            <div class="hub-google-panel-heading">
                <MudText Typo="Typo.h6">Calendar 선택</MudText>
                <div class="hub-google-panel-actions">
                    <MudTooltip Text="표준 Calendar가 없으면 만들고 설정에 연결합니다.">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(mStatus.IsConnected == false || mIsEnsuringStandardCalendars)" OnClick="ensureStandardCalendarsAsync" StartIcon="@Icons.Material.Filled.EventAvailable">표준 Calendar 준비</MudButton>
                    </MudTooltip>
                </div>
            </div>
            <div class="hub-google-toolbar">
                <MudSelect T="string" Label="저장 대상" Value="mSelectedCalendarTargetKey" ValueChanged="setCalendarTarget" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (GoogleCalendarAssignmentOption option in mCalendarAssignmentOptions)
                    {
                        <MudSelectItem T="string" Value="@option.TargetKey">@option.DisplayName</MudSelectItem>
                    }
                </MudSelect>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="loadCalendarsAsync" StartIcon="@Icons.Material.Filled.Refresh">새로고침</MudButton>
            </div>
            @if (mCalendars.Count == 0)
            {
                <div class="hub-empty">표시할 Calendar가 없습니다.</div>
            }
            else
            {
                <MudTable Items="mCalendars" Dense="true" Hover="true" Elevation="0" Class="hub-admin-table">
                    <HeaderContent>
                        <MudTh>Calendar</MudTh>
                        <MudTh>권한</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate Context="calendar">
                        <MudTd DataLabel="Calendar">@calendar.Summary</MudTd>
                        <MudTd DataLabel="권한">@getCalendarAccessDisplayName(calendar)</MudTd>
                        <MudTd DataLabel="작업" Class="hub-action-cell">
                            <div class="hub-table-actions">
                                <MudTooltip Text="이 Calendar로 연결">
                                    <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" OnClick="@(() => assignCalendarAsync(calendar))" aria-label="이 Calendar로 연결" />
                                </MudTooltip>
                            </div>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>
        <MudPaper Class="hub-card hub-list-card pa-4">
            <div class="hub-google-panel-heading">
                <MudText Typo="Typo.h6">Google Tasks 목록 선택</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(mStatus.IsConnected == false || mIsEnsuringStandardTaskLists)" OnClick="ensureStandardTaskListsAsync" StartIcon="@Icons.Material.Filled.AutoAwesomeMotion">표준 Google Tasks 목록 준비</MudButton>
            </div>
            <div class="hub-google-toolbar">
                <MudSelect T="string" Label="저장 대상" Value="mSelectedTaskListTargetKey" ValueChanged="setTaskListTarget" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (GoogleTaskListAssignmentOption option in mTaskListAssignmentOptions)
                    {
                        <MudSelectItem T="string" Value="@option.TargetKey">@option.DisplayName</MudSelectItem>
                    }
                </MudSelect>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="loadTaskListsAsync" StartIcon="@Icons.Material.Filled.Refresh">새로고침</MudButton>
            </div>
            @if (mTaskLists.Count == 0)
            {
                <div class="hub-empty">표시할 Google Tasks 목록이 없습니다.</div>
            }
            else
            {
                <MudTable Items="mTaskLists" Dense="true" Hover="true" Elevation="0" Class="hub-admin-table">
                    <HeaderContent>
                        <MudTh>목록</MudTh>
                        <MudTh>종류</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate Context="taskList">
                        <MudTd DataLabel="목록">@taskList.Title</MudTd>
                        <MudTd DataLabel="종류">Google Tasks</MudTd>
                        <MudTd DataLabel="작업" Class="hub-action-cell">
                            <div class="hub-table-actions">
                                <MudTooltip Text="이 목록으로 연결">
                                    <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" OnClick="@(() => assignTaskListAsync(taskList))" aria-label="이 목록으로 연결" />
                                </MudTooltip>
                            </div>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>
    </div>
</div>
