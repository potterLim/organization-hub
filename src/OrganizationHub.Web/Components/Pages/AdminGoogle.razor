@page "/admin/google"
@attribute [Authorize(Policy = OrganizationHubPolicies.GOOGLE_CONNECTION_MANAGE)]
@inject IGoogleConnectionService GoogleConnectionService
@inject IGoogleHealthCheckService GoogleHealthCheckService
@inject IGoogleWorkspaceBrowserService GoogleWorkspaceBrowserService
@inject IGoogleWorkspaceSetupService GoogleWorkspaceSetupService
@inject NavigationManager NavigationManager

<PageTitle>@OrganizationHubProduct.FormatPageTitle("Google 연결")</PageTitle>

<div class="hub-page-header">
    <div>
        <h1 class="hub-page-title">Google 연결</h1>
        <div class="hub-page-description">Google 계정을 연결하고 Drive, Calendar, 할 일 목록을 운영 화면에 연결합니다.</div>
    </div>
</div>

@if (string.IsNullOrWhiteSpace(MessageOrNull) == false)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">@MessageOrNull</MudAlert>
}

@if (string.IsNullOrWhiteSpace(mMessage) == false)
{
    <MudAlert Severity="@mMessageSeverity" Class="mb-4">@mMessage</MudAlert>
}

<div class="hub-google-layout">
    <div class="hub-google-side">
        <MudPaper Class="hub-card hub-form-card pa-4">
            <MudText Typo="Typo.h6">연결 상태</MudText>
            @if (mStatus.HasOAuthConfiguration == false)
            {
                <MudAlert Severity="Severity.Warning" Class="mb-4">OAuth Client ID와 Secret을 설정해야 연결할 수 있습니다.</MudAlert>
            }
            <div class="hub-google-status">
                <span class="@(mStatus.IsConnected ? "hub-status-pill hub-status-active" : "hub-status-pill hub-status-inactive")">@(mStatus.IsConnected ? "연결됨" : "미연결")</span>
                <div>
                    <div class="hub-google-status-title">@(mStatus.IsConnected ? mStatus.ConnectedEmail : "Google 계정 없음")</div>
                    <div class="hub-muted">@mStatus.Message</div>
                </div>
            </div>
            @if (mStatus.ConnectedAt.HasValue)
            {
                <div class="hub-google-meta">연결일 @formatDate(mStatus.ConnectedAt)</div>
            }
            <div class="hub-google-callback">
                <div class="hub-google-callback-label">OAuth 콜백 URI</div>
                <code>@getCallbackUri()</code>
            </div>
            <div class="hub-google-connect-actions">
                @if (mStatus.IsConnected)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="disconnectGoogleAsync" StartIcon="@Icons.Material.Filled.LinkOff" Class="hub-primary-action-button">연결 해제</MudButton>
                }
                else if (mStatus.HasOAuthConfiguration)
                {
                    <MudButton Href="/admin/google/connect" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Link" Class="hub-primary-action-button">계정 연결</MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="true" StartIcon="@Icons.Material.Filled.Link" Class="hub-primary-action-button">계정 연결</MudButton>
                }
            </div>
        </MudPaper>
        <MudPaper Class="hub-card hub-form-card pa-4">
            <div class="hub-google-health-heading">
                <MudText Typo="Typo.h6">연결 진단</MudText>
                <MudTooltip Text="진단 새로고침">
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Primary" Size="Size.Small" OnClick="loadHealthCheckAsync" aria-label="진단 새로고침" />
                </MudTooltip>
            </div>
            @if (mHealthItems.Count == 0)
            {
                <div class="hub-empty">표시할 진단 항목이 없습니다.</div>
            }
            else
            {
                IReadOnlyList<GoogleHealthCheckItem> attentionHealthItems = getAttentionHealthItems();
                IReadOnlyList<GoogleHealthCheckItem> healthyHealthItems = getHealthyHealthItems();
                <div class="hub-health-list">
                    <div class="hub-health-summary">
                        <span class="@("hub-health-summary-pill " + getHealthSummaryClass())">@getHealthSummaryText()</span>
                        <span>@getHealthSummaryDescription()</span>
                    </div>
                    @if (attentionHealthItems.Count == 0)
                    {
                        <div class="hub-health-row hub-health-row-muted">
                            <div class="hub-health-copy">
                                <div class="hub-health-area">진단</div>
                                <div class="hub-health-name">조치가 필요한 항목 없음</div>
                                <div class="hub-muted">정상 항목은 아래에서 필요할 때만 펼쳐 확인합니다.</div>
                            </div>
                            <span class="hub-health-pill hub-health-healthy">정상</span>
                        </div>
                    }
                    @foreach (GoogleHealthCheckItem item in attentionHealthItems)
                    {
                        <div class="hub-health-row">
                            <div class="hub-health-copy">
                                <div class="hub-health-area">@item.Area</div>
                                <div class="hub-health-name">@item.Name</div>
                                <div class="hub-muted">@item.Message</div>
                            </div>
                            <span class="@("hub-health-pill " + getHealthClass(item.Status))">@getHealthText(item.Status)</span>
                        </div>
                    }
                    @if (healthyHealthItems.Count > 0)
                    {
                        <button type="button" class="hub-health-toggle" @onclick="toggleHealthyHealthItems">
                            <span>정상 항목 @(healthyHealthItems.Count)개</span>
                            <MudIcon Icon="@(mShowHealthyHealthItems ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Size="Size.Small" />
                        </button>
                        @if (mShowHealthyHealthItems)
                        {
                            @foreach (GoogleHealthCheckItem item in healthyHealthItems)
                            {
                                <div class="hub-health-row hub-health-row-muted">
                                    <div class="hub-health-copy">
                                        <div class="hub-health-area">@item.Area</div>
                                        <div class="hub-health-name">@item.Name</div>
                                        <div class="hub-muted">@item.Message</div>
                                    </div>
                                    <span class="@("hub-health-pill " + getHealthClass(item.Status))">@getHealthText(item.Status)</span>
                                </div>
                            }
                        }
                    }
                </div>
            }
        </MudPaper>
    </div>
    <div class="hub-google-panel-stack">
        <MudPaper Class="hub-card hub-list-card pa-4">
            <div class="hub-google-panel-heading">
                <MudText Typo="Typo.h6">Drive 폴더 선택</MudText>
                <MudTooltip Text="저장된 Drive 폴더 이름과 기본 자료 위치를 정리합니다.">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(mStatus.IsConnected == false || mIsApplyingStandardDriveFolderNames)" OnClick="applyStandardDriveFolderNamesAsync" StartIcon="@Icons.Material.Filled.DriveFileRenameOutline">폴더 이름 정리</MudButton>
                </MudTooltip>
            </div>
            <div class="hub-google-toolbar">
                <MudSelect T="string" Label="저장 대상" Value="mSelectedFolderTargetKey" ValueChanged="setFolderTarget" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (GoogleFolderAssignmentOption option in mFolderAssignmentOptions)
                    {
                        <MudSelectItem T="string" Value="@option.TargetKey">@option.DisplayName</MudSelectItem>
                    }
                </MudSelect>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="loadCurrentFolderAsync" StartIcon="@Icons.Material.Filled.Refresh">새로고침</MudButton>
            </div>
            <div class="hub-google-path">
                @for (int index = 0; index < mFolderPath.Count; index++)
                {
                    GoogleDriveFolderPathItem pathItem = mFolderPath[index];
                    <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => openPathAsync(index))">@pathItem.Name</MudButton>
                    @if (index < mFolderPath.Count - 1)
                    {
                        <span>/</span>
                    }
                }
            </div>
            @if (mFolders.Count == 0)
            {
                <div class="hub-empty">표시할 하위 폴더가 없습니다.</div>
            }
            else
            {
                <MudTable Items="mFolders" Dense="true" Hover="true" Elevation="0" Class="hub-admin-table">
                    <HeaderContent>
                        <MudTh>폴더</MudTh>
                        <MudTh>수정일</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate Context="folder">
                        <MudTd DataLabel="폴더">@folder.Name</MudTd>
                        <MudTd DataLabel="수정일">@formatDate(folder.ModifiedTime)</MudTd>
                        <MudTd DataLabel="작업" Class="hub-action-cell">
                            <div class="hub-table-actions">
                                <MudTooltip Text="하위 폴더 열기">
                                    <MudIconButton Icon="@Icons.Material.Filled.FolderOpen" Color="Color.Primary" Size="Size.Small" OnClick="@(() => openFolderAsync(folder))" aria-label="하위 폴더 열기" />
                                </MudTooltip>
                                <MudTooltip Text="이 폴더로 연결">
                                    <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" OnClick="@(() => assignFolderAsync(folder))" aria-label="이 폴더로 연결" />
                                </MudTooltip>
                            </div>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>
        <MudPaper Class="hub-card hub-list-card pa-4">
            <MudText Typo="Typo.h6">Calendar 선택</MudText>
            <div class="hub-google-toolbar">
                <MudSelect T="string" Label="저장 대상" Value="mSelectedCalendarTargetKey" ValueChanged="setCalendarTarget" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (GoogleCalendarAssignmentOption option in mCalendarAssignmentOptions)
                    {
                        <MudSelectItem T="string" Value="@option.TargetKey">@option.DisplayName</MudSelectItem>
                    }
                </MudSelect>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="loadCalendarsAsync" StartIcon="@Icons.Material.Filled.Refresh">새로고침</MudButton>
            </div>
            @if (mCalendars.Count == 0)
            {
                <div class="hub-empty">표시할 캘린더가 없습니다.</div>
            }
            else
            {
                <MudTable Items="mCalendars" Dense="true" Hover="true" Elevation="0" Class="hub-admin-table">
                    <HeaderContent>
                        <MudTh>캘린더</MudTh>
                        <MudTh>권한</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate Context="calendar">
                        <MudTd DataLabel="캘린더">@calendar.Summary</MudTd>
                        <MudTd DataLabel="권한">@(calendar.IsPrimary ? "Primary" : calendar.AccessRole)</MudTd>
                        <MudTd DataLabel="작업" Class="hub-action-cell">
                            <div class="hub-table-actions">
                                <MudTooltip Text="이 캘린더로 연결">
                                    <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" OnClick="@(() => assignCalendarAsync(calendar))" aria-label="이 캘린더로 연결" />
                                </MudTooltip>
                            </div>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>
        <MudPaper Class="hub-card hub-list-card pa-4">
            <div class="hub-google-panel-heading">
                <MudText Typo="Typo.h6">할 일 목록 선택</MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(mStatus.IsConnected == false || mIsEnsuringStandardTaskLists)" OnClick="ensureStandardTaskListsAsync" StartIcon="@Icons.Material.Filled.AutoAwesomeMotion">기본 할 일 목록 만들기</MudButton>
            </div>
            <div class="hub-google-toolbar">
                <MudSelect T="string" Label="저장 대상" Value="mSelectedTaskListTargetKey" ValueChanged="setTaskListTarget" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (GoogleTaskListAssignmentOption option in mTaskListAssignmentOptions)
                    {
                        <MudSelectItem T="string" Value="@option.TargetKey">@option.DisplayName</MudSelectItem>
                    }
                </MudSelect>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="loadTaskListsAsync" StartIcon="@Icons.Material.Filled.Refresh">새로고침</MudButton>
            </div>
            @if (mTaskLists.Count == 0)
            {
                <div class="hub-empty">표시할 할 일 목록이 없습니다.</div>
            }
            else
            {
                <MudTable Items="mTaskLists" Dense="true" Hover="true" Elevation="0" Class="hub-admin-table">
                    <HeaderContent>
                        <MudTh>목록</MudTh>
                        <MudTh>ID</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate Context="taskList">
                        <MudTd DataLabel="목록">@taskList.Title</MudTd>
                        <MudTd DataLabel="ID">@taskList.ID</MudTd>
                        <MudTd DataLabel="작업" Class="hub-action-cell">
                            <div class="hub-table-actions">
                                <MudTooltip Text="이 목록으로 연결">
                                    <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" OnClick="@(() => assignTaskListAsync(taskList))" aria-label="이 목록으로 연결" />
                                </MudTooltip>
                            </div>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>
    </div>
</div>

@code
{
    [SupplyParameterFromQuery(Name = "message")]
    public string? MessageOrNull { get; set; }

    private GoogleConnectionStatus mStatus = new GoogleConnectionStatus();
    private List<GoogleDriveFolderItem> mFolders = new List<GoogleDriveFolderItem>();
    private List<GoogleCalendarListItem> mCalendars = new List<GoogleCalendarListItem>();
    private List<GoogleTaskListItem> mTaskLists = new List<GoogleTaskListItem>();
    private List<GoogleFolderAssignmentOption> mFolderAssignmentOptions = new List<GoogleFolderAssignmentOption>();
    private List<GoogleCalendarAssignmentOption> mCalendarAssignmentOptions = new List<GoogleCalendarAssignmentOption>();
    private List<GoogleTaskListAssignmentOption> mTaskListAssignmentOptions = new List<GoogleTaskListAssignmentOption>();
    private List<GoogleDriveFolderPathItem> mFolderPath = new List<GoogleDriveFolderPathItem>();
    private List<GoogleHealthCheckItem> mHealthItems = new List<GoogleHealthCheckItem>();
    private string mSelectedFolderTargetKey = string.Empty;
    private string mSelectedCalendarTargetKey = string.Empty;
    private string mSelectedTaskListTargetKey = string.Empty;
    private string mMessage = string.Empty;
    private Severity mMessageSeverity = Severity.Info;
    private bool mShowHealthyHealthItems;
    private bool mIsApplyingStandardDriveFolderNames;
    private bool mIsEnsuringStandardTaskLists;

    protected override async Task OnInitializedAsync()
    {
        resetFolderPath();
        await loadStatusAsync();
        await loadAssignmentOptionsAsync();
        if (mStatus.IsConnected)
        {
            Task healthCheckTask = loadHealthCheckAsync();
            Task currentFolderTask = loadCurrentFolderAsync();
            Task calendarsTask = loadCalendarsAsync();
            Task taskListsTask = loadTaskListsAsync();
            await Task.WhenAll(healthCheckTask, currentFolderTask, calendarsTask, taskListsTask);
            return;
        }

        await loadHealthCheckAsync();
    }

    private async Task loadStatusAsync()
    {
        mStatus = await GoogleConnectionService.GetStatusAsync(CancellationToken.None);
    }

    private async Task loadAssignmentOptionsAsync()
    {
        IReadOnlyList<GoogleFolderAssignmentOption> folderOptions = await GoogleWorkspaceSetupService.GetFolderAssignmentOptionsAsync(CancellationToken.None);
        mFolderAssignmentOptions = folderOptions.ToList();
        if (mFolderAssignmentOptions.Count > 0)
        {
            mSelectedFolderTargetKey = mFolderAssignmentOptions[0].TargetKey;
        }

        IReadOnlyList<GoogleCalendarAssignmentOption> calendarOptions = await GoogleWorkspaceSetupService.GetCalendarAssignmentOptionsAsync(CancellationToken.None);
        mCalendarAssignmentOptions = calendarOptions.ToList();
        if (mCalendarAssignmentOptions.Count > 0)
        {
            mSelectedCalendarTargetKey = mCalendarAssignmentOptions[0].TargetKey;
        }

        IReadOnlyList<GoogleTaskListAssignmentOption> taskListOptions = await GoogleWorkspaceSetupService.GetTaskListAssignmentOptionsAsync(CancellationToken.None);
        mTaskListAssignmentOptions = taskListOptions.ToList();
        if (mTaskListAssignmentOptions.Count > 0)
        {
            mSelectedTaskListTargetKey = mTaskListAssignmentOptions[0].TargetKey;
        }
    }

    private async Task loadCurrentFolderAsync()
    {
        try
        {
            GoogleDriveFolderPathItem currentFolder = mFolderPath[mFolderPath.Count - 1];
            IReadOnlyList<GoogleDriveFolderItem> folders = await GoogleWorkspaceBrowserService.ListDriveFoldersAsync(currentFolder.ID, CancellationToken.None);
            mFolders = folders.ToList();
        }
        catch (Exception exception)
        {
            mMessage = "Google Drive 폴더를 불러오지 못했습니다. " + exception.Message;
            mMessageSeverity = Severity.Error;
        }
    }

    private async Task loadCalendarsAsync()
    {
        try
        {
            IReadOnlyList<GoogleCalendarListItem> calendars = await GoogleWorkspaceBrowserService.ListCalendarsAsync(CancellationToken.None);
            mCalendars = calendars.ToList();
        }
        catch (Exception exception)
        {
            mMessage = "Google Calendar 목록을 불러오지 못했습니다. " + exception.Message;
            mMessageSeverity = Severity.Error;
        }
    }

    private async Task loadTaskListsAsync()
    {
        try
        {
            IReadOnlyList<GoogleTaskListItem> taskLists = await GoogleWorkspaceBrowserService.ListTaskListsAsync(CancellationToken.None);
            mTaskLists = taskLists.ToList();
        }
        catch (Exception exception)
        {
            mMessage = createGoogleTasksErrorMessage(exception);
            mMessageSeverity = Severity.Error;
        }
    }

    private async Task disconnectGoogleAsync()
    {
        ServiceResult result = await GoogleConnectionService.DisconnectAsync(CancellationToken.None);
        showResult(result, "Google 계정 연결이 해제되었습니다.");
        await loadStatusAsync();
        mFolders = new List<GoogleDriveFolderItem>();
        mCalendars = new List<GoogleCalendarListItem>();
        mTaskLists = new List<GoogleTaskListItem>();
        await loadHealthCheckAsync();
    }

    private async Task openFolderAsync(GoogleDriveFolderItem folder)
    {
        GoogleDriveFolderPathItem pathItem = new GoogleDriveFolderPathItem();
        pathItem.ID = folder.ID;
        pathItem.Name = folder.Name;
        mFolderPath.Add(pathItem);
        await loadCurrentFolderAsync();
    }

    private async Task openPathAsync(int index)
    {
        if (index < 0 || index >= mFolderPath.Count)
        {
            return;
        }

        mFolderPath = mFolderPath.Take(index + 1).ToList();
        await loadCurrentFolderAsync();
    }

    private async Task assignFolderAsync(GoogleDriveFolderItem folder)
    {
        ServiceResult result = await GoogleWorkspaceSetupService.AssignFolderAsync(mSelectedFolderTargetKey, folder.ID, CancellationToken.None);
        showResult(result, result.IsSuccess ? folder.Name + " 폴더를 저장했습니다." : string.Empty);
        await loadHealthCheckAsync();
    }

    private async Task assignCalendarAsync(GoogleCalendarListItem calendar)
    {
        ServiceResult result = await GoogleWorkspaceSetupService.AssignCalendarAsync(mSelectedCalendarTargetKey, calendar.ID, CancellationToken.None);
        showResult(result, result.IsSuccess ? calendar.Summary + " 캘린더를 저장했습니다." : string.Empty);
        await loadHealthCheckAsync();
    }

    private async Task assignTaskListAsync(GoogleTaskListItem taskList)
    {
        ServiceResult result = await GoogleWorkspaceSetupService.AssignTaskListAsync(mSelectedTaskListTargetKey, taskList.ID, CancellationToken.None);
        showResult(result, result.IsSuccess ? taskList.Title + " 할 일 목록을 저장했습니다." : string.Empty);
        await loadHealthCheckAsync();
    }

    private async Task applyStandardDriveFolderNamesAsync()
    {
        mIsApplyingStandardDriveFolderNames = true;
        try
        {
            ServiceResultOfT<GoogleDriveFolderNameSyncSummary> result = await GoogleWorkspaceSetupService.ApplyStandardDriveFolderNamesAsync(CancellationToken.None);
            if (result.IsSuccess && result.ValueOrNull != null)
            {
                GoogleDriveFolderNameSyncSummary summary = result.ValueOrNull;
                mMessage = "Drive 폴더 정리 완료: 이름 변경 " + summary.RenamedCount.ToString(CultureInfo.InvariantCulture) + "개, 위치 정리 " + summary.MovedCount.ToString(CultureInfo.InvariantCulture) + "개, 폴더 생성 " + summary.CreatedCount.ToString(CultureInfo.InvariantCulture) + "개, 이미 표준 " + summary.AlreadyStandardCount.ToString(CultureInfo.InvariantCulture) + "개";
                mMessageSeverity = Severity.Success;
                await loadCurrentFolderAsync();
                await loadHealthCheckAsync();
                return;
            }

            mMessage = result.ErrorMessage;
            mMessageSeverity = Severity.Error;
        }
        finally
        {
            mIsApplyingStandardDriveFolderNames = false;
        }
    }

    private async Task ensureStandardTaskListsAsync()
    {
        mIsEnsuringStandardTaskLists = true;
        try
        {
            ServiceResultOfT<GoogleTaskListSetupSummary> result = await GoogleWorkspaceSetupService.EnsureStandardTaskListsAsync(CancellationToken.None);
            if (result.IsSuccess && result.ValueOrNull != null)
            {
                GoogleTaskListSetupSummary summary = result.ValueOrNull;
                mMessage = "표준 할 일 목록 준비 완료: 생성 " + summary.CreatedCount.ToString(CultureInfo.InvariantCulture) + "개, 재사용 " + summary.ReusedCount.ToString(CultureInfo.InvariantCulture) + "개, 매핑 " + summary.AssignedCount.ToString(CultureInfo.InvariantCulture) + "개";
                mMessageSeverity = Severity.Success;
                await loadTaskListsAsync();
                await loadHealthCheckAsync();
                return;
            }

            mMessage = result.ErrorMessage;
            mMessageSeverity = Severity.Error;
        }
        finally
        {
            mIsEnsuringStandardTaskLists = false;
        }
    }

    private async Task loadHealthCheckAsync()
    {
        try
        {
            IReadOnlyList<GoogleHealthCheckItem> healthItems = await GoogleHealthCheckService.GetHealthCheckItemsAsync(CancellationToken.None);
            mHealthItems = healthItems.ToList();
            mShowHealthyHealthItems = false;
            if (mHealthItems.Count == 0)
            {
                GoogleHealthCheckItem healthCheckItem = new GoogleHealthCheckItem();
                healthCheckItem.Area = "진단";
                healthCheckItem.Name = "결과 없음";
                healthCheckItem.Status = "Warning";
                healthCheckItem.Message = "진단 항목을 만들지 못했습니다. OAuth 설정과 Google 연결 상태를 새로고침해 주세요.";
                mHealthItems.Add(healthCheckItem);
            }
        }
        catch (Exception exception)
        {
            mHealthItems = new List<GoogleHealthCheckItem>();
            GoogleHealthCheckItem healthCheckItem = new GoogleHealthCheckItem();
            healthCheckItem.Area = "진단";
            healthCheckItem.Name = "실행 오류";
            healthCheckItem.Status = "Error";
            healthCheckItem.Message = "Google 연결 진단을 실행하지 못했습니다. " + exception.Message;
            mHealthItems.Add(healthCheckItem);
            mMessage = "Google 연결 진단을 실행하지 못했습니다. " + exception.Message;
            mMessageSeverity = Severity.Error;
        }
    }

    private IReadOnlyList<GoogleHealthCheckItem> getAttentionHealthItems()
    {
        return mHealthItems.Where(item => isHealthyHealthStatus(item.Status) == false).ToList();
    }

    private IReadOnlyList<GoogleHealthCheckItem> getHealthyHealthItems()
    {
        return mHealthItems.Where(item => isHealthyHealthStatus(item.Status)).ToList();
    }

    private bool isHealthyHealthStatus(string status)
    {
        return status == "Healthy";
    }

    private void toggleHealthyHealthItems()
    {
        mShowHealthyHealthItems = !mShowHealthyHealthItems;
    }

    private string getHealthSummaryClass()
    {
        if (mHealthItems.Any(item => item.Status == "Error"))
        {
            return "hub-health-error";
        }

        if (mHealthItems.Any(item => item.Status == "Warning"))
        {
            return "hub-health-warning";
        }

        return "hub-health-healthy";
    }

    private string getHealthSummaryText()
    {
        int errorCount = mHealthItems.Count(item => item.Status == "Error");
        int warningCount = mHealthItems.Count(item => item.Status == "Warning");
        if (errorCount > 0)
        {
            return "오류 " + errorCount + "개";
        }

        if (warningCount > 0)
        {
            return "주의 " + warningCount + "개";
        }

        return "정상";
    }

    private string getHealthSummaryDescription()
    {
        int attentionCount = getAttentionHealthItems().Count;
        int healthyCount = getHealthyHealthItems().Count;
        if (attentionCount > 0)
        {
            return "먼저 확인할 항목 " + attentionCount + "개, 정상 항목 " + healthyCount + "개";
        }

        return "정상 항목 " + healthyCount + "개가 접혀 있습니다.";
    }

    private void setFolderTarget(string targetKey)
    {
        mSelectedFolderTargetKey = targetKey;
    }

    private void setCalendarTarget(string targetKey)
    {
        mSelectedCalendarTargetKey = targetKey;
    }

    private void setTaskListTarget(string targetKey)
    {
        mSelectedTaskListTargetKey = targetKey;
    }

    private string createGoogleTasksErrorMessage(Exception exception)
    {
        return GoogleApiExceptionMessageFormatter.CreateGoogleTasksMessage(exception, "Google Tasks 목록을 불러오지 못했습니다.");
    }

    private void showResult(ServiceResult result, string successMessage)
    {
        if (result.IsSuccess)
        {
            mMessage = successMessage;
            mMessageSeverity = Severity.Success;
            return;
        }

        mMessage = result.ErrorMessage;
        mMessageSeverity = Severity.Error;
    }

    private void resetFolderPath()
    {
        GoogleDriveFolderPathItem rootPathItem = new GoogleDriveFolderPathItem();
        rootPathItem.ID = "root";
        rootPathItem.Name = "내 드라이브";
        mFolderPath = new List<GoogleDriveFolderPathItem>();
        mFolderPath.Add(rootPathItem);
    }

    private string formatDate(DateTime? dateTimeOrNull)
    {
        if (dateTimeOrNull.HasValue == false)
        {
            return "-";
        }

        return dateTimeOrNull.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture);
    }

    private string getCallbackUri()
    {
        return NavigationManager.ToAbsoluteUri("/admin/google/callback").ToString();
    }

    private string getHealthClass(string status)
    {
        switch (status)
        {
            case "Healthy":
                return "hub-health-healthy";
            case "Warning":
                return "hub-health-warning";
            default:
                return "hub-health-error";
        }
    }

    private string getHealthText(string status)
    {
        switch (status)
        {
            case "Healthy":
                return "정상";
            case "Warning":
                return "주의";
            default:
                return "오류";
        }
    }
}
