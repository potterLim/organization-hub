@inject Microsoft.Extensions.Logging.ILogger<AdminGoogle> Logger
@page "/admin/google"
@attribute [Authorize(Policy = OrganizationHubPolicies.GOOGLE_CONNECTION_MANAGE)]
@inherits TimeZoneAwareOrganizationHubComponentBase
@inject IGoogleConnectionService GoogleConnectionService
@inject IGoogleHealthCheckService GoogleHealthCheckService
@inject IGoogleWorkspaceBrowserService GoogleWorkspaceBrowserService
@inject IGoogleWorkspaceSetupService GoogleWorkspaceSetupService
@inject NavigationManager NavigationManager

<PageTitle>@OrganizationHubProduct.FormatPageTitle("Google 연결")</PageTitle>

<h1 class="hub-sr-only">Google 연결</h1>

@if (string.IsNullOrWhiteSpace(MessageOrNull) == false)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">@MessageOrNull</MudAlert>
}

@if (string.IsNullOrWhiteSpace(mMessage) == false)
{
    <MudAlert Severity="@mMessageSeverity" Class="mb-4">@mMessage</MudAlert>
}

<div class="hub-google-layout">
    <div class="hub-google-side">
        <AdminGoogleConnectionCard Status="mStatus" CallbackUri="@getCallbackUri()" FormatDate="formatDate" DisconnectRequested="disconnectGoogleAsync" />
        <AdminGoogleHealthCard Items="mHealthItems" ShouldShowHealthyItems="mShouldShowHealthyItems" RefreshRequested="loadHealthCheckAsync" ToggleHealthyItemsRequested="toggleHealthyItemsVisibility" />
    </div>
    <div class="hub-google-panel-stack">
        <AdminGoogleDrivePanel State="@createDrivePanelState()" Actions="@createDrivePanelActions()" />
        <AdminGoogleCalendarPanel State="@createCalendarPanelState()" Actions="@createCalendarPanelActions()" />
        <AdminGoogleTaskListPanel State="@createTaskListPanelState()" Actions="@createTaskListPanelActions()" />
    </div>
</div>
