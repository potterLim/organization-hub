@page "/admin/users"
@attribute [Authorize(Policy = OrganizationHubPolicies.USERS_MANAGE)]
@inherits OrganizationHubComponentBase
@inject IUserManagementService UserManagementService
@inject ITeamManagementService TeamManagementService
@inject IPositionManagementService PositionManagementService

<PageTitle>@OrganizationHubProduct.FormatPageTitle("사용자 관리")</PageTitle>

<h1 class="hub-sr-only">사용자 관리</h1>

@if (string.IsNullOrWhiteSpace(mMessage) == false)
{
    <MudAlert Severity="@mMessageSeverity" Class="mb-4">@mMessage</MudAlert>
    @if (mHasSaveConflict)
    {
        <MudButton OnClick="reloadUserAsync" Color="Color.Primary" Variant="Variant.Outlined" Class="mb-4">최신 사용자 정보 불러오기</MudButton>
    }
}

<MudGrid Spacing="6" Class="hub-management-grid hub-admin-page-grid hub-user-directory">
    <MudItem xs="12" lg="12" xl="4" Class="hub-mobile-create-last" id="user-editor">
        <MudPaper Class="hub-card hub-form-card pa-4">
            <div class="hub-admin-form-heading">
                <MudText Typo="Typo.h6">@mFormTitle</MudText>
                <span>@(mFormModel.Id == 0 ? "새 계정" : "수정 중")</span>
            </div>
            <MudTextField @bind-Value="mFormModel.Username" Label="아이디 (필수)" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
            <MudTextField @bind-Value="mFormModel.DisplayName" Label="표시 이름 (필수)" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
            @if (mFormModel.Id == 0)
            {
                <MudTextField @bind-Value="mFormModel.Password" Label="초기 비밀번호 (필수)" Variant="Variant.Outlined" Margin="Margin.Dense" InputType="InputType.Password" Immediate="true" />
            }
            @if (mCanManageSystemAdmins)
            {
                <MudSwitch T="bool" @bind-Value="mIsSystemAdministratorSelected" Label="시스템 관리자" Color="Color.Warning" />
            }
            @if (mIsSystemAdministratorSelected == false)
            {
                <MudSelect T="int?" Label="팀 (필수)" Value="mFormModel.TeamId" ValueChanged="handleTeamChangedAsync" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (Team team in getSelectableTeams())
                    {
                        <MudSelectItem T="int?" Value="@team.Id">@team.DisplayName</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="int?" Label="직책 (필수)" Value="mFormModel.PositionId" ValueChanged="handlePositionChangedAsync" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(getSelectablePositions().Count == 0)">
                    @foreach (OrganizationPosition position in getSelectablePositions())
                    {
                        <MudSelectItem T="int?" Value="@position.Id">@position.Name</MudSelectItem>
                    }
                </MudSelect>
                @if (getSelectablePositions().Count == 0)
                {
                    <MudText Typo="Typo.caption" Color="Color.Warning">이 팀에는 배정 가능한 활성 직책이 없습니다.</MudText>
                }
            }
            <MudSwitch T="bool" @bind-Value="mFormModel.IsActive" Label="활성 상태" Color="Color.Primary" />
            @if (mMessageSeverity == Severity.Error && string.IsNullOrWhiteSpace(mMessage) == false)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3" role="alert">@mMessage</MudAlert>
            }
            <MudStack Row="true" Spacing="2" Class="hub-form-actions hub-form-actions-centered mt-3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="saveUserAsync" Class="hub-primary-action-button">저장</MudButton>
                @if (mFormModel.Id != 0)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="clearForm">새 사용자</MudButton>
                }
            </MudStack>
            @if (mFormModel.Id != 0)
            {
                <MudDivider Class="my-4" />
                <MudTextField @bind-Value="mResetPassword" Label="새 비밀번호" Variant="Variant.Outlined" Margin="Margin.Dense" InputType="InputType.Password" Immediate="true" />
                <div class="hub-submit-row">
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="resetPasswordAsync" Class="hub-primary-action-button">비밀번호 초기화</MudButton>
                </div>
            }
        </MudPaper>
    </MudItem>
    <MudItem xs="12" lg="12" xl="8">
        <MudPaper Class="hub-card hub-list-card pa-4">
            <div class="hub-admin-section-heading">
                <MudText Typo="Typo.h6">사용자 목록 · @getFilteredUsers().Count 명</MudText>
                <MudButton Href="/admin/users#user-editor" OnClick="clearForm" Variant="Variant.Outlined" Color="Color.Primary">새 사용자</MudButton>
            </div>
            <MudTextField @bind-Value="mUserSearch" Label="사용자 검색" Placeholder="아이디 또는 표시 이름" Immediate="true" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <div class="hub-position-selection-grid">
                <MudSelect T="int?" Label="소속 팀 필터" @bind-Value="mFilterTeamIdOrNull" Clearable="true" Placeholder="모든 팀" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (Team team in mTeams)
                    {
                        <MudSelectItem T="int?" Value="@((int?)team.Id)">@team.DisplayName</MudSelectItem>
                    }
                </MudSelect>
                <MudSelect T="string" Label="활성 상태 필터" @bind-Value="mFilterStatus" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem T="string" Value='@("all")'>전체</MudSelectItem>
                    <MudSelectItem T="string" Value='@("active")'>활성</MudSelectItem>
                    <MudSelectItem T="string" Value='@("inactive")'>비활성</MudSelectItem>
                </MudSelect>
            </div>
            <MudTable Items="getFilteredUsers()" Dense="true" Hover="true" Elevation="0" Class="hub-admin-table">
                <NoRecordsContent><MudText>조건에 맞는 사용자가 없습니다. 검색어나 필터를 변경해 주세요.</MudText></NoRecordsContent>
                <HeaderContent>
                    <MudTh>아이디</MudTh>
                    <MudTh>표시 이름</MudTh>
                    <MudTh>소속</MudTh>
                    <MudTh>직책</MudTh>
                    <MudTh>상태</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate Context="user">
                    <MudTd DataLabel="아이디 (필수)">@user.Username</MudTd>
                    <MudTd DataLabel="표시 이름 (필수)">@user.DisplayName</MudTd>
                    <MudTd DataLabel="소속">@getAffiliationName(user)</MudTd>
                    <MudTd DataLabel="직책 (필수)">@getPositionName(user)</MudTd>
                    <MudTd DataLabel="상태"><span class="@(user.IsActive ? "hub-status-pill hub-status-active" : "hub-status-pill hub-status-inactive")">@(user.IsActive ? "활성" : "비활성")</span></MudTd>
                    <MudTd DataLabel="작업" Class="hub-action-cell">
                        <div class="hub-table-actions">
                            @if (canManageUser(user))
                            {
                                <MudTooltip Text="사용자 수정">
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" Href="/admin/users#user-editor" OnClick="@(() => editUser(user))" aria-label="사용자 수정" />
                                </MudTooltip>
                                <MudTooltip Text="@(user.IsActive ? "사용자 비활성화" : "사용자 활성화")">
                                    <MudIconButton Icon="@(user.IsActive ? Icons.Material.Filled.Block : Icons.Material.Filled.CheckCircle)" Color="Color.Warning" Size="Size.Small" OnClick="@(() => toggleUserActiveAsync(user))" aria-label="@(user.IsActive ? "사용자 비활성화" : "사용자 활성화")" />
                                </MudTooltip>
                            }
                        </div>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    </MudItem>
</MudGrid>
