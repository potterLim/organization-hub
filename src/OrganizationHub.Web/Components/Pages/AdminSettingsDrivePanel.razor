<MudPaper Class="hub-card hub-list-card pa-4">
    <div class="hub-google-panel-heading">
        <div>
            <MudText Typo="Typo.h6">Drive 폴더 선택</MudText>
            <div class="hub-muted">폴더를 열어 위치를 확인하고, 선택한 폴더나 파일을 운영 설정에 연결합니다.</div>
        </div>
        <div class="hub-google-panel-actions">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => Actions.DriveRootRequested.InvokeAsync())" StartIcon="@Icons.Material.Filled.CloudQueue" Disabled="@(State.Status.IsConnected == false)">내 Drive</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => Actions.OfficialRootRequested.InvokeAsync())" StartIcon="@Icons.Material.Filled.Home" Disabled="@(State.Status.IsConnected == false || State.HasOfficialRootFolder == false)">기본 자료</MudButton>
        </div>
    </div>

    @if (State.Status.IsConnected == false)
    {
        <div class="hub-empty">Google 계정을 연결하면 Drive 폴더와 파일을 목록에서 선택할 수 있습니다.</div>
    }
    else
    {
        <div class="hub-resource-picker-grid">
            <MudSelect T="string" Label="폴더를 연결할 대상" Value="State.SelectedFolderTargetKey.GetSelectionValue()" ValueChanged="handleFolderTargetSelectionChangedAsync" Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (GoogleFolderAssignmentOption option in State.FolderAssignmentOptions)
                {
                    <MudSelectItem T="string" Value="@option.TargetSelectionValue">@option.DisplayName</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="ESettingFileAssignmentTarget" Label="파일을 연결할 대상" Value="State.SelectedFileAssignmentTarget" ValueChanged="Actions.SelectedFileAssignmentTargetChanged" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="ESettingFileAssignmentTarget" Value="ESettingFileAssignmentTarget.NoticeFile">공지 파일</MudSelectItem>
                <MudSelectItem T="ESettingFileAssignmentTarget" Value="ESettingFileAssignmentTarget.WorkGuidelineFile">업무 기준 파일</MudSelectItem>
            </MudSelect>
        </div>

        <div class="hub-selected-resource-grid">
            <div class="hub-selected-resource">
                <div class="hub-muted">선택한 폴더 대상의 현재 연결</div>
                <strong>@State.SelectedFolderAssignmentDisplayName</strong>
                <span>@State.SelectedFolderAssignmentDetail</span>
            </div>
            <div class="hub-selected-resource">
                <div class="hub-muted">선택한 파일 대상의 현재 연결</div>
                <strong>@State.SelectedFileAssignmentDisplayName</strong>
                <span>@State.SelectedFileAssignmentDetail</span>
            </div>
        </div>

        <div class="hub-google-path">
            @for (int index = 0; index < State.FolderPath.Count; index++)
            {
                int pathIndex = index;
                GoogleDriveFolderPathItem pathItem = State.FolderPath[index];
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => Actions.OpenPathRequested.InvokeAsync(pathIndex))">@pathItem.Name</MudButton>
                @if (index < State.FolderPath.Count - 1)
                {
                    <span>/</span>
                }
            }
            <MudTooltip Text="현재 폴더 새로고침">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Primary" Size="Size.Small" OnClick="@(() => Actions.RefreshRequested.InvokeAsync())" Disabled="State.IsLoadingDriveItems" aria-label="현재 폴더 새로고침" />
            </MudTooltip>
        </div>

        @if (State.IsLoadingDriveItems)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
        }
        else if (State.DriveItems.Count == 0)
        {
            <div class="hub-empty">이 위치에는 선택할 폴더나 파일이 없습니다.</div>
        }
        else
        {
            <MudTable Items="State.DriveItems" Dense="true" Hover="true" Elevation="0" Class="hub-admin-table hub-resource-picker-table">
                <HeaderContent>
                    <MudTh>이름</MudTh>
                    <MudTh>종류</MudTh>
                    <MudTh>수정일</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate Context="driveItem">
                    <MudTd DataLabel="이름">
                        <div class="hub-resource-name-cell">
                            <MudIcon Icon="@(driveItem.IsFolder ? Icons.Material.Filled.Folder : Icons.Material.Filled.Description)" Size="Size.Small" />
                            <span>@driveItem.Name</span>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="종류">@(driveItem.IsFolder ? "폴더" : State.GetFileTypeDisplayName(driveItem))</MudTd>
                    <MudTd DataLabel="수정일">@State.FormatDate(driveItem.ModifiedTime)</MudTd>
                    <MudTd DataLabel="작업" Class="hub-action-cell">
                        <div class="hub-table-actions">
                            @if (driveItem.IsFolder)
                            {
                                <MudTooltip Text="폴더 열기">
                                    <MudIconButton Icon="@Icons.Material.Filled.FolderOpen" Color="Color.Primary" Size="Size.Small" OnClick="@(() => Actions.OpenFolderRequested.InvokeAsync(driveItem))" aria-label="폴더 열기" />
                                </MudTooltip>
                                <MudTooltip Text="이 폴더로 연결">
                                    <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" OnClick="@(() => Actions.AssignFolderRequested.InvokeAsync(driveItem))" aria-label="이 폴더로 연결" />
                                </MudTooltip>
                            }
                            else
                            {
                                <MudTooltip Text="이 파일로 연결">
                                    <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" OnClick="@(() => Actions.AssignFileRequested.InvokeAsync(driveItem))" aria-label="이 파일로 연결" />
                                </MudTooltip>
                            }
                        </div>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    }
</MudPaper>

@code {
    [Parameter]
    public AdminSettingsDrivePanelState State
    {
        get; set;
    } = new AdminSettingsDrivePanelState();

    [Parameter]
    public AdminSettingsDrivePanelActions Actions
    {
        get; set;
    } = new AdminSettingsDrivePanelActions();

    private async Task handleFolderTargetSelectionChangedAsync(string targetSelectionValue)
    {
        GoogleWorkspaceAssignmentTargetKey targetKey = GoogleWorkspaceAssignmentTargetKey.FromSelectionValue(targetSelectionValue);
        await Actions.SelectedFolderTargetKeyChanged.InvokeAsync(targetKey);
    }
}
