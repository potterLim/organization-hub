<div class="hub-calendar-month-grid">
    @foreach (string weekdayLabel in WeekdayLabels)
    {
        <div class="hub-calendar-weekday">@weekdayLabel</div>
    }
    @foreach (CalendarDayCell dayCell in DayCells)
    {
        <button type="button" class="@getCalendarDayCellClass(dayCell)" @onclick="@(() => DaySelected.InvokeAsync(dayCell))" aria-label="@getDaySummaryLabel(dayCell)" aria-pressed="@isSelectedDay(dayCell).ToString().ToLowerInvariant()">
            <div class="hub-calendar-day-date">
                <span class="hub-calendar-day-number">@dayCell.Date.Day</span>
                <span class="hub-calendar-day-badges">
                    @if (dayCell.Events.Count > 0)
                    {
                        <span class="hub-calendar-day-count">@getDayEventCountText(dayCell)</span>
                    }
                </span>
            </div>
            @if (dayCell.Events.Count > 0)
            {
                <div class="hub-calendar-day-time-list">
                    @foreach (CalendarEventItem calendarEvent in getDayTimeEvents(dayCell))
                    {
                        <span class="hub-calendar-day-time-line">@formatCalendarChipTime(calendarEvent)</span>
                    }
                </div>
            }
        </button>
    }
</div>

@code {
    [Parameter]
    public IReadOnlyList<CalendarDayCell> DayCells
    {
        get; set;
    } = new List<CalendarDayCell>();

    [Parameter]
    public IReadOnlyList<string> WeekdayLabels
    {
        get; set;
    } = new List<string>();

    [Parameter]
    public DateTime? SelectedDayOrNull
    {
        get; set;
    }

    [Parameter]
    public TimeZoneInfo ClientTimeZoneInfo
    {
        get; set;
    } = TimeZoneInfo.Local;

    [Parameter]
    public EventCallback<CalendarDayCell> DaySelected
    {
        get; set;
    }

    private string getCalendarDayCellClass(CalendarDayCell dayCell)
    {
        string className = "hub-calendar-day";
        if (dayCell.IsCurrentMonth == false)
        {
            className += " hub-calendar-day-muted";
        }

        if (dayCell.IsToday)
        {
            className += " hub-calendar-day-today";
        }

        if (isSelectedDay(dayCell))
        {
            className += " hub-calendar-day-selected";
        }

        if (dayCell.Events.Count > 0)
        {
            className += " hub-calendar-day-has-events";
        }

        return className;
    }

    private bool isSelectedDay(CalendarDayCell dayCell)
    {
        return SelectedDayOrNull.HasValue && SelectedDayOrNull.Value.Date == dayCell.Date.Date;
    }

    private IReadOnlyList<CalendarEventItem> getDayTimeEvents(CalendarDayCell dayCell)
    {
        return dayCell.Events;
    }

    private string getDayEventCountText(CalendarDayCell dayCell)
    {
        return dayCell.Events.Count.ToString(CultureInfo.InvariantCulture) + "건";
    }

    private string getDaySummaryLabel(CalendarDayCell dayCell)
    {
        return dayCell.Date.ToString("M월 d일", CultureInfo.InvariantCulture) + " 일정 " + getDayEventCountText(dayCell) + " 보기";
    }

    private string formatCalendarChipTime(CalendarEventItem calendarEvent)
    {
        if (calendarEvent.Start.HasValue == false)
        {
            return "시간";
        }

        if (calendarEvent.IsAllDay)
        {
            return "종일";
        }

        DateTime localStart = ClientTimeZoneUtility.createClientDateTime(calendarEvent.Start.Value.UtcDateTime, ClientTimeZoneInfo);
        return localStart.ToString("HH:mm", CultureInfo.InvariantCulture);
    }
}
