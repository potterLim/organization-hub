@page "/admin/teams"
@attribute [Authorize(Policy = OrganizationHubPolicies.ORGANIZATION_MANAGE)]
@implements IAsyncDisposable
@inject ITeamManagementService TeamManagementService
@inject IJSRuntime JavaScriptRuntime

<PageTitle>@OrganizationHubProduct.FormatPageTitle("팀 관리")</PageTitle>

<div class="hub-page-header">
    <div>
        <h1 class="hub-page-title">팀 관리</h1>
        <div class="hub-page-description">조직에서 사용할 팀을 만들고, 목록에서 드래그해 표시 순서를 정합니다.</div>
    </div>
</div>

@if (string.IsNullOrWhiteSpace(mMessage) == false)
{
    <MudAlert Severity="@mMessageSeverity" Class="mb-4">@mMessage</MudAlert>
}

<MudGrid Spacing="6" Class="hub-management-grid hub-admin-page-grid">
    <MudItem xs="12" lg="5" xl="4">
        <MudPaper Class="hub-card hub-form-card pa-4">
            <div class="hub-admin-form-heading">
                <MudText Typo="Typo.h6">@mFormTitle</MudText>
                <span>@(mFormModel.Id == 0 ? "새 팀" : "수정 중")</span>
            </div>
            <div class="hub-form-hint">
                <span>팀 이름은 사용자 화면에 그대로 표시됩니다.</span>
                <span>고유 코드는 영문과 숫자로 짧게 정하면 관리하기 쉽습니다.</span>
            </div>
            <MudTextField @bind-Value="mFormModel.DisplayName" Label="팀 이름" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
            <MudTextField @bind-Value="mFormModel.TeamKey" Label="팀 고유 코드" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
            <MudSwitch T="bool" @bind-Value="mFormModel.IsActive" Label="활성 상태" Color="Color.Primary" />
            <MudExpansionPanels Elevation="0" Class="hub-advanced-settings hub-team-advanced-settings">
                <MudExpansionPanel Text="고급: 이 팀의 Google 연결 ID">
                    <div class="hub-form-hint">
                        <span>대부분은 Google 연결 메뉴에서 목록을 선택하면 됩니다.</span>
                        <span>정확한 ID를 직접 입력해야 할 때만 수정하세요.</span>
                    </div>
                    <SettingIdField @bind-Value="mFormModel.MaterialsFolderId" Label="팀 자료 폴더 ID" />
                    <SettingIdField @bind-Value="mFormModel.ApprovedFolderId" Label="결재 완료 자료 폴더 ID" />
                    <SettingIdField @bind-Value="mFormModel.CalendarId" Label="Calendar ID" />
                    <SettingIdField @bind-Value="mFormModel.TaskListId" Label="Google Tasks 목록 ID" />
                </MudExpansionPanel>
            </MudExpansionPanels>
            <MudStack Row="true" Spacing="2" Class="hub-form-actions hub-form-actions-centered mt-3">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="saveTeamAsync" Class="hub-primary-action-button">저장</MudButton>
                @if (mFormModel.Id != 0)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="clearForm">새 팀</MudButton>
                }
            </MudStack>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" lg="7" xl="8">
        <MudPaper Class="hub-card hub-list-card pa-4">
            <div class="hub-admin-section-heading">
                <div>
                    <MudText Typo="Typo.h6">팀 목록</MudText>
                    <div class="hub-muted">사용자 화면과 선택 목록에 보일 순서대로 드래그합니다.</div>
                </div>
            </div>
            <div @ref="mSortableRootElement" class="hub-sortable-list" data-sortable-list>
                @foreach (Team team in mTeams)
                {
                    <div class="hub-sortable-row" data-sortable-item-id="@team.Id" draggable="true">
                        <span class="hub-sortable-handle" role="button" aria-label="팀 순서 변경">
                            <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" />
                        </span>
                        <div class="hub-sortable-main">
                            <div class="hub-sortable-title">@team.DisplayName</div>
                            <div class="hub-sortable-meta">
                                <span>@team.TeamKey</span>
                                <span>·</span>
                                <span>@(team.UserAccounts.Count)명</span>
                            </div>
                        </div>
                        <div class="hub-sortable-actions">
                            <span class="hub-sortable-status @(team.IsActive ? "hub-status-pill hub-status-active" : "hub-status-pill hub-status-inactive")">@(team.IsActive ? "활성" : "비활성")</span>
                            <MudTooltip Text="팀 수정">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" OnClick="@(() => editTeam(team))" aria-label="팀 수정" />
                            </MudTooltip>
                            <MudTooltip Text="@(team.IsActive ? "팀 비활성화" : "팀 활성화")">
                                <MudIconButton Icon="@(team.IsActive ? Icons.Material.Filled.Block : Icons.Material.Filled.CheckCircle)" Color="Color.Warning" Size="Size.Small" OnClick="@(() => toggleTeamActiveAsync(team))" aria-label="@(team.IsActive ? "팀 비활성화" : "팀 활성화")" />
                            </MudTooltip>
                        </div>
                    </div>
                }
            </div>
        </MudPaper>
    </MudItem>
</MudGrid>
