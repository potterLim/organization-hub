@page "/calendar"
@attribute [Authorize]
@inherits OrganizationHubComponentBase
@implements IAsyncDisposable
@inject IPermissionService PermissionService
@inject ICalendarService CalendarService
@inject ICalendarEventDeletionAuditLogService CalendarEventDeletionAuditLogService
@inject IGlobalSettingService GlobalSettingService
@inject IChangeVersionService ChangeVersionService
@inject IClientTimeZoneService ClientTimeZoneService
@inject NavigationManager NavigationManager
@inject IJSRuntime JavaScriptRuntime

<PageTitle>@OrganizationHubProduct.FormatPageTitle("일정")</PageTitle>

<div @ref="mRefreshScopeElement">
    <h1 class="hub-sr-only">일정</h1>
</div>

<MudPaper Class="hub-card hub-calendar-toolbar pa-4 mb-4">
    <div class="hub-calendar-toolbar-layout">
        <div class="hub-calendar-selector-wrap">
            <MudSelect T="string" Label="일정 선택" Value="mSelectedCalendarId" ValueChanged="handleCalendarChangedAsync" Variant="Variant.Outlined" Margin="Margin.Dense" Class="hub-control-select-width">
                @foreach (CalendarReference calendar in mCalendars)
                {
                    <MudSelectItem T="string" Value="@calendar.CalendarId.GetRequiredValue()">@calendar.DisplayName</MudSelectItem>
                }
            </MudSelect>
        </div>
        <div class="hub-calendar-toolbar-actions">
            <div class="hub-calendar-period-control">
                <MudTooltip Text="이전 달">
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Color="Color.Primary" OnClick="movePreviousMonthAsync" aria-label="이전 달" />
                </MudTooltip>
                <span class="hub-calendar-period-label">@mCurrentMonth.ToString("yyyy년 MM월", CultureInfo.InvariantCulture)</span>
                <MudTooltip Text="다음 달">
                    <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Color="Color.Primary" OnClick="moveNextMonthAsync" aria-label="다음 달" />
                </MudTooltip>
            </div>
            <div class="hub-calendar-view-switch" aria-label="일정 보기 방식">
                <button type="button" class="@getCalendarViewButtonClass(ECalendarDisplayMode.List)" @onclick="@(() => setCalendarDisplayModeAsync(ECalendarDisplayMode.List))">목록</button>
                <button type="button" class="@getCalendarViewButtonClass(ECalendarDisplayMode.Month)" @onclick="@(() => setCalendarDisplayModeAsync(ECalendarDisplayMode.Month))">달력</button>
            </div>
            <div class="hub-calendar-inline-actions">
                @if (mCreatableCalendars.Count > 0)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="openCreateEditor" StartIcon="@Icons.Material.Filled.Add">일정 추가</MudButton>
                }
                @if (mHasExternalChanges)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Sync" OnClick="loadEventsAsync" Class="hub-freshness-button">새 내용</MudButton>
                }
                <MudTooltip Text="새로고침">
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Primary" OnClick="loadEventsAsync" Disabled="mIsLoading" aria-label="새로고침" />
                </MudTooltip>
            </div>
        </div>
    </div>
</MudPaper>

@if (mDeleteCandidateOrNull != null)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        <div class="hub-delete-confirm">
            <span>@mDeleteCandidateOrNull.Summary 일정을 삭제할까요?</span>
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="deleteSelectedEventAsync">삭제</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="cancelDelete">취소</MudButton>
            </MudStack>
        </div>
    </MudAlert>
}

@if (mIsLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (string.IsNullOrWhiteSpace(mErrorMessage) == false && mIsEditorOpen == false)
{
    <MudAlert Severity="Severity.Warning">@mErrorMessage</MudAlert>
}
else if (mCalendars.Any(calendar => calendar.CalendarId.IsAggregate == false) == false)
{
    <MudPaper Class="hub-card hub-empty-card pa-5">
        <AuthorizeView Policy="@OrganizationHubPolicies.SYSTEM_SETTINGS_MANAGE">
            <Authorized><ResourceStateMessage Icon="@Icons.Material.Filled.CalendarMonth" Title="연결된 캘린더가 없습니다." Description="조직이나 팀에서 사용할 캘린더를 연결해 주세요." ActionLabel="캘린더 연결" ActionHref="/admin/settings?section=calendar" /></Authorized>
            <NotAuthorized><ResourceStateMessage Icon="@Icons.Material.Filled.CalendarMonth" Title="연결된 캘린더가 없습니다." Description="조직 관리자에게 내 팀의 캘린더 연결과 열람 권한을 확인해 달라고 요청해 주세요." ActionLabel="홈으로" ActionHref="/dashboard" /></NotAuthorized>
        </AuthorizeView>
    </MudPaper>
}
else
{
    <MudGrid Spacing="5" Class="hub-calendar-grid hub-calendar-workspace">
        <MudItem xs="12" lg="4" Class="hub-calendar-sidebar">
            <MudPaper Class="hub-card pa-4 mb-4">
                <MudText Typo="Typo.h6">이번 주 일정</MudText>
                @if (mWeekEvents.Count == 0)
                {
                    <div class="hub-empty hub-empty-state">
                        <MudIcon Icon="@Icons.Material.Filled.EventBusy" Size="Size.Medium" />
                        <span>이번 주 일정이 없습니다.</span>
                    </div>
                }
                else
                {
                    <div class="hub-calendar-week-list">
                        @foreach (CalendarEventItem calendarEvent in mWeekEvents)
                        {
                            string calendarEventMeta = formatCalendarEventMeta(calendarEvent);
                            string calendarEventLocationMeta = formatCalendarEventLocationMeta(calendarEvent);
                            <button type="button" class="@getCalendarListItemClass(calendarEvent)" data-event-id="@calendarEvent.Id" @onclick="@(() => selectEvent(calendarEvent))">
                                <div class="hub-calendar-list-item-head">
                                    <MudText Typo="Typo.body2" Class="hub-list-title">@calendarEvent.Summary</MudText>
                                    <span class="hub-list-side hub-calendar-list-item-time">@formatEventTime(calendarEvent)</span>
                                </div>
                                @if (string.IsNullOrWhiteSpace(calendarEventMeta) == false || string.IsNullOrWhiteSpace(calendarEventLocationMeta) == false)
                                {
                                    <div class="hub-calendar-list-meta-row">
                                        @if (string.IsNullOrWhiteSpace(calendarEventMeta) == false)
                                        {
                                            <MudText Typo="Typo.caption" Class="hub-list-meta">@calendarEventMeta</MudText>
                                        }
                                        @if (string.IsNullOrWhiteSpace(calendarEventLocationMeta) == false)
                                        {
                                            <MudText Typo="Typo.caption" Class="hub-list-meta hub-calendar-list-meta-trailing">@calendarEventLocationMeta</MudText>
                                        }
                                    </div>
                                }
                            </button>
                        }
                    </div>
                }
            </MudPaper>
            <MudPaper Class="hub-card hub-calendar-detail-card pa-4">
                @if (mIsEditorOpen)
                {
                    <div class="hub-section-heading">
                        <MudText Typo="Typo.h6">@(mIsEditing ? "일정 수정" : "일정 추가")</MudText>
                    </div>
                    @if (string.IsNullOrWhiteSpace(mEditorMessage) == false)
                    {
                        <MudAlert Severity="Severity.Warning" Class="mb-3">@mEditorMessage</MudAlert>
                    }
                    <div class="hub-calendar-editor-stack">
                        <MudSelect T="string" Label="저장 위치" Value="mEditorCalendarId" ValueChanged="handleEditorCalendarChangedAsync" Disabled="mIsEditing" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (CalendarReference calendar in (mIsEditing ? mWritableCalendars : mCreatableCalendars))
                            {
                                <MudSelectItem T="string" Value="@calendar.CalendarId.GetRequiredValue()">@calendar.DisplayName</MudSelectItem>
                            }
                        </MudSelect>
                        <MudTextField @bind-Value="mEditorSummary" Label="일정 제목" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                        <div class="hub-calendar-date-time-grid">
                            <CalendarDateTimeField Label="시작"
                                                   Value="mEditorStartLocalOrNull"
                                                   ValueChanged="handleEditorStartChangedAsync"
                                                   CurrentDateOrNull="@getClientToday()"
                                                   IsTimeSelectionEnabled="@(!mIsEditorAllDay)"
                                                   IsOpen="@(mOpenEditorDateTimeFieldOrNull == ECalendarEditorDateTimeField.Start)"
                                                   IsOpenChanged="@((bool isOpen) => handleEditorDateTimeFieldOpenChangedAsync(ECalendarEditorDateTimeField.Start, isOpen))" />
                            <CalendarDateTimeField Label="종료"
                                                   Value="mEditorEndLocalOrNull"
                                                   ValueChanged="handleEditorEndChangedAsync"
                                                   MinimumValueOrNull="mEditorStartLocalOrNull"
                                                   CurrentDateOrNull="@getClientToday()"
                                                   IsTimeSelectionEnabled="@(!mIsEditorAllDay)"
                                                   IsOpen="@(mOpenEditorDateTimeFieldOrNull == ECalendarEditorDateTimeField.End)"
                                                   IsOpenChanged="@((bool isOpen) => handleEditorDateTimeFieldOpenChangedAsync(ECalendarEditorDateTimeField.End, isOpen))" />
                        </div>
                        <MudSwitch T="bool" @bind-Value="mIsEditorAllDay" Label="종일 일정" Color="Color.Primary" />
                        <MudTextField @bind-Value="mEditorLocation" Label="위치" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                        <MudTextField @bind-Value="mEditorDescription" Label="설명" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3" Immediate="true" />
                    </div>
                    <MudStack Row="true" Spacing="2" Class="hub-form-actions hub-form-actions-centered mt-3">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="saveEventAsync" StartIcon="@Icons.Material.Filled.Save" Class="hub-primary-action-button">저장</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="closeEditor">취소</MudButton>
                    </MudStack>
                }
                else if (mSelectedEventOrNull != null)
                {
                    <div class="hub-calendar-selected-head">
                        <div class="hub-calendar-selected-title-group">
                            <MudText Typo="Typo.h6">@mSelectedEventOrNull.Summary</MudText>
                            @if (shouldShowCalendarName(mSelectedEventOrNull))
                            {
                                <span class="hub-calendar-selected-calendar">@mSelectedEventOrNull.CalendarName</span>
                            }
                        </div>
                        <MudTooltip Text="닫기">
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" Size="Size.Small" OnClick="clearSelectedEvent" Class="hub-calendar-detail-close" aria-label="일정 상세 닫기" />
                        </MudTooltip>
                    </div>
                    <div class="hub-calendar-detail-list">
                        <div>
                            <span>일시</span>
                            <strong>@formatEventTime(mSelectedEventOrNull)</strong>
                        </div>
                        @if (shouldShowCalendarAuthor(mSelectedEventOrNull))
                        {
                            <div>
                                <span>작성자</span>
                                <strong>@mSelectedEventOrNull.CreatedByDisplayName</strong>
                            </div>
                        }
                        @if (string.IsNullOrWhiteSpace(mSelectedEventOrNull.Location) == false)
                        {
                            <div>
                                <span>위치</span>
                                <strong>@mSelectedEventOrNull.Location</strong>
                            </div>
                        }
                        @if (string.IsNullOrWhiteSpace(mSelectedEventOrNull.Description) == false)
                        {
                            <div>
                                <span>설명</span>
                                <strong>@mSelectedEventOrNull.Description</strong>
                            </div>
                        }
                    </div>
                    @if (mSelectedEventOrNull.CanEdit || mSelectedEventOrNull.CanDelete)
                    {
                        <div class="hub-calendar-detail-actions">
                            @if (mSelectedEventOrNull.CanEdit)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => openEditEditor(mSelectedEventOrNull))" StartIcon="@Icons.Material.Filled.EditCalendar" Class="hub-primary-action-button">수정</MudButton>
                            }
                            @if (mSelectedEventOrNull.CanDelete)
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => requestDelete(mSelectedEventOrNull))" Class="hub-calendar-detail-danger-action">삭제</MudButton>
                            }
                        </div>
                    }
                }
                else if (mSelectedDayOrNull.HasValue)
                {
                    IReadOnlyList<CalendarEventItem> selectedDayEvents = getSelectedDayEvents();
                    <div class="hub-calendar-selected-head">
                        <div class="hub-calendar-selected-title-group">
                            <MudText Typo="Typo.h6">@formatSelectedDayTitle()</MudText>
                            <span class="hub-calendar-selected-calendar">@selectedDayEvents.Count.ToString(CultureInfo.InvariantCulture)건</span>
                        </div>
                        <MudTooltip Text="닫기">
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default" Size="Size.Small" OnClick="clearSelectedDay" Class="hub-calendar-detail-close" aria-label="날짜별 일정 닫기" />
                        </MudTooltip>
                    </div>
                    @if (selectedDayEvents.Count == 0)
                    {
                        <div class="hub-empty hub-empty-state hub-calendar-detail-empty">
                            <MudIcon Icon="@Icons.Material.Filled.EventBusy" Size="Size.Medium" />
                            <span>이 날짜의 일정이 없습니다.</span>
                        </div>
                    }
                    else
                    {
                        <div class="hub-calendar-day-detail-list">
                            @foreach (CalendarEventItem calendarEvent in selectedDayEvents)
                            {
                                string calendarDayDetailMeta = formatCalendarDayDetailMeta(calendarEvent);
                                string calendarDayDetailLocationMeta = formatCalendarDayDetailLocationMeta(calendarEvent);
                                <button type="button" class="@getCalendarDayDetailItemClass(calendarEvent)" data-event-id="@calendarEvent.Id" @onclick="@(() => selectEvent(calendarEvent))">
                                    <div class="hub-calendar-day-detail-title-row">
                                        <strong class="hub-list-title">@calendarEvent.Summary</strong>
                                        <span class="hub-list-side hub-calendar-day-detail-time">@formatCalendarDayDetailTime(calendarEvent)</span>
                                    </div>
                                    @if (string.IsNullOrWhiteSpace(calendarDayDetailMeta) == false || string.IsNullOrWhiteSpace(calendarDayDetailLocationMeta) == false)
                                    {
                                        <div class="hub-calendar-day-detail-meta-row">
                                            @if (string.IsNullOrWhiteSpace(calendarDayDetailMeta) == false)
                                            {
                                                <small class="hub-list-meta">@calendarDayDetailMeta</small>
                                            }
                                            @if (string.IsNullOrWhiteSpace(calendarDayDetailLocationMeta) == false)
                                            {
                                                <small class="hub-list-meta hub-calendar-day-detail-meta-trailing">@calendarDayDetailLocationMeta</small>
                                            }
                                        </div>
                                    }
                                </button>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="hub-empty hub-empty-state hub-calendar-detail-empty">
                        <MudIcon Icon="@Icons.Material.Filled.TouchApp" Size="Size.Medium" />
                        <span>날짜나 일정을 선택해 주세요.</span>
                    </div>
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" lg="8">
            <CalendarMonthPanel MonthEvents="mMonthEvents"
                                DayCells="mCalendarDayCells"
                                WeekdayLabels="mCalendarWeekdayLabels"
                                IsMonthView="mIsCalendarMonthView"
                                SelectedDayOrNull="mSelectedDayOrNull"
                                ShouldShowCalendarName="shouldShowCalendarName()"
                                ShouldShowCalendarAuthor="mShouldShowCalendarAuthor"
                                ClientTimeZoneInfo="mClientTimeZoneInfo"
                                SelectedEventOrNull="mSelectedEventOrNull"
                                DaySelected="selectDay"
                                EventSelected="selectEvent"
                                EventEditRequested="openEditEditor"
                                EventDeleteRequested="requestDelete" />
        </MudItem>
    </MudGrid>
}
