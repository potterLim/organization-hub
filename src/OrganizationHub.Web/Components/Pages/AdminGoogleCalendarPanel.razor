<MudPaper Class="hub-card hub-list-card pa-4">
    <div class="hub-google-panel-heading">
        <div class="hub-google-panel-title">
            <span class="hub-google-panel-icon">
                <MudIcon Icon="@Icons.Material.Filled.EventAvailable" Size="Size.Small" />
            </span>
            <MudText Typo="Typo.h6">Calendar 연결 대상</MudText>
        </div>
        <div class="hub-google-panel-actions">
            <MudTooltip Text="기본 Calendar 만들기">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(State.Status.IsConnected == false || State.IsEnsuringStandardCalendars)" OnClick="@(() => Actions.EnsureStandardCalendarsRequested.InvokeAsync())" StartIcon="@Icons.Material.Filled.EventAvailable">Calendar 만들기</MudButton>
            </MudTooltip>
        </div>
    </div>
    <div class="hub-google-toolbar">
        <MudSelect T="string" Label="연결할 대상" Value="State.SelectedCalendarTargetKey.GetSelectionValue()" ValueChanged="handleCalendarTargetSelectionChangedAsync" Variant="Variant.Outlined" Margin="Margin.Dense">
            @foreach (GoogleCalendarAssignmentOption option in State.CalendarAssignmentOptions)
            {
                <MudSelectItem T="string" Value="@option.TargetSelectionValue">@option.DisplayName</MudSelectItem>
            }
        </MudSelect>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="toggleCalendarPicker" StartIcon="@(mIsCalendarPickerVisible ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Disabled="@(State.Status.IsConnected == false)">@(mIsCalendarPickerVisible ? "목록 닫기" : "Calendar 선택")</MudButton>
    </div>
    <div class="hub-resource-picker-shell">
        <div class="hub-resource-picker-header">
            <div>
                <strong>Calendar 목록</strong>
            </div>
            <div class="hub-resource-picker-actions">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => Actions.RefreshRequested.InvokeAsync())" StartIcon="@Icons.Material.Filled.Refresh" Disabled="@(State.Status.IsConnected == false)">새로고침</MudButton>
            </div>
        </div>
        @if (mIsCalendarPickerVisible)
        {
            @if (State.Calendars.Count == 0)
            {
                <div class="hub-empty">표시할 Calendar가 없습니다.</div>
            }
            else
            {
                <MudTable Items="State.Calendars" Dense="true" Hover="true" Elevation="0" Class="hub-admin-table">
                    <HeaderContent>
                        <MudTh>Calendar</MudTh>
                        <MudTh>권한</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate Context="calendar">
                        <MudTd DataLabel="Calendar">@calendar.Summary</MudTd>
                        <MudTd DataLabel="권한">@State.GetCalendarAccessDisplayName(calendar)</MudTd>
                        <MudTd DataLabel="작업" Class="hub-action-cell">
                            <div class="hub-table-actions">
                                <MudTooltip Text="이 Calendar로 연결">
                                    <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" OnClick="@(() => Actions.AssignCalendarRequested.InvokeAsync(calendar))" aria-label="이 Calendar로 연결" />
                                </MudTooltip>
                            </div>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        }
    </div>
</MudPaper>

@code {
    [Parameter]
    public AdminGoogleCalendarPanelState State
    {
        get; set;
    } = new AdminGoogleCalendarPanelState();

    [Parameter]
    public AdminGoogleCalendarPanelActions Actions
    {
        get; set;
    } = new AdminGoogleCalendarPanelActions();

    private bool mIsCalendarPickerVisible;

    private async Task handleCalendarTargetSelectionChangedAsync(string targetSelectionValue)
    {
        GoogleWorkspaceAssignmentTargetKey targetKey = GoogleWorkspaceAssignmentTargetKey.FromSelectionValue(targetSelectionValue);
        await Actions.SelectedCalendarTargetKeyChanged.InvokeAsync(targetKey);
    }

    private void toggleCalendarPicker()
    {
        mIsCalendarPickerVisible = mIsCalendarPickerVisible == false;
    }
}
