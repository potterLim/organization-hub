<MudPaper Class="hub-card hub-form-card hub-approval-line-card pa-4">
    <div class="hub-approval-line-head">
        <MudText Typo="Typo.h6">결재 정보</MudText>
        <MudText Typo="Typo.body2" Class="hub-muted">요청 제목과 결재 단계를 확인합니다.</MudText>
    </div>
    <MudTextField T="string" Value="@FormModel.Title" ValueChanged="TitleChanged" Label="요청 제목 (선택 · 미입력 시 파일명)" Placeholder="@SuggestedTitle" Variant="Variant.Outlined" Margin="Margin.Dense" />
    <MudSelect T="int" Label="결재 단계" Value="FormModel.StepCount" ValueChanged="StepCountChanged" Variant="Variant.Outlined" Margin="Margin.Dense" HelperText="@StepDescription">
        @foreach (ApprovalStepCount stepCount in CreateContext.AvailableStepCounts)
        {
            <MudSelectItem T="int" Value="@stepCount.GetRequiredValue()">@GetApprovalStepLabel(stepCount)</MudSelectItem>
        }
    </MudSelect>
    <div class="hub-approval-approver-fields">
        @if (FormModel.StepCount >= 2)
        {
            <MudSelect @key="@("first-" + FormModel.StepCount)" T="int" Label="@getApproverSelectLabel(ApprovalStepNumber.CreateFirstApproverStep())" Value="FormModel.FirstApproverUserId" ValueChanged="FirstApproverChanged" Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (ApprovalUserOption userOption in FirstApproverOptions)
                {
                    <MudSelectItem T="int" Value="@userOption.UserId">@userOption.GetDisplayLabel()</MudSelectItem>
                }
            </MudSelect>
        }
        @if (FormModel.StepCount == 3)
        {
            <MudSelect @key="@("second-" + FormModel.StepCount)" T="int" Label="@getApproverSelectLabel(ApprovalStepNumber.CreateSecondApproverStep())" Value="FormModel.SecondApproverUserId" ValueChanged="SecondApproverChanged" Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (ApprovalUserOption userOption in SecondApproverOptions)
                {
                    <MudSelectItem T="int" Value="@userOption.UserId">@userOption.GetDisplayLabel()</MudSelectItem>
                }
            </MudSelect>
        }
        <MudSelect @key="@("final-" + FormModel.StepCount)" T="int" Label="@getApproverSelectLabel(FormModel.StepCountValue.GetRequiredStepCount().GetFinalStepNumber())" Value="FormModel.FinalApproverUserId" ValueChanged="FinalApproverChanged" Variant="Variant.Outlined" Margin="Margin.Dense">
            @foreach (ApprovalUserOption userOption in FinalApproverOptions)
            {
                <MudSelectItem T="int" Value="@userOption.UserId">@userOption.GetDisplayLabel()</MudSelectItem>
            }
        </MudSelect>
    </div>
    @if (string.IsNullOrWhiteSpace(FormModel.FileId) == false)
    {
        <dl class="hub-approval-submission-summary">
            <div><dt>선택 문서</dt><dd>@SelectedFileName</dd></div>
            <div><dt>원본 위치</dt><dd>@SourceFolderPath</dd></div>
            <div><dt>승인본 저장 위치</dt><dd>@DestinationFolderPath</dd></div>
        </dl>
    }
    <div class="hub-submit-row">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Approval" Disabled="@(IsSubmitting || string.IsNullOrWhiteSpace(FormModel.FileId))" OnClick="@(() => SubmitRequested.InvokeAsync())" Class="hub-primary-action-button hub-approval-submit-button">결재 요청 보내기</MudButton>
    </div>
    @if (string.IsNullOrWhiteSpace(FormModel.FileId))
    {
        <MudText Typo="Typo.caption" Class="hub-muted hub-approval-submit-hint">결재할 파일을 먼저 선택해 주세요.</MudText>
    }
</MudPaper>

@code {
    [Parameter]
    public ApprovalRequestFormModel FormModel
    {
        get; set;
    } = new ApprovalRequestFormModel();

    [Parameter]
    public ApprovalCreateContext CreateContext
    {
        get; set;
    } = new ApprovalCreateContext();

    [Parameter]
    public IReadOnlyList<ApprovalUserOption> FirstApproverOptions
    {
        get; set;
    } = new List<ApprovalUserOption>();

    [Parameter]
    public IReadOnlyList<ApprovalUserOption> SecondApproverOptions
    {
        get; set;
    } = new List<ApprovalUserOption>();

    [Parameter]
    public IReadOnlyList<ApprovalUserOption> FinalApproverOptions
    {
        get; set;
    } = new List<ApprovalUserOption>();

    [Parameter]
    public string StepDescription
    {
        get; set;
    } = string.Empty;

    [Parameter]
    public string SelectedFileName { get; set; } = string.Empty;

    [Parameter]
    public string SourceFolderPath { get; set; } = string.Empty;

    [Parameter]
    public string DestinationFolderPath { get; set; } = string.Empty;

    [Parameter]
    public string SuggestedTitle
    {
        get; set;
    } = string.Empty;

    [Parameter]
    public bool IsSubmitting
    {
        get; set;
    }

    [Parameter]
    public Func<ApprovalStepCount, string> GetApprovalStepLabel
    {
        get; set;
    } = _ => string.Empty;

    [Parameter]
    public EventCallback<string> TitleChanged
    {
        get; set;
    }

    [Parameter]
    public EventCallback<int> StepCountChanged
    {
        get; set;
    }

    [Parameter]
    public EventCallback<int> FirstApproverChanged
    {
        get; set;
    }

    [Parameter]
    public EventCallback<int> SecondApproverChanged
    {
        get; set;
    }

    [Parameter]
    public EventCallback<int> FinalApproverChanged
    {
        get; set;
    }

    [Parameter]
    public EventCallback SubmitRequested
    {
        get; set;
    }

    private string getApproverFieldLabel(ApprovalStepNumber stepNumber)
    {
        ApprovalStepCount stepCount = new ApprovalStepCount(FormModel.StepCount);
        return ApprovalStepLabelUtility.GetStepLabel(stepCount, stepNumber);
    }

    private string getApproverSelectLabel(ApprovalStepNumber stepNumber)
    {
        return getApproverFieldLabel(stepNumber) + " 선택";
    }

}
