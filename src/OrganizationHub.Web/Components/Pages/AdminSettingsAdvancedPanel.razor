<MudExpansionPanels Elevation="0" Class="hub-advanced-settings">
    <MudExpansionPanel Text="고급: 연결값 확인">
        <div class="hub-form-hint">
            <span>연결된 Google 값을 확인합니다.</span>
        </div>
        <MudGrid Spacing="3" Class="hub-settings-grid">
            <MudItem xs="12" md="6">
                <SettingIdField @bind-Value="FormModel.DriveResources.OfficialRootFolderId" Label="기본 자료 폴더 ID" IsReadOnly="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <SettingIdField @bind-Value="FormModel.DriveResources.PublicFolderId" Label="외부 공유 자료 폴더 ID" IsReadOnly="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <SettingIdField @bind-Value="FormModel.DriveResources.CommonFolderId" Label="공통 자료 폴더 ID" IsReadOnly="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <SettingIdField @bind-Value="FormModel.DriveResources.ResponsibleResourcesFolderId" Label="책임자 자료 폴더 ID" IsReadOnly="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <SettingIdField @bind-Value="FormModel.DriveResources.WorkResourcesFolderId" Label="업무 지원 자료 폴더 ID" IsReadOnly="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <SettingIdField @bind-Value="FormModel.CalendarResources.OrganizationCalendarId" Label="조직 공용 Calendar ID" IsReadOnly="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <SettingIdField @bind-Value="FormModel.CalendarResources.ResponsibleCalendarId" Label="책임자 Calendar ID" IsReadOnly="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <SettingIdField @bind-Value="FormModel.TaskResources.OrganizationTaskListId" Label="조직 공용 Google Tasks 목록 ID" IsReadOnly="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <SettingIdField @bind-Value="FormModel.TaskResources.ResponsibleTaskListId" Label="책임자 Google Tasks 목록 ID" IsReadOnly="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <SettingIdField @bind-Value="FormModel.FileResources.NoticeFileId" Label="공지 파일 ID" IsReadOnly="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <SettingIdField @bind-Value="FormModel.FileResources.WorkGuidelineFileId" Label="업무 기준 파일 ID" IsReadOnly="true" />
            </MudItem>
        </MudGrid>
    </MudExpansionPanel>
</MudExpansionPanels>

@code {
    [Parameter]
    public GlobalSettingFormModel FormModel
    {
        get; set;
    } = new GlobalSettingFormModel();
}
