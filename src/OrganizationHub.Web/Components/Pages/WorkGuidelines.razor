@page "/work-guidelines"
@attribute [Authorize]
@implements IAsyncDisposable
@inject IWorkGuidelineService WorkGuidelineService
@inject IJSRuntime JavaScriptRuntime

<PageTitle>@OrganizationHubProduct.FormatPageTitle("업무 기준")</PageTitle>

<h1 class="hub-sr-only">업무 기준</h1>

<AuthorizeView Policy="@OrganizationHubPolicies.SYSTEM_SETTINGS_MANAGE">
    <Authorized>
        <div class="hub-page-command-row">
            @if (mIsEditMode)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="cancelEditAsync">편집 취소</MudButton>
            }
            else
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Edit" OnClick="enterEditMode">업무 기준 편집</MudButton>
            }
        </div>
    </Authorized>
</AuthorizeView>

@if (string.IsNullOrWhiteSpace(mMessage) == false)
{
    <MudAlert Severity="@mMessageSeverity" Class="mb-4">@mMessage</MudAlert>
    @if (mHasSaveConflict)
    {
        <MudButton OnClick="cancelEditAsync" Variant="Variant.Outlined" Color="Color.Primary" Class="mb-4">최신 업무 기준 불러오기</MudButton>
    }
}

@if (mIsEditMode)
{
    <MudGrid Spacing="6" Class="hub-management-grid hub-admin-page-grid hub-work-guideline-editor">
        <MudItem xs="12" lg="5">
            <MudPaper Class="hub-card hub-form-card pa-4">
                <div class="hub-admin-form-heading">
                    <MudText Typo="Typo.h6">업무 기준 편집</MudText>
                    <span>@(mSectionCount)개 카드</span>
                </div>
                <div class="hub-form-hint">
                    <span>카드 수를 고르고 드래그하거나 위·아래 버튼으로 순서를 정합니다.</span>
                    <span>일반 사용자에게는 오른쪽 미리보기처럼 보입니다.</span>
                </div>
                <MudSelect T="int" Label="카드 수" Value="mSectionCount" ValueChanged="setSectionCount" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (int sectionCount in getAvailableSectionCounts())
                    {
                        <MudSelectItem T="int" Value="@sectionCount">@(sectionCount)개</MudSelectItem>
                    }
                </MudSelect>
                <div @ref="mSortableRootElement" class="hub-sortable-list hub-work-guideline-sortable" data-sortable-list>
                    @foreach (WorkGuidelineSectionFormModel sectionFormModel in mSectionFormModels)
                    {
                        <div class="hub-sortable-row hub-work-guideline-editor-row" data-sortable-item-id="@sectionFormModel.ClientKey" draggable="true">
                            <span class="hub-sortable-handle" aria-hidden="true">
                                <MudIcon Icon="@Icons.Material.Filled.DragIndicator" Size="Size.Small" />
                            </span>
                            <div class="hub-sortable-main">
                                <MudTextField @bind-Value="sectionFormModel.Title" Label="카드 제목" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                                <MudTextField @bind-Value="sectionFormModel.Body" Label="내용" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="4" Immediate="true" />
                            </div>
                            <SortableOrderControls ItemId="@(mSectionFormModels.IndexOf(sectionFormModel) + 1)" Label="@sectionFormModel.Title" OrderedIds="@(Enumerable.Range(1, mSectionFormModels.Count).ToArray())" MoveRequested="moveSectionByIndex" />
                        </div>
                    }
                </div>
                <MudStack Row="true" Spacing="2" Class="hub-form-actions hub-form-actions-centered mt-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="saveSectionsAsync" Class="hub-primary-action-button">저장</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="cancelEditAsync">취소</MudButton>
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" lg="7">
            <MudPaper Class="hub-card hub-list-card pa-4">
                <div class="hub-admin-section-heading">
                    <div>
                        <MudText Typo="Typo.h6">미리보기</MudText>
                        <div class="hub-muted">저장 후 사용자에게 보일 업무 기준입니다.</div>
                    </div>
                </div>
                @renderGuidelineGrid(mSectionFormModels)
            </MudPaper>
        </MudItem>
    </MudGrid>
}
else
{
    @renderGuidelineGrid(mSectionFormModels)
}

@code {
    private RenderFragment renderGuidelineGrid(IReadOnlyList<WorkGuidelineSectionFormModel> sectionFormModels) => @<div class="@getGuidelineGridClass(sectionFormModels)">
        @if (sectionFormModels.Count == 0)
        {
            <ResourceStateMessage Icon="@Icons.Material.Filled.Rule" Title="등록된 업무 기준이 없습니다." Description="관리자가 업무 기준을 추가하면 이곳에 표시됩니다." />
        }
        else
        {
            @foreach (WorkGuidelineSectionFormModel sectionFormModel in sectionFormModels)
            {
                <MudPaper Class="hub-card pa-4">
                    <MudText Typo="Typo.h6">@sectionFormModel.Title</MudText>
                    <ul class="hub-rule-list">
                        @foreach (string line in getGuidelineLines(sectionFormModel.Body))
                        {
                            <li>@line</li>
                        }
                    </ul>
                </MudPaper>
            }
        }
    </div>;
}
