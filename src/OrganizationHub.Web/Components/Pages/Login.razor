@page "/login"
@layout EmptyLayout
@attribute [AllowAnonymous]

<PageTitle>@OrganizationHubProduct.FormatPageTitle("로그인")</PageTitle>

<div class="hub-login-shell">
    <div class="hub-login-panel">
        <h1 class="hub-login-title">@OrganizationHubProduct.NAME</h1>
        <p class="hub-login-subtitle">조직 내부 운영 포털</p>
        @if (string.IsNullOrWhiteSpace(ErrorOrNull) == false)
        {
            <div class="hub-login-error">@ErrorOrNull</div>
        }
        @if (ReasonOrNull == "session-ended")
        {
            <div class="hub-login-error" role="status">로그인 세션이 종료되었습니다. 다른 탭의 로그아웃이나 계정 변경이 반영되었을 수 있습니다. 다시 로그인해 주세요.</div>
        }
        <form method="post" action="/account/login">
            <AntiforgeryToken />
            <div class="hub-login-field">
                <label for="username">아이디</label>
                <input id="username" name="username" autocomplete="username" required />
            </div>
            <div class="hub-login-field">
                <label for="password">비밀번호</label>
                <input id="password" name="password" type="password" autocomplete="current-password" required />
            </div>
            <button class="hub-login-button" type="submit">로그인</button>
        </form>
    </div>
</div>

@code
{
    [SupplyParameterFromQuery(Name = "reason")]
    public string? ReasonOrNull { get; set; }

    [SupplyParameterFromQuery(Name = "error")]
    public string? ErrorOrNull { get; set; }
}
