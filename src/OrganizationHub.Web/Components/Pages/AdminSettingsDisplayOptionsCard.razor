<MudPaper Class="hub-card hub-form-card pa-4">
    <div class="hub-admin-form-heading">
        <MudText Typo="Typo.h6">표시 옵션</MudText>
        <span>운영 화면</span>
    </div>
    <div class="hub-form-hint">
        <span>Calendar와 Google Tasks 화면에</span>
        <span>작성자 정보를 표시할지 정합니다.</span>
    </div>
    <MudStack Spacing="1" Class="hub-settings-switches">
        <MudSwitch T="bool" @bind-Value="FormModel.ShowTodoAuthor" Label="할 일 작성자 표시" Color="Color.Primary" />
        <MudSwitch T="bool" @bind-Value="FormModel.ShowCalendarAuthor" Label="일정 작성자 표시" Color="Color.Primary" />
    </MudStack>
    <MudStack Row="true" Spacing="2" Class="hub-form-actions hub-form-actions-centered">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => SaveRequested.InvokeAsync())" StartIcon="@Icons.Material.Filled.Save" Class="hub-primary-action-button">표시 옵션 저장</MudButton>
    </MudStack>
</MudPaper>

@code {
    [Parameter]
    public GlobalSettingFormModel FormModel
    {
        get; set;
    } = new GlobalSettingFormModel();

    [Parameter]
    public EventCallback SaveRequested
    {
        get; set;
    }
}
