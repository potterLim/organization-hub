<MudPaper Class="hub-card pa-4">
    <MudText Typo="Typo.h4">페이지를 찾을 수 없습니다.</MudText>
    <MudText Typo="Typo.body2" Class="hub-muted">요청한 주소가 없거나 접근 권한이 없습니다.</MudText>
    <MudButton Href="/dashboard" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4">홈으로 이동</MudButton>
</MudPaper>
