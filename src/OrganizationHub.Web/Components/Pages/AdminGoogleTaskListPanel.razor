<MudPaper Class="hub-card hub-list-card pa-4">
    <div class="hub-google-panel-heading">
        <MudText Typo="Typo.h6">Google Tasks 목록 선택</MudText>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(State.Status.IsConnected == false || State.IsEnsuringStandardTaskLists)" OnClick="@(() => Actions.EnsureStandardTaskListsRequested.InvokeAsync())" StartIcon="@Icons.Material.Filled.AutoAwesomeMotion">표준 Google Tasks 목록 준비</MudButton>
    </div>
    <div class="hub-google-toolbar">
        <MudSelect T="string" Label="저장 대상" Value="State.SelectedTaskListTargetKey.GetSelectionValue()" ValueChanged="handleTaskListTargetSelectionChangedAsync" Variant="Variant.Outlined" Margin="Margin.Dense">
            @foreach (GoogleTaskListAssignmentOption option in State.TaskListAssignmentOptions)
            {
                <MudSelectItem T="string" Value="@option.TargetSelectionValue">@option.DisplayName</MudSelectItem>
            }
        </MudSelect>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => Actions.RefreshRequested.InvokeAsync())" StartIcon="@Icons.Material.Filled.Refresh">새로고침</MudButton>
    </div>
    @if (State.TaskLists.Count == 0)
    {
        <div class="hub-empty">표시할 Google Tasks 목록이 없습니다.</div>
    }
    else
    {
        <MudTable Items="State.TaskLists" Dense="true" Hover="true" Elevation="0" Class="hub-admin-table">
            <HeaderContent>
                <MudTh>목록</MudTh>
                <MudTh>종류</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate Context="taskList">
                <MudTd DataLabel="목록">@taskList.Title</MudTd>
                <MudTd DataLabel="종류">Google Tasks</MudTd>
                <MudTd DataLabel="작업" Class="hub-action-cell">
                    <div class="hub-table-actions">
                        <MudTooltip Text="이 목록으로 연결">
                            <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" OnClick="@(() => Actions.AssignTaskListRequested.InvokeAsync(taskList))" aria-label="이 목록으로 연결" />
                        </MudTooltip>
                    </div>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    [Parameter]
    public AdminGoogleTaskListPanelState State
    {
        get; set;
    } = new AdminGoogleTaskListPanelState();

    [Parameter]
    public AdminGoogleTaskListPanelActions Actions
    {
        get; set;
    } = new AdminGoogleTaskListPanelActions();

    private async Task handleTaskListTargetSelectionChangedAsync(string targetSelectionValue)
    {
        GoogleWorkspaceAssignmentTargetKey targetKey = GoogleWorkspaceAssignmentTargetKey.FromSelectionValue(targetSelectionValue);
        await Actions.SelectedTaskListTargetKeyChanged.InvokeAsync(targetKey);
    }
}
