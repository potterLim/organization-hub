@page "/admin/positions"
@attribute [Authorize(Policy = OrganizationHubPolicies.POSITIONS_MANAGE)]
@inject IPositionManagementService PositionManagementService
@inject ITeamManagementService TeamManagementService

<PageTitle>@OrganizationHubProduct.FormatPageTitle("직책과 권한 설정")</PageTitle>

<div class="hub-page-header">
    <div>
        <h1 class="hub-page-title">직책과 권한 설정</h1>
        <div class="hub-page-description">팀에서 사용할 직책을 만들고, 만든 직책을 선택해 자료, 일정, 할 일, 결재, 관리 권한을 정합니다.</div>
    </div>
</div>

@if (string.IsNullOrWhiteSpace(mMessage) == false)
{
    <MudAlert Severity="@mMessageSeverity" Class="mb-4">@mMessage</MudAlert>
}

@if (mActiveTeams.Count == 0)
{
    <MudAlert Severity="Severity.Warning">활성 팀을 먼저 만들어 주세요.</MudAlert>
}
else
{
    <MudGrid Spacing="6" Class="hub-management-grid hub-admin-page-grid">
        <MudItem xs="12" lg="5" xl="4">
            <MudPaper Class="hub-card hub-form-card pa-4">
                <div class="hub-admin-form-heading">
                    <MudText Typo="Typo.h6">직책 만들기</MudText>
                    <span>새 직책</span>
                </div>
                <div class="hub-form-hint">팀에서 사용할 직책 이름을 먼저 만듭니다. 만든 직책은 오른쪽에서 선택해 권한을 정합니다.</div>
                <MudSelect T="int" Label="팀" Value="mNewPositionFormModel.TeamId" ValueChanged="setNewPositionTeamId" Variant="Variant.Outlined" Margin="Margin.Dense">
                    @foreach (Team team in mActiveTeams)
                    {
                        <MudSelectItem T="int" Value="@team.Id">@team.DisplayName</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField @bind-Value="mNewPositionFormModel.Name" Label="새 직책 이름" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                <MudTextField @bind-Value="mNewPositionFormModel.Description" Label="설명" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2" Immediate="true" />
                <MudNumericField T="int" @bind-Value="mNewPositionFormModel.SortOrder" Label="목록 표시 순서" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
                <MudStack Row="true" Spacing="3" Class="hub-position-switch-row mt-2">
                    <MudSwitch T="bool" @bind-Value="mNewPositionFormModel.IsActive" Label="바로 사용" Color="Color.Primary" />
                    <MudSwitch T="bool" @bind-Value="mNewPositionFormModel.IsSystemAdministrator" Label="시스템 관리자 직책" Color="Color.Warning" />
                </MudStack>
                @if (mNewPositionFormModel.IsSystemAdministrator)
                {
                    <MudAlert Severity="Severity.Warning" Class="mt-2">모든 설정을 관리하는 직책을 만들 때만 선택하세요.</MudAlert>
                }

                <MudStack Row="true" Spacing="2" Class="hub-form-actions hub-form-actions-centered mt-4">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="createPositionAsync" StartIcon="@Icons.Material.Filled.Add" Class="hub-primary-action-button">직책 만들기</MudButton>
                </MudStack>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" lg="7" xl="8">
            <MudPaper Class="hub-card hub-list-card hub-permission-workspace pa-4">
                <div class="hub-admin-section-heading">
                    <div>
                        <MudText Typo="Typo.h6">권한 설정</MudText>
                        <div class="hub-muted">팀과 직책을 고른 뒤, 필요한 업무 권한만 켭니다.</div>
                    </div>
                    <span class="hub-status-pill">@getAllowedPermissionCountText()</span>
                </div>
                <div class="hub-position-selection-grid">
                    <MudSelect T="int" Label="팀 선택" Value="mSelectedPermissionTeamId" ValueChanged="setPermissionTeamId" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (Team team in mActiveTeams)
                        {
                            <MudSelectItem T="int" Value="@team.Id">@team.DisplayName</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="int?" Label="직책 선택" Value="mSelectedPositionIdOrNull" ValueChanged="setSelectedPositionId" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(getPositionsForSelectedPermissionTeam().Count == 0)">
                        @foreach (OrganizationPosition position in getPositionsForSelectedPermissionTeam())
                        {
                            <MudSelectItem T="int?" Value="@((int?)position.Id)">@getPositionOptionText(position)</MudSelectItem>
                        }
                    </MudSelect>
                </div>

                @{
                    OrganizationPosition? selectedPositionOrNull = getSelectedPositionOrNull();
                }
                @if (selectedPositionOrNull == null)
                {
                    <div class="hub-empty hub-empty-state">
                        <div class="hub-empty-copy">
                            <div class="hub-empty-title">선택할 직책이 없습니다.</div>
                            <div class="hub-empty-description">왼쪽에서 이 팀의 직책을 먼저 만든 뒤 권한을 설정할 수 있습니다.</div>
                        </div>
                    </div>
                }
                else
                {
                    OrganizationPosition selectedPosition = selectedPositionOrNull;
                    <div class="hub-position-selection-summary">
                        <div>
                            <div class="hub-muted">선택한 직책</div>
                            <div class="hub-position-selection-title">@selectedPosition.Name</div>
                        </div>
                        <span class="@(selectedPosition.IsActive ? "hub-status-pill hub-status-active" : "hub-status-pill hub-status-inactive")">@(selectedPosition.IsActive ? "사용 중" : "비활성")</span>
                    </div>
                    <div class="hub-permission-toolbar">
                        <MudSelect T="string" Label="업무 영역" @bind-Value="mSelectedPermissionCategory" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem T="string" Value="@ALL_PERMISSION_CATEGORY">전체</MudSelectItem>
                            @foreach (string category in getPermissionCategories())
                            {
                                <MudSelectItem T="string" Value="@category">@category</MudSelectItem>
                            }
                        </MudSelect>
                        <MudCheckBox T="bool" @bind-Value="mShowOnlyAllowedPermissions" Label="허용만 보기" Color="Color.Primary" />
                    </div>
                    <div class="hub-permission-editor">
                        @foreach (string category in getVisiblePermissionCategories())
                        {
                            IReadOnlyList<PermissionDefinition> visibleDefinitions = getVisiblePermissionDefinitions(category);
                            <section class="hub-permission-group">
                                <div class="hub-permission-group-title">@category</div>
                                <div class="hub-permission-card-grid">
                                    @foreach (PermissionDefinition definition in visibleDefinitions)
                                    {
                                        PositionPermissionGrantFormModel grantForm = getPermissionGrantForm(definition.Key);
                                        <div class="@(grantForm.IsAllowed ? "hub-permission-row hub-permission-row-active" : "hub-permission-row")">
                                            <div class="hub-permission-copy">
                                                <div class="hub-permission-name">@definition.DisplayName</div>
                                                <div class="hub-muted">@definition.Description</div>
                                            </div>
                                            <div class="hub-permission-controls">
                                                <MudCheckBox T="bool" Value="@grantForm.IsAllowed" ValueChanged="@((bool isAllowed) => setPermissionAllowed(definition.Key, isAllowed ? EPermissionGrantState.Allowed : EPermissionGrantState.Denied))" Color="Color.Primary" Label="사용" Class="hub-permission-allow" />
                                                @if (grantForm.IsAllowed)
                                                {
                                                    <MudSelect T="EPermissionScopeType" Label="적용 범위" Value="@grantForm.ScopeType" ValueChanged="@(scopeType => setPermissionScope(definition.Key, scopeType))" Variant="Variant.Outlined" Margin="Margin.Dense" Class="hub-permission-scope">
                                                        <MudSelectItem T="EPermissionScopeType" Value="EPermissionScopeType.Global">모든 팀</MudSelectItem>
                                                        <MudSelectItem T="EPermissionScopeType" Value="EPermissionScopeType.OwnTeam">소속 팀</MudSelectItem>
                                                        <MudSelectItem T="EPermissionScopeType" Value="EPermissionScopeType.OwnTeamAndChildren">소속 팀과 하위 팀</MudSelectItem>
                                                        <MudSelectItem T="EPermissionScopeType" Value="EPermissionScopeType.SelectedTeam">지정한 팀</MudSelectItem>
                                                        <MudSelectItem T="EPermissionScopeType" Value="EPermissionScopeType.OwnCreated">본인이 만든 항목</MudSelectItem>
                                                    </MudSelect>
                                                    @if (grantForm.ScopeType == EPermissionScopeType.SelectedTeam)
                                                    {
                                                        <MudSelect T="int?" Label="대상 팀" Value="@grantForm.TargetTeamId" ValueChanged="@(teamId => setPermissionTargetTeam(definition.Key, teamId))" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="hub-permission-target">
                                                            @foreach (Team team in mActiveTeams)
                                                            {
                                                                <MudSelectItem T="int?" Value="@((int?)team.Id)">@team.DisplayName</MudSelectItem>
                                                            }
                                                        </MudSelect>
                                                    }
                                                }
                                                else
                                                {
                                                    <div class="hub-permission-disabled-hint">사용으로 바꾸면 범위를 고를 수 있습니다.</div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </section>
                        }
                    </div>
                    <MudStack Row="true" Spacing="2" Class="hub-form-actions hub-form-actions-centered hub-permission-save-bar mt-4">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="savePermissionAsync" StartIcon="@Icons.Material.Filled.Save" Class="hub-primary-action-button">권한 저장</MudButton>
                    </MudStack>
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12">
            <MudPaper Class="hub-card hub-list-card pa-4">
                <MudText Typo="Typo.h6">직책 목록</MudText>
                <MudTable Items="mPositions" Dense="true" Hover="true" Elevation="0" Class="hub-admin-table">
                    <HeaderContent>
                        <MudTh>팀</MudTh>
                        <MudTh>직책</MudTh>
                        <MudTh>권한</MudTh>
                        <MudTh>사용자</MudTh>
                        <MudTh>상태</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate Context="position">
                        <MudTd DataLabel="팀">@getTeamName(position)</MudTd>
                        <MudTd DataLabel="직책">
                            <div>@position.Name</div>
                            @if (position.IsSystemAdministrator)
                            {
                                <div class="hub-muted">시스템 관리자 직책</div>
                            }
                        </MudTd>
                        <MudTd DataLabel="권한">@position.PermissionGrants.Count</MudTd>
                        <MudTd DataLabel="사용자">@position.UserAccounts.Count</MudTd>
                        <MudTd DataLabel="상태"><span class="@(position.IsActive ? "hub-status-pill hub-status-active" : "hub-status-pill hub-status-inactive")">@(position.IsActive ? "사용 중" : "비활성")</span></MudTd>
                        <MudTd DataLabel="작업" Class="hub-action-cell">
                            <div class="hub-table-actions">
                                <MudTooltip Text="이 직책 권한 설정">
                                    <MudIconButton Icon="@Icons.Material.Filled.Tune" Color="Color.Primary" Size="Size.Small" OnClick="@(() => selectPositionForPermissions(position))" aria-label="이 직책 권한 설정" />
                                </MudTooltip>
                                <MudTooltip Text="@(position.IsActive ? "직책 비활성화" : "직책 활성화")">
                                    <MudIconButton Icon="@(position.IsActive ? Icons.Material.Filled.Block : Icons.Material.Filled.CheckCircle)" Color="Color.Warning" Size="Size.Small" OnClick="@(() => togglePositionActiveAsync(position))" aria-label="@(position.IsActive ? "직책 비활성화" : "직책 활성화")" Disabled="@position.IsSystemAdministrator" />
                                </MudTooltip>
                            </div>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        </MudItem>
    </MudGrid>
}
