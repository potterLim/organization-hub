@page "/todos"
@attribute [Authorize]
@inherits OrganizationHubComponentBase
@implements IAsyncDisposable
@inject ITodoService TodoService
@inject IGlobalSettingService GlobalSettingService
@inject IChangeVersionService ChangeVersionService
@inject IClientTimeZoneService ClientTimeZoneService
@inject IJSRuntime JavaScriptRuntime

<UnsavedChangesGuard ReturnFocusSelector=".hub-todo-row input:not([type=checkbox]), .hub-todo-create-input input" HasChanges="@(string.IsNullOrWhiteSpace(mEditingTaskId) == false || string.IsNullOrWhiteSpace(mNewTaskTitle) == false || mNewTaskDueAt.HasValue)" />

@if (string.IsNullOrWhiteSpace(mPreviousDraft) == false)
{
    <MudAlert Severity="Severity.Info" Class="mb-3">
        <strong>다시 불러오기 전 내 입력</strong>
        <div class="hub-draft-copy">@mPreviousDraft</div>
        <span>현재의 최신 내용과 비교한 뒤 필요한 변경을 다시 입력해 주세요.</span>
        <MudButton Variant="Variant.Text" OnClick="@(() => mPreviousDraft = string.Empty)">비교 마침</MudButton>
    </MudAlert>
}

<PageTitle>@OrganizationHubProduct.FormatPageTitle("할 일")</PageTitle>

@if (mPendingTaskListIdOrNull != null)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4" role="alert">
        저장하지 않은 입력이 있습니다. 목록을 바꾸기 전에 저장하거나 입력을 버릴지 선택해 주세요.
        <div class="hub-form-actions">
            <MudButton OnClick="keepCurrentTaskList" Disabled="mIsSaving">계속 작성</MudButton>
            <MudButton OnClick="discardDraftAndSwitchTaskListAsync" Disabled="mIsSaving" Color="Color.Warning">입력 버리고 목록 이동</MudButton>
        </div>
    </MudAlert>
}

<div @ref="mRefreshScopeElement">
    <h1 class="hub-sr-only">할 일</h1>
</div>

@if (string.IsNullOrWhiteSpace(mMessage) == false)
{
    <MudAlert Severity="@mMessageSeverity" Class="mb-4">
        @mMessage
        @if (mHasEditConflict)
        {
            <MudButton OnClick="reloadConflictedTaskAsync" Disabled="mIsSaving">최신 내용 불러오기</MudButton>
        }
    </MudAlert>
}

@if (mIsLoadingLists)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (mHasTaskListLoadError)
{
    <ResourceStateMessage Icon="@Icons.Material.Filled.SyncProblem" Title="할 일 목록을 불러오지 못했습니다." ActionLabel="다시 시도" Action="loadTaskListsAsync" />
}
else if (mTaskLists.Count == 0)
{
    <MudPaper Class="hub-card hub-empty-card pa-5">
        <AuthorizeView Policy="@OrganizationHubPolicies.SYSTEM_SETTINGS_MANAGE">
            <Authorized><ResourceStateMessage Icon="@Icons.Material.Filled.TaskAlt" Title="연결된 할 일 목록이 없습니다." Description="조직이나 팀에서 사용할 할 일 목록을 연결해 주세요." ActionLabel="할 일 목록 연결" ActionHref="/admin/settings?section=tasks" /></Authorized>
            <NotAuthorized><ResourceStateMessage Icon="@Icons.Material.Filled.TaskAlt" Title="연결된 할 일 목록이 없습니다." Description="조직 관리자에게 내 팀의 할 일 목록 연결과 사용 권한을 확인해 달라고 요청해 주세요." ActionLabel="홈으로" ActionHref="/dashboard" /></NotAuthorized>
        </AuthorizeView>
    </MudPaper>
}

else
{
    <MudPaper Class="hub-card hub-todo-shell pa-4">
        <div class="hub-todo-toolbar">
            <div class="hub-todo-toolbar-head">
                <div class="hub-todo-toolbar-controls">
                    <MudSelect T="string" Label="할 일 목록" Value="@mSelectedTaskListId" ValueChanged="handleTaskListChangedAsync" Variant="Variant.Outlined" Margin="Margin.Dense" Class="hub-todo-list-select">
                        @foreach (TodoTaskListReference taskList in mTaskLists)
                        {
                            <MudSelectItem T="string" Value="@taskList.TaskListId.GetRequiredValue()">@taskList.DisplayName</MudSelectItem>
                        }
                    </MudSelect>
                    <MudSelect T="ETodoTaskSortMode" Label="정렬" Value="@mTaskSortMode" ValueChanged="setTaskSortModeAsync" Variant="Variant.Outlined" Margin="Margin.Dense" Class="hub-todo-sort-select">
                        <MudSelectItem T="ETodoTaskSortMode" Value="@ETodoTaskSortMode.DueDateAscending">@getTaskSortModeLabel(ETodoTaskSortMode.DueDateAscending)</MudSelectItem>
                        @if (shouldShowManualTaskSortOption())
                        {
                            <MudSelectItem T="ETodoTaskSortMode" Value="@ETodoTaskSortMode.ManualOrder">@getTaskSortModeLabel(ETodoTaskSortMode.ManualOrder)</MudSelectItem>
                        }
                        <MudSelectItem T="ETodoTaskSortMode" Value="@ETodoTaskSortMode.RecentlyCreated">@getTaskSortModeLabel(ETodoTaskSortMode.RecentlyCreated)</MudSelectItem>
                    </MudSelect>
                </div>
                <div class="hub-todo-toolbar-actions">
                    @if (mHasExternalChanges)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Sync" OnClick="loadTasksAsync" Class="hub-freshness-button">새 내용</MudButton>
                    }
                    <MudTooltip Text="새로고침">
                        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Primary" OnClick="loadTasksAsync" Disabled="mIsLoadingTasks" aria-label="새로고침" />
                    </MudTooltip>
                </div>
            </div>
            @if (canShowTaskCreation() && isAggregateSelected())
            {
                
                <div class="hub-form-actions">
                    @foreach (TodoTaskListReference taskList in mTaskLists.Where(taskList => mCreatableTaskListIds.Contains(taskList.TaskListId.GetRequiredValue())))
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => handleTaskListChangedAsync(taskList.TaskListId.GetRequiredValue()))">@(taskList.DisplayName + "에 추가")</MudButton>
                    }
                </div>
            }
            @if (canShowTaskCreation() && isAggregateSelected() == false)
            {
                <div class="hub-todo-create">
                    <div class="hub-todo-create-bar">
                        <span class="hub-todo-create-glyph" aria-hidden="true">
                            <MudIcon Icon="@Icons.Material.Filled.PlaylistAddCheck" Size="Size.Small" />
                        </span>
                        <MudTextField @bind-Value="mNewTaskTitle" Placeholder="@getNewTaskPlaceholder()" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" OnKeyDown="handleNewTaskKeyDownAsync" Class="hub-todo-create-input" Disabled="@(canCreateTask() == false)" />
                        <CalendarDateTimeField Label="마감 기한"
                                               Value="@mNewTaskDueAt"
                                               ValueChanged="setNewTaskDueAtAsync"
                                               CurrentDateOrNull="@getClientToday()"
                                               CanClearValue="true"
                                               ClearValueText="마감 기한 없음"
                                               IsDisabled="@(canCreateTask() == false)"
                                               IsOpen="@mIsNewTaskDuePickerOpen"
                                               IsOpenChanged="setNewTaskDuePickerOpenAsync" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddTask" OnClick="createTaskAsync" Disabled="@(mIsSaving || canSubmitNewTask() == false)" Class="hub-todo-create-button">추가</MudButton>
                    </div>
                </div>
            }
        </div>

        @if (mIsLoadingTasks)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-4" />
        }
        else if (mHasTaskLoadError)
        {
            <ResourceStateMessage Icon="@Icons.Material.Filled.SyncProblem" Title="할 일을 불러오지 못했습니다." Description="조회 결과를 확인할 수 없습니다. 다시 불러와 주세요." ActionLabel="다시 시도" Action="loadTasksAsync" />
        }
        else
        {
            <div @ref="mTodoBoardElement">
                <MudGrid Spacing="4" Class="hub-todo-board">
                    <MudItem xs="12" md="6">
                        <section class="hub-todo-column">
                            <div class="hub-todo-column-head">
                                <MudText Typo="Typo.h6">할 일</MudText>
                                <span class="hub-status-pill hub-status-active">@getPendingTasks().Count.ToString(CultureInfo.InvariantCulture)</span>
                            </div>
                            @if (getPendingTasks().Count == 0)
                            {
                                <div class="hub-empty hub-todo-empty">남은 할 일이 없습니다.</div>
                            }
                            else
                            {
                                <div class="hub-todo-list">
                                    @foreach (TodoTaskItem task in getPendingTasks())
                                    {
                                        <TodoTaskRow @key="task.Id"
                                                     Task="task"
                                                     CompletionState="ETodoTaskCompletionState.NeedsAction"
                                                     CanDrag="canDragTask(task, ETodoTaskCompletionState.NeedsAction)"
                                                     OrderKeyDown="@(args => moveTaskByKeyAsync(task, args))"
                                                     CanWrite="canWriteTask(task)"
                                                     CanDelete="canDeleteTask(task)"
                                                     IsEditing="@(mEditingTaskId == task.Id)"
                                                     EditingTitle="@mEditingTitle"
                                                     EditingTitleChanged="setEditingTitle"
                                                     EditingDueAt="@mEditingDueAt"
                                                     EditingDueAtChanged="setEditingDueAtAsync"
                                                     CurrentDateOrNull="@getClientToday()"
                                                     IsDuePickerOpen="@mIsEditingDuePickerOpen"
                                                     IsDuePickerOpenChanged="setEditingDuePickerOpenAsync"
                                                     IsDeleting="@(mDeletingTaskId == task.Id)"
                                                     TaskMeta="@formatTaskMeta(task)"
                                                     TaskTrailingMeta="@formatTaskTrailingMeta(task)"
                                                     TaskTrailingMetaClass="@getTaskTrailingMetaClass(task)"
                                                     CompletionChanged="@((bool isCompleted) => setTaskCompletionStateAsync(task, isCompleted ? ETodoTaskCompletionState.Completed : ETodoTaskCompletionState.NeedsAction))"
                                                     EditStarted="@(() => beginEdit(task))"
                                                     EditSaved="@(() => saveEditAsync(task))"
                                                     EditCanceled="cancelEdit"
                                                     DeleteRequested="@(() => requestDelete(task))"
                                                     DeleteConfirmed="@(() => deleteTaskAsync(task))"
                                                     DeleteCanceled="cancelDelete" />
                                    }
                                </div>
                            }
                        </section>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <section class="hub-todo-column hub-todo-column-muted">
                            <div class="hub-todo-column-head">
                                <MudText Typo="Typo.h6">완료됨</MudText>
                                <span class="hub-status-pill hub-status-completed">@getCompletedTasks().Count.ToString(CultureInfo.InvariantCulture)</span>
                            </div>
                            @if (getCompletedTasks().Count == 0)
                            {
                                <div class="hub-empty hub-todo-empty">완료된 항목이 없습니다.</div>
                            }
                            else
                            {
                                <div class="hub-todo-list">
                                    @foreach (TodoTaskItem task in getCompletedTasks())
                                    {
                                        <TodoTaskRow @key="task.Id"
                                                     Task="task"
                                                     CompletionState="ETodoTaskCompletionState.Completed"
                                                     CanDrag="canDragTask(task, ETodoTaskCompletionState.Completed)"
                                                     CanWrite="canWriteTask(task)"
                                                     CanDelete="canDeleteTask(task)"
                                                     IsEditing="@(mEditingTaskId == task.Id)"
                                                     EditingTitle="@mEditingTitle"
                                                     EditingTitleChanged="setEditingTitle"
                                                     EditingDueAt="@mEditingDueAt"
                                                     EditingDueAtChanged="setEditingDueAtAsync"
                                                     CurrentDateOrNull="@getClientToday()"
                                                     IsDuePickerOpen="@mIsEditingDuePickerOpen"
                                                     IsDuePickerOpenChanged="setEditingDuePickerOpenAsync"
                                                     IsDeleting="@(mDeletingTaskId == task.Id)"
                                                     TaskMeta="@formatTaskMeta(task)"
                                                     TaskTrailingMeta="@formatTaskTrailingMeta(task)"
                                                     TaskTrailingMetaClass="@getTaskTrailingMetaClass(task)"
                                                     CompletionChanged="@((bool isCompleted) => setTaskCompletionStateAsync(task, isCompleted ? ETodoTaskCompletionState.Completed : ETodoTaskCompletionState.NeedsAction))"
                                                     EditStarted="@(() => beginEdit(task))"
                                                     EditSaved="@(() => saveEditAsync(task))"
                                                     EditCanceled="cancelEdit"
                                                     DeleteRequested="@(() => requestDelete(task))"
                                                     DeleteConfirmed="@(() => deleteTaskAsync(task))"
                                                     DeleteCanceled="cancelDelete" />
                                    }
                                </div>
                            }
                        </section>
                    </MudItem>
                </MudGrid>
            </div>
        }
    </MudPaper>
}
