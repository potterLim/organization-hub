@page "/todos"
@attribute [Authorize]
@inherits OrganizationHubComponentBase
@implements IAsyncDisposable
@inject ITodoService TodoService
@inject ITeamManagementService TeamManagementService
@inject IChangeVersionService ChangeVersionService
@inject IJSRuntime JavaScriptRuntime

<PageTitle>@OrganizationHubProduct.FormatPageTitle("할 일")</PageTitle>

<div class="hub-page-header" @ref="mRefreshScopeElement">
    <div>
        <h1 class="hub-page-title">할 일</h1>
    </div>
    @if (mTaskLists.Count > 0)
    {
        <div class="hub-page-actions hub-freshness-actions">
            @if (mHasExternalChanges)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Sync" OnClick="loadTasksAsync" Class="hub-freshness-button">새 내용</MudButton>
            }
            <MudTooltip Text="새로고침">
                <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Primary" OnClick="loadTasksAsync" Disabled="mIsLoadingTasks" aria-label="새로고침" />
            </MudTooltip>
        </div>
    }
</div>

@if (string.IsNullOrWhiteSpace(mMessage) == false)
{
    <MudAlert Severity="@mMessageSeverity" Class="mb-4">@mMessage</MudAlert>
}

@if (mIsLoadingLists)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (mTaskLists.Count == 0)
{
    <MudPaper Class="hub-card hub-empty-card pa-5">
        <div class="hub-empty hub-empty-state">
            <MudIcon Icon="@Icons.Material.Filled.TaskAlt" Size="Size.Medium" />
            <span>연결된 할 일 목록이 없습니다.</span>
        </div>
    </MudPaper>
}

else
{
    <MudPaper Class="hub-card hub-todo-shell pa-4">
        <div class="hub-todo-toolbar">
            <MudSelect T="string" Label="할 일 목록" Value="mSelectedTaskListId" ValueChanged="handleTaskListChangedAsync" Variant="Variant.Outlined" Margin="Margin.Dense" Class="hub-todo-list-select hub-control-select-width">
                @foreach (TodoTaskListReference taskList in mTaskLists)
                {
                    <MudSelectItem T="string" Value="@taskList.TaskListId.Value">@taskList.DisplayName</MudSelectItem>
                }
            </MudSelect>
            <div class="hub-todo-create">
                <div class="hub-todo-create-bar">
                    <span class="hub-todo-create-glyph" aria-hidden="true">
                        <MudIcon Icon="@Icons.Material.Filled.PlaylistAddCheck" Size="Size.Small" />
                    </span>
                    <MudTextField @bind-Value="mNewTaskTitle" Placeholder="@getNewTaskPlaceholder()" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" Disabled="@(canCreateTask() == false)" OnKeyDown="handleNewTaskKeyDownAsync" Class="hub-todo-create-input" />
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddTask" OnClick="createTaskAsync" Disabled="@(mIsSaving || canSubmitNewTask() == false)" Class="hub-todo-create-button">추가</MudButton>
                </div>
            </div>
        </div>

        @if (mIsLoadingTasks)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-4" />
        }
        else
        {
            <div @ref="mTodoBoardElement">
                <MudGrid Spacing="4" Class="hub-todo-board">
                    <MudItem xs="12" md="6">
                        <section class="hub-todo-column">
                            <div class="hub-todo-column-head">
                                <MudText Typo="Typo.h6">할 일</MudText>
                                <span class="hub-status-pill hub-status-active">@getPendingTasks().Count.ToString(CultureInfo.InvariantCulture)</span>
                            </div>
                            @if (getPendingTasks().Count == 0)
                            {
                                <div class="hub-empty hub-todo-empty">남은 할 일이 없습니다.</div>
                            }
                            else
                            {
                                <div class="hub-todo-list">
                                    @foreach (TodoTaskItem task in getPendingTasks())
                                    {
                                        <TodoTaskRow @key="task.Id"
                                                     Task="task"
                                                     CompletionState="ETodoTaskCompletionState.NeedsAction"
                                                     CanDrag="canDragTask(ETodoTaskCompletionState.NeedsAction)"
                                                     CanWrite="canWriteTask(task)"
                                                     IsEditing="@(mEditingTaskId == task.Id)"
                                                     EditingTitle="mEditingTitle"
                                                     EditingTitleChanged="setEditingTitle"
                                                     IsDeleting="@(mDeletingTaskId == task.Id)"
                                                     TaskMeta="@formatTaskMeta(task)"
                                                     CompletionChanged="@((bool isCompleted) => setTaskCompletionStateAsync(task, isCompleted ? ETodoTaskCompletionState.Completed : ETodoTaskCompletionState.NeedsAction))"
                                                     EditStarted="@(() => beginEdit(task))"
                                                     EditSaved="@(() => saveEditAsync(task))"
                                                     EditCanceled="cancelEdit"
                                                     DeleteRequested="@(() => requestDelete(task))"
                                                     DeleteConfirmed="@(() => deleteTaskAsync(task))"
                                                     DeleteCanceled="cancelDelete" />
                                    }
                                </div>
                            }
                        </section>
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <section class="hub-todo-column hub-todo-column-muted">
                            <div class="hub-todo-column-head">
                                <MudText Typo="Typo.h6">완료됨</MudText>
                                <span class="hub-status-pill hub-status-completed">@getCompletedTasks().Count.ToString(CultureInfo.InvariantCulture)</span>
                            </div>
                            @if (getCompletedTasks().Count == 0)
                            {
                                <div class="hub-empty hub-todo-empty">완료된 항목이 없습니다.</div>
                            }
                            else
                            {
                                <div class="hub-todo-list">
                                    @foreach (TodoTaskItem task in getCompletedTasks())
                                    {
                                        <TodoTaskRow @key="task.Id"
                                                     Task="task"
                                                     CompletionState="ETodoTaskCompletionState.Completed"
                                                     CanDrag="canDragTask(ETodoTaskCompletionState.Completed)"
                                                     CanWrite="canWriteTask(task)"
                                                     IsEditing="@(mEditingTaskId == task.Id)"
                                                     EditingTitle="mEditingTitle"
                                                     EditingTitleChanged="setEditingTitle"
                                                     IsDeleting="@(mDeletingTaskId == task.Id)"
                                                     TaskMeta="@formatTaskMeta(task)"
                                                     CompletionChanged="@((bool isCompleted) => setTaskCompletionStateAsync(task, isCompleted ? ETodoTaskCompletionState.Completed : ETodoTaskCompletionState.NeedsAction))"
                                                     EditStarted="@(() => beginEdit(task))"
                                                     EditSaved="@(() => saveEditAsync(task))"
                                                     EditCanceled="cancelEdit"
                                                     DeleteRequested="@(() => requestDelete(task))"
                                                     DeleteConfirmed="@(() => deleteTaskAsync(task))"
                                                     DeleteCanceled="cancelDelete" />
                                    }
                                </div>
                            }
                        </section>
                    </MudItem>
                </MudGrid>
            </div>
        }
    </MudPaper>
}
