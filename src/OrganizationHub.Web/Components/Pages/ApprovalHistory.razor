@page "/approvals/history"
@attribute [Authorize]
@inherits TimeZoneAwareOrganizationHubComponentBase
@inject IApprovalService ApprovalService
@inject NavigationManager NavigationManager
@inject Microsoft.Extensions.Logging.ILogger<ApprovalHistory> Logger

<PageTitle>@OrganizationHubProduct.FormatPageTitle("결재 기록")</PageTitle>

<h1 class="hub-sr-only">결재 기록</h1>

<MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" Class="mb-4">
    <MudButton OnClick="@(() => showHistoryAsync(true))" Disabled="mIsLoading" Variant="@(mShowRequestedOnly ? Variant.Filled : Variant.Outlined)" Color="Color.Primary">내 진행 중 요청 (@mMyOngoingCount)</MudButton>
    <MudButton OnClick="@(() => showHistoryAsync(false))" Disabled="mIsLoading" Variant="@(mShowRequestedOnly ? Variant.Outlined : Variant.Filled)" Color="Color.Primary">전체 기록</MudButton>
    <MudButton OnClick="reloadAsync" Disabled="mIsLoading" StartIcon="@Icons.Material.Filled.Refresh">새로고침</MudButton>
</MudStack>

<MudGrid Spacing="2" Class="mb-2">
    <MudItem xs="9" md="10">
        <MudTextField @bind-Value="mSearchKeyword" Immediate="true" Label="제목 또는 파일명 검색" MaxLength="120" Variant="Variant.Outlined" Margin="Margin.Dense" OnKeyDown="handleSearchKeyDownAsync" />
    </MudItem>
    <MudItem xs="3" md="2">
        <MudButton OnClick="searchAsync" Disabled="mIsLoading" Variant="Variant.Outlined" Color="Color.Primary" Class="mt-2">검색</MudButton>
    </MudItem>
</MudGrid>
<MudExpansionPanels Elevation="0" Class="mb-3">
    <MudExpansionPanel Text="상태·기간 상세 검색">
        <MudGrid Spacing="2">
            <MudItem xs="12" md="4">
        <MudSelect T="EApprovalHistoryFilter" Label="상태" Value="mHistoryFilter" ValueChanged="handleFilterChangedAsync" Disabled="mIsLoading" Variant="Variant.Outlined" Margin="Margin.Dense">
            <MudSelectItem T="EApprovalHistoryFilter" Value="EApprovalHistoryFilter.AllRelated">전체 기록</MudSelectItem>
            <MudSelectItem T="EApprovalHistoryFilter" Value="EApprovalHistoryFilter.MyOngoing">내 진행 중 요청</MudSelectItem>
            <MudSelectItem T="EApprovalHistoryFilter" Value="EApprovalHistoryFilter.Approved">완료</MudSelectItem>
            <MudSelectItem T="EApprovalHistoryFilter" Value="EApprovalHistoryFilter.Rejected">반려</MudSelectItem>
        </MudSelect>
            </MudItem>
            <MudItem xs="12" md="8">
        <MudDateRangePicker @bind-DateRange="mRequestedDateRangeOrNull" Label="요청 기간" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
        </MudGrid>
    </MudExpansionPanel>
</MudExpansionPanels>
<MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
    <MudText Typo="Typo.body2">총 @mTotalCount 건 · @mPageNumber / @mTotalPages 페이지</MudText>
    <MudButton OnClick="previousPageAsync" Disabled="@(mIsLoading || mPageNumber <= 1)" aria-label="이전 페이지">이전</MudButton>
    <MudButton OnClick="nextPageAsync" Disabled="@(mIsLoading || mPageNumber >= mTotalPages)" aria-label="다음 페이지">다음</MudButton>
</MudStack>

@if (mIsLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (string.IsNullOrWhiteSpace(mErrorMessage) == false)
{
    <MudAlert Severity="Severity.Error">@mErrorMessage</MudAlert>
}
else if (mApprovalHistory.Count == 0)
{
    <div class="hub-empty hub-empty-state">
        <MudIcon Icon="@Icons.Material.Filled.HistoryEdu" Size="Size.Medium" />
        <span>@(mShowRequestedOnly && mMyOngoingCount == 0 ? "내가 요청한 진행 중 결재가 없습니다. 완료·반려된 요청은 전체 기록에서 확인할 수 있습니다." : "조건에 맞는 결재 기록이 없습니다. 검색어나 기간, 상태를 변경해 보세요.")</span>
    </div>
}
else
{
    <div class="hub-approval-list">
        @foreach (ApprovalRequestItem approvalRequest in mApprovalHistory)
        {
            <MudPaper Class="hub-card hub-approval-card pa-4">
                <div class="hub-approval-card-head">
                    <div>
                        <MudText Typo="Typo.h6" Class="hub-list-title hub-approval-title">@approvalRequest.Title</MudText>
                        <MudText Typo="Typo.body2" Class="hub-list-meta">@approvalRequest.GetRequesterAffiliationText() · @formatDate(approvalRequest.RequestedAt)</MudText>
                    </div>
                    <span class="@getStatusClass(approvalRequest)">@getStatusText(approvalRequest)</span>
                </div>
                @if (approvalRequest.Status == EApprovalRequestStatus.Pending || approvalRequest.Status == EApprovalRequestStatus.Publishing)
                {
                    <MudText Typo="Typo.body2" Class="my-3">@getProgressText(approvalRequest)</MudText>
                }
                <div class="hub-approval-file-row">
                    <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Size="Size.Small" />
                    <span>@approvalRequest.FileName</span>
                    <MudTooltip Text="다운로드">
                        <MudIconButton Href="@(approvalRequest.HasDocumentSnapshot ? "/approvals/" + approvalRequest.Id + "/document" : "/files/" + approvalRequest.GetDownloadFileId() + "/download")" download="@approvalRequest.FileName" data-enhance-nav="false" Icon="@Icons.Material.Filled.Download" Color="Color.Primary" Size="Size.Small" aria-label="다운로드" />
                    </MudTooltip>
                </div>
                @if (approvalRequest.HasDocumentSnapshot)
                {
                    <MudText Typo="Typo.body2" Class="hub-list-meta">제출 시점에 보존한 문서입니다.</MudText>
                }
                <div class="hub-approval-steps">
                    @foreach (ApprovalStepItem step in approvalRequest.Steps)
                    {
                        <span class="@getStepClass(step)">@getStepDisplayText(approvalRequest, step)</span>
                    }
                </div>
                <MudExpansionPanels Elevation="0" Class="hub-approval-log-panel">
                    <MudExpansionPanel Text="기록">
                        <div class="hub-approval-log-row hub-approval-log-header">
                            <span class="hub-approval-log-time">일시</span>
                            <span class="hub-approval-log-actor">처리자</span>
                            <span class="hub-approval-log-action">처리</span>
                            <span class="hub-approval-log-comment">내용</span>
                        </div>
                        @foreach (ApprovalAuditLogItem auditLog in getDisplayAuditLogs(approvalRequest))
                        {
                            <div class="hub-approval-log-row">
                                <span class="hub-approval-log-time">@formatDate(auditLog.CreatedAt)</span>
                                <span class="hub-approval-log-actor">@auditLog.GetActorAffiliationText()</span>
                                <span class="hub-approval-log-action">@getAuditActionText(approvalRequest, auditLog)</span>
                                <span class="@getAuditCommentClass(auditLog)">@getAuditCommentText(auditLog)</span>
                            </div>
                        }
                    </MudExpansionPanel>
                </MudExpansionPanels>
            </MudPaper>
        }
    </div>
}

@if (mIsLoading == false && mTotalPages > 1)
{
    <MudStack Row="true" Justify="Justify.Center" AlignItems="AlignItems.Center" Class="mt-4">
        <MudButton OnClick="previousPageAsync" Disabled="@(mPageNumber <= 1)" aria-label="아래 이전 페이지">이전</MudButton>
        <MudText Typo="Typo.body2">@mPageNumber / @mTotalPages 페이지</MudText>
        <MudButton OnClick="nextPageAsync" Disabled="@(mPageNumber >= mTotalPages)" aria-label="아래 다음 페이지">다음</MudButton>
    </MudStack>
}
