@page "/approvals/request"
@attribute [Authorize]
@inherits OrganizationHubComponentBase
@inject IApprovalService ApprovalService
@inject IDriveBrowserService DriveBrowserService
@inject IPermissionService PermissionService
@inject IDriveService DriveService

<PageTitle>@OrganizationHubProduct.FormatPageTitle("결재 요청")</PageTitle>

<div class="hub-page-header">
    <div>
        <h1 class="hub-page-title">결재 요청</h1>
    </div>
</div>

@if (string.IsNullOrWhiteSpace(mMessage) == false)
{
    <MudAlert Severity="@mMessageSeverity" Class="mb-4">@mMessage</MudAlert>
}

@if (mIsLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (mCreateContext.CanCreateRequest == false)
{
    <ResourceStateMessage Icon="@Icons.Material.Filled.Lock" Title="@mCreateContext.BlockReason" />
}
else
{
    <MudGrid Spacing="5" Class="hub-approval-grid">
        <MudItem xs="12" lg="8">
            <MudPaper Class="hub-card pa-4">
                <MudText Typo="Typo.h6">결재할 파일</MudText>
                <div class="hub-browser-toolbar">
                    <MudSelect T="string" Label="자료 위치" Value="mFormModel.SourceFolderID" ValueChanged="handleSourceFolderChangedAsync" Variant="Variant.Outlined" Margin="Margin.Dense" Class="hub-browser-root-select">
                        @foreach (DriveFolderReference folder in mCreateContext.SourceFolders)
                        {
                            <MudSelectItem T="string" Value="@folder.FolderID">@folder.DisplayName</MudSelectItem>
                        }
                    </MudSelect>
                    <div class="hub-browser-search">
                        <MudTextField @bind-Value="mKeyword" Placeholder="파일명 검색" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
                        <MudTooltip Text="검색">
                            <MudIconButton Icon="@Icons.Material.Filled.Search" Color="Color.Primary" Size="Size.Medium" OnClick="loadFilesAsync" aria-label="검색" />
                        </MudTooltip>
                    </div>
                </div>
                <div class="hub-browser-location">
                    <div class="hub-browser-breadcrumbs" aria-label="현재 폴더 위치">
                        @for (int index = 0; index < mSourceFolderPath.Count; index++)
                        {
                            int pathIndex = index;
                            DriveFolderPathItem pathItem = mSourceFolderPath[index];
                            @if (index > 0)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Class="hub-browser-breadcrumb-separator" />
                            }
                            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Disabled="@(index == mSourceFolderPath.Count - 1)" OnClick="@(() => navigateSourceToPathAsync(pathIndex))">@pathItem.Name</MudButton>
                        }
                    </div>
                    <div class="hub-browser-count">@getFileCountText()</div>
                </div>
                @if (mIsLoadingFiles)
                {
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                }
                else if (string.IsNullOrWhiteSpace(mFileLoadErrorMessage) == false)
                {
                    <ResourceStateMessage Icon="@Icons.Material.Filled.SyncProblem" Title="@mFileLoadErrorMessage" ActionLabel="다시 시도" Action="loadFilesAsync" />
                }
                else if (mFiles.Count == 0)
                {
                    <ResourceStateMessage Icon="@Icons.Material.Filled.FolderOff" Title="@getFileEmptyMessage()" />
                }
                else
                {
                    <div class="hub-file-desktop-table">
                        <MudTable Items="mFiles" Dense="true" Hover="true" Elevation="0" Class="hub-file-table">
                            <HeaderContent>
                                <MudTh>파일명</MudTh>
                                <MudTh>수정일</MudTh>
                                <MudTh></MudTh>
                            </HeaderContent>
                            <RowTemplate Context="file">
                                <MudTd DataLabel="파일명" Class="hub-file-name">
                                    <div class="hub-file-name-cell">
                                        <MudIcon Icon="@getFileIcon(file)" Size="Size.Small" Class="hub-file-icon" />
                                        <MudText Typo="Typo.body2">@file.Name</MudText>
                                    </div>
                                </MudTd>
                                <MudTd DataLabel="수정일">@formatDate(file.ModifiedTime)</MudTd>
                                <MudTd DataLabel="작업" Class="hub-action-cell">
                                    @if (file.IsFolder)
                                    {
                                        <MudTooltip Text="폴더 열기">
                                            <MudIconButton Icon="@Icons.Material.Filled.FolderOpen" Color="Color.Primary" Size="Size.Small" OnClick="@(() => openSourceFolderAsync(file))" aria-label="폴더 열기" />
                                        </MudTooltip>
                                    }
                                    else
                                    {
                                        <MudTooltip Text="선택">
                                            <MudIconButton Icon="@(mFormModel.FileID == file.ID ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.RadioButtonUnchecked)" Color="Color.Primary" Size="Size.Small" OnClick="@(() => selectFile(file))" aria-label="선택" />
                                        </MudTooltip>
                                    }
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </div>
                    <div class="hub-file-mobile-list">
                        @foreach (DriveFileItem file in mFiles)
                        {
                            <div class="hub-file-compact-row">
                                <div class="hub-file-compact-main">
                                    <div class="hub-file-inline-name">
                                        <MudIcon Icon="@getFileIcon(file)" Size="Size.Small" Class="hub-file-icon" />
                                        <MudText Typo="Typo.body2" Class="hub-file-compact-name">@file.Name</MudText>
                                    </div>
                                    <div class="hub-file-compact-meta">
                                        <span>@formatDate(file.ModifiedTime)</span>
                                    </div>
                                </div>
                                <div class="hub-file-compact-actions">
                                    @if (file.IsFolder)
                                    {
                                        <MudTooltip Text="폴더 열기">
                                            <MudIconButton Icon="@Icons.Material.Filled.FolderOpen" Color="Color.Primary" Size="Size.Small" OnClick="@(() => openSourceFolderAsync(file))" aria-label="폴더 열기" />
                                        </MudTooltip>
                                    }
                                    else
                                    {
                                        <MudTooltip Text="선택">
                                            <MudIconButton Icon="@(mFormModel.FileID == file.ID ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.RadioButtonUnchecked)" Color="Color.Primary" Size="Size.Small" OnClick="@(() => selectFile(file))" aria-label="선택" />
                                        </MudTooltip>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </MudPaper>
            <MudPaper Class="hub-card hub-form-card pa-4 mt-4">
                <MudText Typo="Typo.h6">승인본 저장 위치</MudText>
                <MudSelect T="string" Label="보관 영역" Value="mSelectedDestinationRootFolderID" ValueChanged="handleDestinationRootChangedAsync" Variant="Variant.Outlined" Margin="Margin.Dense" Class="hub-browser-root-select">
                    @foreach (DriveFolderReference folder in mCreateContext.DestinationFolders)
                    {
                        <MudSelectItem T="string" Value="@folder.FolderID">@folder.DisplayName</MudSelectItem>
                    }
                </MudSelect>
                <div class="hub-browser-location">
                    <div class="hub-browser-breadcrumbs" aria-label="승인본 저장 위치">
                        @for (int index = 0; index < mDestinationFolderPath.Count; index++)
                        {
                            int pathIndex = index;
                            DriveFolderPathItem pathItem = mDestinationFolderPath[index];
                            @if (index > 0)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Class="hub-browser-breadcrumb-separator" />
                            }
                            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Disabled="@(index == mDestinationFolderPath.Count - 1)" OnClick="@(() => navigateDestinationToPathAsync(pathIndex))">@pathItem.Name</MudButton>
                        }
                    </div>
                    <div class="hub-browser-count">저장 위치</div>
                </div>
                <div class="hub-folder-actionbar">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.CreateNewFolder" OnClick="toggleDestinationFolderCreate" Class="hub-folder-create-toggle">새 폴더</MudButton>
                </div>
                @if (mIsDestinationFolderCreateOpen)
                {
                    <div class="hub-folder-create-panel" role="group" aria-label="새 폴더 만들기">
                        <div class="hub-folder-create-head">
                            <span class="hub-folder-create-icon">
                                <MudIcon Icon="@Icons.Material.Filled.CreateNewFolder" Size="Size.Small" />
                            </span>
                            <div>
                                <strong>새 폴더 만들기</strong>
                                <span>승인본 저장 위치 안에 새 폴더가 만들어집니다.</span>
                            </div>
                            <MudTooltip Text="닫기">
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Default" OnClick="closeDestinationFolderCreate" aria-label="새 폴더 만들기 닫기" />
                            </MudTooltip>
                        </div>
                        <MudTextField @bind-Value="mNewDestinationFolderName"
                                      Label="폴더 이름"
                                      Placeholder="예: 승인 완료 자료"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      OnKeyDown="handleDestinationFolderCreateKeyDownAsync"
                                      Class="hub-folder-create-input" />
                        <div class="hub-folder-create-actions">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="@mIsCreatingDestinationFolder" OnClick="createDestinationFolderAsync">폴더 만들기</MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small" OnClick="closeDestinationFolderCreate">취소</MudButton>
                        </div>
                    </div>
                }
                @if (mIsLoadingDestinationFolders)
                {
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                }
                else if (string.IsNullOrWhiteSpace(mDestinationFolderLoadErrorMessage) == false)
                {
                    <ResourceStateMessage Icon="@Icons.Material.Filled.SyncProblem" Title="@mDestinationFolderLoadErrorMessage" ActionLabel="다시 시도" Action="loadDestinationFoldersAsync" />
                }
                else if (mDestinationFoldersInCurrentFolder.Count > 0)
                {
                    <div class="hub-folder-tile-list">
                        @foreach (DriveFileItem folder in mDestinationFoldersInCurrentFolder)
                        {
                            <button type="button" class="hub-folder-tile" @onclick="@(() => openDestinationFolderAsync(folder))">
                                <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" />
                                <span>@folder.Name</span>
                            </button>
                        }
                    </div>
                }
                else
                {
                    <ResourceStateMessage Icon="@Icons.Material.Filled.FolderOpen"
                                          Title="하위 폴더가 없습니다."
                                          Description="현재 위치에 승인본이 저장됩니다." />
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" lg="4">
            <MudStack Spacing="4">
                <MudPaper Class="hub-card hub-form-card hub-approval-line-card pa-4">
                    <div class="hub-approval-line-head">
                        <MudText Typo="Typo.h6">결재 경로</MudText>
                        <MudText Typo="Typo.body2" Class="hub-muted">요청 후 아래 순서대로 결재가 진행됩니다.</MudText>
                    </div>
                    <MudTextField T="string" Value="@mFormModel.Title" ValueChanged="handleTitleChangedAsync" Label="요청 제목" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudSelect T="int" Label="결재 방식" Value="mFormModel.StepCount" ValueChanged="handleStepCountChangedAsync" Variant="Variant.Outlined" Margin="Margin.Dense" HelperText="@getApprovalStepDescription()">
                        @foreach (int stepCount in mCreateContext.AvailableStepCounts)
                        {
                            <MudSelectItem T="int" Value="@stepCount">@getApprovalStepLabel(stepCount)</MudSelectItem>
                        }
                    </MudSelect>
                    <div class="hub-approval-flow-preview" aria-label="결재 진행 순서">
                        @foreach (ApprovalFlowPreviewItem previewItem in getApprovalFlowPreviewItems())
                        {
                            <div class="@getApprovalFlowStepClass(previewItem)">
                                <span class="hub-approval-flow-number">@previewItem.StepNumber</span>
                                <div>
                                    <strong>@previewItem.Title</strong>
                                    <span>@previewItem.ApproverLabel</span>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="hub-approval-approver-fields">
                        @if (mFormModel.StepCount >= 2)
                        {
                            <MudSelect @key="@("first-" + mFormModel.StepCount)" T="int" Label="1차 결재자" Value="mFormModel.FirstApproverUserID" ValueChanged="handleFirstApproverChangedAsync" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (ApprovalUserOption userOption in getFirstApproverOptions())
                                {
                                    <MudSelectItem T="int" Value="@userOption.UserID">@userOption.GetDisplayLabel()</MudSelectItem>
                                }
                            </MudSelect>
                        }
                        @if (mFormModel.StepCount == 3)
                        {
                            <MudSelect @key="@("second-" + mFormModel.StepCount)" T="int" Label="2차 결재자" Value="mFormModel.SecondApproverUserID" ValueChanged="handleSecondApproverChangedAsync" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (ApprovalUserOption userOption in getSecondApproverOptions())
                                {
                                    <MudSelectItem T="int" Value="@userOption.UserID">@userOption.GetDisplayLabel()</MudSelectItem>
                                }
                            </MudSelect>
                        }
                        @if (mCreateContext.FinalApproverOptions.Count == 1)
                        {
                            <MudTextField Value="@mCreateContext.FinalApproverOptions[0].GetDisplayLabel()" Label="최종 결재자" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="true" />
                        }
                        else
                        {
                            <MudSelect @key="@("final-" + mFormModel.StepCount)" T="int" Label="최종 결재자" Value="mFormModel.FinalApproverUserID" ValueChanged="handleFinalApproverChangedAsync" Variant="Variant.Outlined" Margin="Margin.Dense">
                                @foreach (ApprovalUserOption userOption in getFinalApproverOptions())
                                {
                                    <MudSelectItem T="int" Value="@userOption.UserID">@userOption.GetDisplayLabel()</MudSelectItem>
                                }
                            </MudSelect>
                        }
                    </div>
                    <div class="hub-submit-row">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Approval" Disabled="@(mIsSubmitting || string.IsNullOrWhiteSpace(mFormModel.FileID))" OnClick="submitRequestAsync" Class="hub-primary-action-button hub-approval-submit-button">결재 요청 보내기</MudButton>
                    </div>
                    @if (string.IsNullOrWhiteSpace(mFormModel.FileID))
                    {
                        <MudText Typo="Typo.caption" Class="hub-muted hub-approval-submit-hint">결재할 파일을 선택해 주세요.</MudText>
                    }
                </MudPaper>
            </MudStack>
        </MudItem>
    </MudGrid>
}
