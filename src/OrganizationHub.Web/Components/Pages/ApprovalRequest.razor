@page "/approvals/request"
@attribute [Authorize]
@inherits TimeZoneAwareOrganizationHubComponentBase
@inject IApprovalService ApprovalService
@inject IDriveBrowserService DriveBrowserService
@inject IPermissionService PermissionService
@inject IDriveService DriveService

<PageTitle>@OrganizationHubProduct.FormatPageTitle("결재 요청")</PageTitle>

<h1 class="hub-sr-only">결재 요청</h1>

<MudButton Href="/approvals/history?view=requested" StartIcon="@Icons.Material.Filled.TrackChanges" Color="Color.Primary" Class="mb-4">내 요청 진행 상황</MudButton>

@if (string.IsNullOrWhiteSpace(mMessage) == false)
{
    <MudAlert Severity="@mMessageSeverity" Class="mb-4">@mMessage</MudAlert>
}

@if (mIsLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else if (mCreateContext.CanCreateRequest == false)
{
    @if (mCreateContext.SetupArea == EApprovalSetupArea.Workflow)
    {
        <AuthorizeView Policy="@OrganizationHubPolicies.APPROVAL_WORKFLOWS_MANAGE">
            <Authorized>
                <ResourceStateMessage Icon="@Icons.Material.Filled.Lock" Title="@mCreateContext.BlockReason" Description="결재 경로를 수정한 뒤 돌아와 다시 확인해 주세요." ActionLabel="결재 경로 설정" ActionHref="/admin/approval-workflows" />
            </Authorized>
            <NotAuthorized>
                <ResourceStateMessage Icon="@Icons.Material.Filled.Lock" Title="@mCreateContext.BlockReason" Description="결재 경로 관리자에게 이 안내를 전달해 주세요." />
            </NotAuthorized>
        </AuthorizeView>
    }
    else if (mCreateContext.SetupArea == EApprovalSetupArea.Resources)
    {
        <AuthorizeView Policy="@OrganizationHubPolicies.SYSTEM_SETTINGS_MANAGE">
            <Authorized>
                <ResourceStateMessage Icon="@Icons.Material.Filled.Lock" Title="@mCreateContext.BlockReason" ActionLabel="자료 위치 설정" ActionHref="/admin/settings" />
            </Authorized>
            <NotAuthorized>
                <ResourceStateMessage Icon="@Icons.Material.Filled.Lock" Title="@mCreateContext.BlockReason" Description="시스템 관리자에게 자료 위치 연결을 요청해 주세요." />
            </NotAuthorized>
        </AuthorizeView>
    }
    else
    {
        <ResourceStateMessage Icon="@Icons.Material.Filled.Lock" Title="@mCreateContext.BlockReason" />
    }
}
else
{
    <MudGrid Spacing="5" Class="hub-approval-grid">
        <MudItem xs="12" lg="8">
            <MudPaper Class="hub-card pa-4">
                <MudText Typo="Typo.h6">결재할 파일</MudText>
                <div class="hub-browser-toolbar hub-browser-toolbar-approval-source">
                    <MudSelect T="string" Label="자료 위치" Value="mFormModel.SourceFolderId" ValueChanged="handleSourceFolderChangedAsync" Variant="Variant.Outlined" Margin="Margin.Dense" Class="hub-browser-root-select">
                        @foreach (DriveFolderReference folder in mCreateContext.SourceFolders)
                        {
                            <MudSelectItem T="string" Value="@folder.FolderId.GetRequiredValue()">@folder.DisplayName</MudSelectItem>
                        }
                    </MudSelect>
                    <div class="hub-browser-search">
                        <MudTextField @bind-Value="mKeyword" Placeholder="현재 위치에서 검색" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" />
                        <MudTooltip Text="현재 위치에서 검색">
                            <MudIconButton Icon="@Icons.Material.Filled.Search" Color="Color.Primary" Size="Size.Medium" OnClick="loadFilesAsync" aria-label="현재 위치에서 검색" />
                        </MudTooltip>
                    </div>
                    <div class="hub-browser-count">@getFileCountText()</div>
                    <MudTooltip Text="현재 위치 새로고침">
                        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Primary" Size="Size.Small" OnClick="loadFilesAsync" Disabled="mIsLoadingFiles" aria-label="현재 위치 새로고침" />
                    </MudTooltip>
                </div>
                @if (shouldShowSourceFolderPath())
                {
                    <div class="hub-browser-location">
                        <div class="hub-browser-breadcrumbs" aria-label="현재 폴더 위치">
                            @for (int index = 0; index < mSourceFolderPath.Count; index++)
                            {
                                int pathIndex = index;
                                DriveFolderPathItem pathItem = mSourceFolderPath[index];
                                @if (index > 0)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Class="hub-browser-breadcrumb-separator" />
                                }
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Disabled="@(index == mSourceFolderPath.Count - 1)" OnClick="@(() => navigateSourceToPathAsync(pathIndex))">@pathItem.Name</MudButton>
                            }
                        </div>
                    </div>
                }
                @if (mIsLoadingFiles)
                {
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                }
                else if (string.IsNullOrWhiteSpace(mFileLoadErrorMessage) == false)
                {
                    <ResourceStateMessage Icon="@Icons.Material.Filled.SyncProblem" Title="@mFileLoadErrorMessage" ActionLabel="다시 시도" Action="loadFilesAsync" />
                }
                else if (mFiles.Count == 0)
                {
                    <ResourceStateMessage Icon="@Icons.Material.Filled.FolderOff" Title="@getFileEmptyMessage()" Description="@getFileEmptyDescription()" />
                }
                else
                {
                    <div class="hub-file-desktop-table">
                        <MudTable Items="mFiles" Dense="true" Hover="true" Elevation="0" Class="hub-file-table">
                            <HeaderContent>
                                <MudTh Class="hub-file-name-heading">파일명</MudTh>
                                <MudTh Class="hub-file-date-heading">수정일</MudTh>
                                <MudTh Class="hub-file-action-heading"></MudTh>
                            </HeaderContent>
                            <RowTemplate Context="file">
                                <MudTd DataLabel="파일명" Class="hub-file-name">
                                    @if (file.IsFolder)
                                    {
                                        <button type="button" class="hub-file-name-cell hub-file-folder-link" @onclick="@(() => openSourceFolderAsync(file))" aria-label="@("폴더 열기: " + file.Name)">
                                            <MudIcon Icon="@getFileIcon(file)" Size="Size.Small" Class="@getFileIconClass(file)" />
                                            <MudText Typo="Typo.body2">@file.Name</MudText>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="hub-file-name-cell hub-file-select-link" @onclick="@(() => selectFile(file))" aria-label="@("파일 선택: " + file.Name)">
                                            <MudIcon Icon="@getFileIcon(file)" Size="Size.Small" Class="@getFileIconClass(file)" />
                                            <MudText Typo="Typo.body2">@file.Name</MudText>
                                        </button>
                                    }
                                </MudTd>
                                <MudTd DataLabel="수정일" Class="hub-file-date-cell hub-file-date-text">@formatDate(file.ModifiedTime)</MudTd>
                                <MudTd DataLabel="작업" Class="hub-action-cell">
                                    @if (file.IsFolder)
                                    {
                                        <MudTooltip Text="폴더 열기">
                                            <MudIconButton Icon="@Icons.Material.Filled.FolderOpen" Color="Color.Primary" Size="Size.Small" OnClick="@(() => openSourceFolderAsync(file))" aria-label="폴더 열기" />
                                        </MudTooltip>
                                    }
                                    else
                                    {
                                        <MudTooltip Text="선택">
                                            <MudIconButton Icon="@(mFormModel.FileId == file.Id ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.RadioButtonUnchecked)" Color="Color.Primary" Size="Size.Small" OnClick="@(() => selectFile(file))" aria-label="선택" />
                                        </MudTooltip>
                                    }
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </div>
                    <div class="hub-file-mobile-list">
                        @foreach (DriveFileItem file in mFiles)
                        {
                            <div class="hub-file-compact-row">
                                <div class="hub-file-compact-main">
                                    <button type="button" class="hub-file-inline-name hub-file-compact-select-link" @onclick="@(() => handleCompactFileClickAsync(file))" aria-label="@(file.IsFolder ? ("폴더 열기: " + file.Name) : ("파일 선택: " + file.Name))">
                                        <MudIcon Icon="@getFileIcon(file)" Size="Size.Small" Class="@getFileIconClass(file)" />
                                        <MudText Typo="Typo.body2" Class="hub-file-compact-name">@file.Name</MudText>
                                    </button>
                                    <div class="hub-file-compact-meta">
                                        <span class="hub-file-date-text">@formatDate(file.ModifiedTime)</span>
                                    </div>
                                </div>
                                <div class="hub-file-compact-actions">
                                    @if (file.IsFolder)
                                    {
                                        <MudTooltip Text="폴더 열기">
                                            <MudIconButton Icon="@Icons.Material.Filled.FolderOpen" Color="Color.Primary" Size="Size.Small" OnClick="@(() => openSourceFolderAsync(file))" aria-label="폴더 열기" />
                                        </MudTooltip>
                                    }
                                    else
                                    {
                                        <MudTooltip Text="선택">
                                            <MudIconButton Icon="@(mFormModel.FileId == file.Id ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.RadioButtonUnchecked)" Color="Color.Primary" Size="Size.Small" OnClick="@(() => selectFile(file))" aria-label="선택" />
                                        </MudTooltip>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </MudPaper>
            <MudPaper Class="hub-card hub-form-card pa-4 mt-4">
                <MudText Typo="Typo.h6">승인본 저장 위치</MudText>
                <div class="hub-browser-toolbar hub-browser-toolbar-approval-destination">
                    <MudSelect T="string" Label="보관 영역" Value="mSelectedDestinationRootFolderId" ValueChanged="handleDestinationRootChangedAsync" Variant="Variant.Outlined" Margin="Margin.Dense" Class="hub-browser-root-select">
                        @foreach (DriveFolderReference folder in mCreateContext.DestinationFolders)
                        {
                            <MudSelectItem T="string" Value="@folder.FolderId.GetRequiredValue()">@folder.DisplayName</MudSelectItem>
                        }
                    </MudSelect>
                    <div class="hub-browser-count">@getDestinationFolderCountText()</div>
                    <MudTooltip Text="저장 위치 새로고침">
                        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Primary" Size="Size.Small" OnClick="loadDestinationFoldersAsync" Disabled="mIsLoadingDestinationFolders" aria-label="저장 위치 새로고침" />
                    </MudTooltip>
                    <div class="hub-browser-folder-action">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.CreateNewFolder" OnClick="toggleDestinationFolderCreate" Class="hub-folder-create-toggle">새 폴더</MudButton>
                    </div>
                </div>
                @if (string.IsNullOrWhiteSpace(mDestinationFolderMessage) == false)
                {
                    <MudAlert Severity="@mDestinationFolderMessageSeverity" Dense="true" Class="hub-browser-inline-alert">@mDestinationFolderMessage</MudAlert>
                }
                @if (shouldShowDestinationFolderPath())
                {
                    <div class="hub-browser-location">
                        <div class="hub-browser-breadcrumbs" aria-label="승인본 저장 위치">
                            @for (int index = 0; index < mDestinationFolderPath.Count; index++)
                            {
                                int pathIndex = index;
                                DriveFolderPathItem pathItem = mDestinationFolderPath[index];
                                @if (index > 0)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Class="hub-browser-breadcrumb-separator" />
                                }
                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Disabled="@(index == mDestinationFolderPath.Count - 1)" OnClick="@(() => navigateDestinationToPathAsync(pathIndex))">@pathItem.Name</MudButton>
                            }
                        </div>
                    </div>
                }
                @if (mIsDestinationFolderCreateOpen)
                {
                    <div class="hub-folder-create-panel" role="group" aria-label="새 폴더">
                        <div class="hub-folder-create-head">
                            <span class="hub-folder-create-icon">
                                <MudIcon Icon="@Icons.Material.Filled.CreateNewFolder" Size="Size.Small" />
                            </span>
                            <div>
                                <strong>새 폴더</strong>
                                <span>승인본 저장 위치에 새 폴더를 만듭니다.</span>
                            </div>
                            <MudTooltip Text="닫기">
                                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Default" OnClick="closeDestinationFolderCreate" aria-label="새 폴더 닫기" />
                            </MudTooltip>
                        </div>
                        <MudTextField @bind-Value="mNewDestinationFolderName"
                                      Label="폴더 이름"
                                      Placeholder="예: 승인 완료 자료"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Immediate="true"
                                      OnKeyDown="handleDestinationFolderCreateKeyDownAsync"
                                      Class="hub-folder-create-input" />
                        <div class="hub-folder-create-actions">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="@mIsCreatingDestinationFolder" OnClick="createDestinationFolderAsync">만들기</MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small" OnClick="closeDestinationFolderCreate">취소</MudButton>
                        </div>
                    </div>
                }
                @if (mIsLoadingDestinationFolders)
                {
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
                }
                else if (string.IsNullOrWhiteSpace(mDestinationFolderLoadErrorMessage) == false)
                {
                    <ResourceStateMessage Icon="@Icons.Material.Filled.SyncProblem" Title="@mDestinationFolderLoadErrorMessage" ActionLabel="다시 시도" Action="loadDestinationFoldersAsync" />
                }
                else if (mDestinationFoldersInCurrentFolder.Count > 0 || mDestinationFilesInCurrentFolder.Count > 0)
                {
                    <div class="hub-location-contents">
                        @if (mDestinationFoldersInCurrentFolder.Count > 0)
                        {
                            <section class="hub-location-section">
                                <div class="hub-location-section-heading">하위 폴더</div>
                                <div class="hub-folder-tile-list">
                                    @foreach (DriveFileItem folder in mDestinationFoldersInCurrentFolder)
                                    {
                                        <button type="button" class="hub-folder-tile" @onclick="@(() => openDestinationFolderAsync(folder))">
                                            <span class="hub-folder-tile-icon">
                                                <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" />
                                            </span>
                                            <span class="hub-folder-tile-content">
                                                <strong>@folder.Name</strong>
                                                <small>폴더 열기</small>
                                            </span>
                                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Class="hub-folder-tile-arrow" />
                                        </button>
                                    }
                                </div>
                            </section>
                        }
                        @if (mDestinationFilesInCurrentFolder.Count > 0)
                        {
                            <section class="hub-location-section">
                                <div class="hub-location-section-heading">현재 위치의 파일</div>
                                <div class="hub-location-file-list">
                                    @foreach (DriveFileItem file in mDestinationFilesInCurrentFolder)
                                    {
                                        <div class="hub-location-file-card">
                                            <span class="hub-location-file-icon">
                                                <MudIcon Icon="@getFileIcon(file)" Size="Size.Small" />
                                            </span>
                                            <span class="hub-location-file-content">
                                                <strong>@file.Name</strong>
                                                <small>@formatDate(file.ModifiedTime)</small>
                                            </span>
                                        </div>
                                    }
                                </div>
                            </section>
                        }
                    </div>
                }
                else
                {
                    <ResourceStateMessage Icon="@Icons.Material.Filled.FolderOpen"
                                          Title="현재 위치에 항목이 없습니다."
                                          Description="승인본은 현재 위치에 저장됩니다." />
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" lg="4">
            <MudStack Spacing="4">
                <ApprovalRequestLineCard FormModel="mFormModel"
                                         CreateContext="mCreateContext"
                                         FirstApproverOptions="getFirstApproverOptions()"
                                         SecondApproverOptions="getSecondApproverOptions()"
                                         FinalApproverOptions="getFinalApproverOptions()"
                                         StepDescription="@getApprovalStepDescription()"
                                         SuggestedTitle="@mSuggestedRequestTitle"
                                         IsSubmitting="mIsSubmitting"
                                         GetApprovalStepLabel="getApprovalStepLabel"
                                         TitleChanged="handleTitleChangedAsync"
                                         StepCountChanged="handleStepCountChangedAsync"
                                         FirstApproverChanged="handleFirstApproverChangedAsync"
                                         SecondApproverChanged="handleSecondApproverChangedAsync"
                                         FinalApproverChanged="handleFinalApproverChangedAsync"
                                         SubmitRequested="submitRequestAsync" />
            </MudStack>
        </MudItem>
    </MudGrid>
}
