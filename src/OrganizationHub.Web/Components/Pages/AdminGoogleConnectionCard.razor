<MudPaper Class="hub-card hub-form-card pa-4">
    <MudText Typo="Typo.h6">연결 상태</MudText>
    @if (Status.HasOAuthConfiguration == false)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">Google 연결 정보가 아직 준비되지 않았습니다. 배포 담당자에게 설정을 요청해 주세요.</MudAlert>
    }
    <div class="hub-google-status">
        <span class="@(Status.IsConnected ? "hub-status-pill hub-status-active" : "hub-status-pill hub-status-inactive")">@(Status.IsConnected ? "연결됨" : "미연결")</span>
        <div>
            <div class="hub-google-status-title">@(Status.IsConnected ? Status.ConnectedEmail : "Google 계정 없음")</div>
            <div class="hub-muted">@Status.Message</div>
        </div>
    </div>
    @if (Status.ConnectedAt.HasValue)
    {
        <div class="hub-google-meta">연결일 @FormatDate(Status.ConnectedAt)</div>
    }
    <MudExpansionPanels Elevation="0" Class="hub-advanced-settings hub-google-advanced-settings">
        <MudExpansionPanel Text="고급: Google 연결 주소">
            <div class="hub-google-callback">
                <div class="hub-google-callback-label">승인 후 돌아올 주소</div>
                <code>@CallbackUri</code>
            </div>
        </MudExpansionPanel>
    </MudExpansionPanels>
    <div class="hub-google-connect-actions">
        @if (Status.IsConnected)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => DisconnectRequested.InvokeAsync())" StartIcon="@Icons.Material.Filled.LinkOff" Class="hub-primary-action-button">연결 해제</MudButton>
        }
        else if (Status.HasOAuthConfiguration)
        {
            <MudButton Href="/admin/google/connect" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Link" Class="hub-primary-action-button">계정 연결</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Default" Disabled="true" StartIcon="@Icons.Material.Filled.Link" Class="hub-primary-action-button">계정 연결</MudButton>
        }
    </div>
</MudPaper>

@code {
    [Parameter]
    public GoogleConnectionStatus Status
    {
        get; set;
    } = new GoogleConnectionStatus();

    [Parameter]
    public string CallbackUri
    {
        get; set;
    } = string.Empty;

    [Parameter]
    public Func<DateTime?, string> FormatDate
    {
        get; set;
    } = _ => "-";

    [Parameter]
    public EventCallback DisconnectRequested
    {
        get; set;
    }
}
