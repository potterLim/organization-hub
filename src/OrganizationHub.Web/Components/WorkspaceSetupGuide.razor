<AuthorizeView Policy="@OrganizationHubPolicies.SYSTEM_SETTINGS_MANAGE">
    <Authorized Context="workspaceSetupAuthorization">
        @if (IsConnected == false || HasRootFolder == false)
        {
            <MudPaper Class="hub-card hub-setup-guide pa-4 mb-4">
                <div class="hub-setup-guide-copy">
                    <MudText Typo="Typo.h6">업무 공간 시작하기</MudText>
                    <MudText Typo="Typo.body2" Class="hub-muted">자료를 함께 보관하려면 Google 계정과 기본 폴더를 연결해 주세요.</MudText>
                </div>
                <ol class="hub-setup-steps" aria-label="기본 설정 순서">
                    <li>
                        <span class="@(IsConnected ? "hub-status-pill hub-status-active" : "hub-status-pill hub-status-inactive")">@(IsConnected ? "연결됨" : "1단계")</span>
                        <span>Google 계정 연결</span>
                        @if (IsConnected == false)
                        {
                            <AuthorizeView Policy="@OrganizationHubPolicies.GOOGLE_CONNECTION_MANAGE" Context="googleAuthorization">
                                <Authorized><MudButton Href="/admin/google" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">연결 설정</MudButton></Authorized>
                                <NotAuthorized><span class="hub-muted">Google 연결 관리자에게 요청해 주세요.</span></NotAuthorized>
                            </AuthorizeView>
                        }
                    </li>
                    <li>
                        <span class="@(HasRootFolder ? "hub-status-pill hub-status-active" : "hub-status-pill hub-status-inactive")">@(HasRootFolder ? "지정됨" : "2단계")</span>
                        <span>기본 자료 폴더 지정</span>
                        @if (HasRootFolder == false)
                        {
                            <MudButton Href="/admin/settings?section=drive" Color="Color.Primary" Variant="Variant.Text" Size="Size.Small">폴더 지정</MudButton>
                        }
                    </li>
                </ol>
            </MudPaper>
        }
    </Authorized>
</AuthorizeView>

@code
{
    [Parameter]
    public bool IsConnected { get; set; }

    [Parameter]
    public bool HasRootFolder { get; set; }
}
